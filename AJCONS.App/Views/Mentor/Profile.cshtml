@model AJOCNS.Shared.DTOs.Mentor.MentorProfileDto
@{
    ViewData["Title"] = "My Profile | Mentor Portal";
    var showAlert = ViewBag.ShowEmploymentAlert as bool? ?? false;
}

<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="text-uppercase fw-bold small text-academic mb-1" style="letter-spacing:.08em">
                        Alumni mentor portal
                    </div>
                    <h1 class="h2 fw-bold mb-1">My profile</h1>
                    <p class="text-muted mb-0">Manage your professional information and employment history</p>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-academic" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                        <i class="fa-solid fa-pen me-2"></i>Edit profile
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-2"></i>Back to dashboard
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">

            @if (showAlert)
            {
                <div class="alert alert-warning border-0 rounded-4 shadow-sm mb-4" role="alert">
                    <div class="d-flex align-items-start gap-3">
                        <i class="fa-solid fa-triangle-exclamation fs-3 text-warning mt-1 flex-shrink-0"></i>
                        <div>
                            <h5 class="fw-bold mb-1">Complete your employment records</h5>
                            <p class="mb-0">As an alumni mentor, your professional experience helps guide students. Please add at least one current or previous position to your profile.</p>
                        </div>
                    </div>
                </div>
            }

            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card border-0 rounded-4 shadow-sm h-100">
                        <div class="card-body p-4 text-center">
                            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
                                 style="width:76px;height:76px;border-radius:50%;background:linear-gradient(135deg, var(--academic-blue), var(--academic-blue-deep));color:#fff;font-size:1.7rem;">
                                <i class="fa-solid fa-user-graduate"></i>
                            </div>
                            <h5 class="fw-bold mb-1">@Model.Name</h5>
                            <p class="text-muted small mb-2">@Model.Email</p>
                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill mb-3">@Model.Status</span>
                            <hr />
                            <div class="text-start">
                                <div class="mb-2 d-flex justify-content-between">
                                    <span class="text-muted small fw-semibold">Alumni GRN</span>
                                    <span class="small fw-bold">@Model.AlumniGrn</span>
                                </div>
                                <div class="mb-2 d-flex justify-content-between">
                                    <span class="text-muted small fw-semibold">Graduation year</span>
                                    <span class="small fw-bold">@Model.AlumniGy</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small fw-semibold">Expertise</span>
                                    <span class="small">@(string.IsNullOrWhiteSpace(Model.Expertise) ? "-" : Model.Expertise)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="card border-0 rounded-4 shadow-sm h-100">
                        <div class="card-header bg-white border-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center ">
                            <h5 class="fw-bold mb-0"><i class="fa-solid fa-briefcase text-primary me-2"></i>Employment records</h5>
                            <button type="button" class="btn btn-academic btn-sm rounded-pill px-4 ms-auto" data-bs-toggle="modal" data-bs-target="#addEmploymentModal">
                                <i class="fa-solid fa-plus me-2"></i>Add position
                            </button>
                        </div>
                        <div class="card-body p-4">
                            @if (Model.CurrentPositions.Any())
                            {
                                <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-circle text-success me-2" style="font-size:0.5rem;"></i>Current positions</h6>
                                <div class="row g-3 mb-4">
                                    @foreach (var record in Model.CurrentPositions)
                                    {
                                        <div class="col-md-6">
                                            <partial name="_EmploymentRecordCard" model="record" />
                                        </div>
                                    }
                                </div>
                            }

                            @if (Model.PreviousPositions.Any())
                            {
                                <h6 class="fw-bold text-secondary mb-3"><i class="fa-solid fa-clock-rotate-left me-2"></i>Previous positions</h6>
                                <div class="row g-3">
                                    @foreach (var record in Model.PreviousPositions)
                                    {
                                        <div class="col-md-6">
                                            <partial name="_EmploymentRecordCard" model="record" />
                                        </div>
                                    }
                                </div>
                            }

                            @if (!Model.HasEmploymentRecords)
                            {
                                <div class="text-center py-5">
                                    <i class="fa-solid fa-briefcase fs-1 text-muted mb-3 d-block"></i>
                                    <h5 class="fw-bold text-dark mb-1">No employment records yet</h5>
                                    <p class="text-muted mb-4">Add your first position to showcase your professional experience to students.</p>
                                    <button type="button" class="btn btn-academic rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addEmploymentModal">
                                        <i class="fa-solid fa-plus me-2"></i>Add your first position
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@* Edit Profile Modal *@
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UpdateProfile" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Edit profile</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Full name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Expertise" class="form-label fw-semibold">Expertise / Specialization</label>
                        <textarea asp-for="Expertise" class="form-control" rows="3" placeholder="e.g., Software Engineering, Career Guidance, Project Management..."></textarea>
                        <div class="form-text">Describe your areas of expertise that would be helpful for students.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-academic fw-semibold">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Add Employment Record Modal *@
<div class="modal fade" id="addEmploymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateEmploymentRecord" method="post" id="addEmploymentForm">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add employment record</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Company <span class="text-danger">*</span></label>
                        <input type="text" name="CompanyName" class="form-control" placeholder="e.g., Tech Info Solutions" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Position <span class="text-danger">*</span></label>
                        <input type="text" name="PositionName" class="form-control" placeholder="e.g., Senior Developer" required />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Start date <span class="text-danger">*</span></label>
                            <input type="month" name="StartDate" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">End date</label>
                            <input type="month" name="EndDate" class="form-control" id="addEndDate" />
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="IsCurrentPosition" id="addIsCurrent" value="true" />
                        <label class="form-check-label fw-medium" for="addIsCurrent">This is my current position</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-academic fw-semibold">Add record</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Edit Employment Record Modal *@
<div class="modal fade" id="editEmploymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UpdateEmploymentRecord" method="post" id="editEmploymentForm">
                <input type="hidden" name="Id" id="editRecordId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Edit employment record</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Company <span class="text-danger">*</span></label>
                        <input type="text" name="CompanyName" class="form-control" id="editCompanyName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Position <span class="text-danger">*</span></label>
                        <input type="text" name="PositionName" class="form-control" id="editPositionName" required />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Start date <span class="text-danger">*</span></label>
                            <input type="month" name="StartDate" class="form-control" id="editStartDate" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">End date</label>
                            <input type="month" name="EndDate" class="form-control" id="editEndDate" />
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="IsCurrentPosition" id="editIsCurrent" value="true" />
                        <label class="form-check-label fw-medium" for="editIsCurrent">This is my current position</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-academic fw-semibold">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Delete Confirmation Modal *@
<div class="modal fade" id="deleteEmploymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="DeleteEmploymentRecord" method="post" id="deleteEmploymentForm">
                <input type="hidden" name="id" id="deleteRecordId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Delete employment record</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Are you sure you want to delete this employment record? This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-semibold">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .employment-card {
            background: #fafbfd;
            border: 1px solid #eef2f6;
            border-radius: .75rem;
            padding: 1.25rem;
            transition: transform .15s ease, box-shadow .15s ease;
        }
        .employment-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(11,92,171,.08);
        }
        .employment-card.current {
            border-color: #c6f6d5;
            background: #f0fff4;
        }
        .employment-card-header {
            display: flex;
            align-items: flex-start;
            gap: .75rem;
            margin-bottom: .75rem;
        }
        .employment-company-icon {
            width: 40px;
            height: 40px;
            border-radius: .5rem;
            background: linear-gradient(135deg, var(--academic-blue), var(--academic-blue-deep));
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            flex-shrink: 0;
        }
        .employment-company-name {
            font-weight: 600;
            color: #15253a;
            font-size: .95rem;
        }
        .employment-position {
            color: var(--academic-blue);
            font-weight: 500;
            font-size: .9rem;
            margin-bottom: .5rem;
        }
        .employment-duration {
            display: flex;
            align-items: center;
            gap: .5rem;
            font-size: .8rem;
            color: #6c757d;
        }
        .employment-badge {
            font-size: .65rem;
            padding: .2rem .5rem;
            border-radius: 50rem;
        }
        .employment-actions {
            display: flex;
            gap: .5rem;
            margin-top: 1rem;
            padding-top: .75rem;
            border-top: 1px solid #eef2f6;
        }
        .employment-actions .btn {
            flex: 1;
            font-size: .75rem;
            padding: .4rem .75rem;
        }
    </style>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Current position checkbox toggles end date
            const setupCurrentToggle = (checkboxId, endDateId) => {
                const checkbox = document.getElementById(checkboxId);
                const endDate = document.getElementById(endDateId);
                if (!checkbox || !endDate) return;
                const toggle = () => {
                    endDate.disabled = checkbox.checked;
                    if (checkbox.checked) endDate.value = '';
                };
                checkbox.addEventListener('change', toggle);
                toggle();
            };
            setupCurrentToggle('addIsCurrent', 'addEndDate');
            setupCurrentToggle('editIsCurrent', 'editEndDate');

            // Edit buttons
            document.querySelectorAll('.btn-edit-employment').forEach(btn => {
                btn.addEventListener('click', () => {
                    const record = JSON.parse(btn.dataset.record);
                    document.getElementById('editRecordId').value = record.Id;
                    document.getElementById('editCompanyName').value = record.CompanyName || '';
                    document.getElementById('editPositionName').value = record.PositionName || '';
                    document.getElementById('editStartDate').value = record.StartDate?.substring(0, 7) || '';
                    document.getElementById('editEndDate').value = record.EndDate?.substring(0, 7) || '';
                    document.getElementById('editIsCurrent').checked = record.IsCurrent;
                    document.getElementById('editEndDate').disabled = record.IsCurrent;
                    new bootstrap.Modal(document.getElementById('editEmploymentModal')).show();
                });
            });

            // Delete buttons
            document.querySelectorAll('.btn-delete-employment').forEach(btn => {
                btn.addEventListener('click', () => {
                    const id = btn.dataset.id;
                    document.getElementById('deleteRecordId').value = id;
                    new bootstrap.Modal(document.getElementById('deleteEmploymentModal')).show();
                });
            });
        });
    </script>
}