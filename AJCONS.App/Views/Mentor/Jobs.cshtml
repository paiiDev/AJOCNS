@model AJOCNS.Shared.DTOs.Jobs.PagedJobPostDto
@{
    ViewData["Title"] = "Mentor Job Posts | AJCONS";
    var showAlert = ViewBag.ShowEmploymentAlert as bool? ?? false;
}
<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="text-uppercase fw-bold small text-academic mb-1" style="letter-spacing:.08em">
                        Alumni mentor portal
                    </div>
                    <h1 class="h2 fw-bold mb-1">My job posts</h1>
                    <p class="text-muted mb-0">@Model.TotalCount job post(s) you have posted. Submissions are approved by an admin before going live.</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Job" asp-action="CreateJobPost" class="btn btn-academic btn-sm rounded-pill px-4">
                        <i class="fa-solid fa-plus me-2"></i>Create job post
                    </a>
                    <a asp-action="Profile" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        <i class="fa-solid fa-user me-2"></i>Profile
                    </a>
                </div>
            </div>
        </div>
    </section>

    @if (showAlert)
    {
        <div class="container-fluid px-lg-4">
            <div class="alert alert-warning border-0 rounded-4 shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-start gap-3">
                    <i class="fa-solid fa-triangle-exclamation fs-3 text-warning mt-1 flex-shrink-0"></i>
                    <div>
                        <h5 class="fw-bold mb-1">Complete your employment records</h5>
                        <p class="mb-2">As an alumni mentor, your professional experience helps guide students. Please add at least one current or previous position to your profile.</p>
                        <a asp-action="Profile" class="btn btn-warning btn-sm rounded-pill px-4 fw-semibold">
                            <i class="fa-solid fa-briefcase me-2"></i>Add employment record
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">
            <div class="card adminlte-card">
                <div class="card-header py-3">
                    <h3 class="card-title fw-bold mb-0">Job posts I posted</h3>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Title</th>
                                <th>Company</th>
                                <th>Type</th>
                                <th>Location</th>
                                <th>Closing Date</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Jobs.Any())
                            {
                                foreach (var job in Model.Jobs)
                                {
                                    <tr>
                                        <td class="ps-4"><strong>@job.Title</strong></td>
                                        <td>@job.CompanyName</td>
                                        <td>@(job.JobType ?? "-")</td>
                                        <td>@(job.Location ?? "-")</td>
                                        <td>@job.ClosingDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            @switch (job.Status.ToLower())
                                            {
                                                case "closed":
                                                    <span class="badge text-bg-secondary">Closed</span>
                                                    break;
                                                case "open":
                                                    <span class="badge text-bg-success">Open</span>
                                                    break;
                                                case "pending":
                                                    <span class="badge text-bg-warning">Pending approval</span>
                                                    break;
                                                case "rejected":
                                                    <span class="badge text-bg-danger">Rejected</span>
                                                    break;
                                                default:
                                                    <span class="badge" style="background:#eaf4ff;color:#073d78">@job.Status</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end gap-1">
                                                <a asp-controller="Job" asp-action="EditJobPost" asp-route-id="@job.Id" class="btn btn-sm btn-outline-primary"
                                                   title="Edit @job.Title" aria-label="Edit @job.Title">
                                                    <i class="fa-solid fa-pen"></i>
                                                </a>
                                                <form asp-action="DeleteJobPost" asp-controller="Job" asp-route-id="@job.Id" method="post"
                                                      class="d-inline confirm-delete" data-job-title="@job.Title">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete @job.Title"
                                                            aria-label="Delete @job.Title">
                                                        <i class="fa-solid fa-trash-can"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="fa-regular fa-folder-open fs-2 d-block mb-2"></i>
                                        You have not posted any job posts yet. Create one to begin.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-white py-3">
                        <nav aria-label="Job post pagination">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                    <a class="page-link" asp-action="Jobs" asp-route-page="@(Model.CurrentPage - 1)">Prev</a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Jobs" asp-route-page="@i">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                    <a class="page-link" asp-action="Jobs" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.confirm-delete').forEach(form => {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    const title = this.getAttribute('data-job-title') || 'this job post';
                    const formEl = this;

                    Swal.fire({
                        title: 'Delete job post?',
                        text: `"${title}" will be permanently deleted. This cannot be undone.`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Yes, delete',
                        cancelButtonText: 'Cancel'
                    }).then(result => {
                        if (result.isConfirmed) {
                            formEl.submit();
                        }
                    });
                });
            });
        });
    </script>
}