@model AJOCNS.Shared.DTOs.Mentor.MentorProfileDto
@{
    ViewData["Title"] = "Mentor Dashboard | AJCONS";
    var showAlert = ViewBag.ShowEmploymentAlert as bool? ?? false;
}
<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="text-uppercase fw-bold small text-academic mb-1" style="letter-spacing:.08em">
                        Alumni mentor portal
                    </div>
                    <h1 class="h2 fw-bold mb-1">Mentor dashboard</h1>
                    <p class="text-muted mb-0">Welcome back, @User.Identity?.Name. Your guidance shapes tomorrow's graduates.</p>
                </div>
                <a asp-action="Profile" class="btn btn-outline-primary">
                    <i class="fa-solid fa-user me-2"></i>My Profile
                </a>
            </div>
        </div>
    </section>

    @if (showAlert)
    {
        <div class="container-fluid px-lg-4">
            <div class="alert alert-warning border-0 rounded-4 shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-start gap-3">
                    <i class="fa-solid fa-triangle-exclamation fs-3 text-warning mt-1 flex-shrink-0"></i>
                    <div>
                        <h5 class="fw-bold mb-1">Complete your employment records</h5>
                        <p class="mb-2">As an alumni mentor, your professional experience helps guide students. Please add at least one current or previous position to your profile.</p>
                        <a asp-action="Profile" class="btn btn-warning btn-sm rounded-pill px-4 fw-semibold">
                            <i class="fa-solid fa-briefcase me-2"></i>Add employment record
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 rounded-4 shadow-sm h-100 bg-white">
                        <div class="card-body p-4 p-lg-5">
                            <span class="badge bg-primary bg-opacity-10 text-primary mb-3 px-3 py-2 rounded-pill fw-semibold">
                                <i class="fa-solid fa-graduation-cap me-2"></i>Your mentor hub
                            </span>
                            <h2 class="fw-bold mb-3">Guide the next generation</h2>
                            <p class="text-muted mb-0" style="line-height:1.8">
                                As an alumnus mentor you can create events and job posts, share career insight, and support students on their professional journey.
                                Your submissions will be reviewed by an admin before going live.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 rounded-4 shadow-sm h-100 position-relative overflow-hidden"
                         style="background: linear-gradient(135deg, #0b1e40 0%, #122b59 100%);">
                        <div class="card-body p-4 p-lg-5 text-white position-relative">
                            <i class="fa-solid fa-handshake position-absolute opacity-10" style="font-size:120px; right:-20px; bottom:-20px;"></i>
                            <span class="badge bg-light text-primary mb-3 px-3 py-2 rounded-pill fw-semibold">Quick link</span>
                            <h4 class="fw-bold mb-3">Create something</h4>
                            <div class="d-flex flex-column gap-2">
                                <a asp-controller="Event" asp-action="CreateEvent" class="btn btn-light text-primary fw-bold px-4 py-2 rounded-pill shadow-sm">
                                    <i class="fa-solid fa-calendar-days me-2"></i>Create event
                                </a>
                                <a asp-controller="Job" asp-action="CreateJobPost" class="btn btn-light text-primary fw-bold px-4 py-2 rounded-pill shadow-sm">
                                    <i class="fa-solid fa-briefcase me-2"></i>Create job post
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>