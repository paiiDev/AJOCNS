@{
    Layout = null;
    ViewData["Title"] = "Access Denied | AJOM PUPL";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

    <style>
        :root {
            --brand-navy: #0b1e40;
            --brand-sky: #0ea5e9;
            --brand-gold: #f0b429;
            --bg-light: #f8f9fa;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-light);
            min-height: 100vh;
        }

        body > .container {
            min-height: calc(100vh - 69px);
            display: flex;
            align-items: center;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Poppins', sans-serif;
        }

        .error-container {
            text-align: center;
            max-width: 500px;
            padding: 3rem 2rem;
            background: #ffffff;
            border-radius: 1.5rem;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
            position: relative;
        }

        .icon-wrapper {
            width: 100px;
            height: 100px;
            background-color: rgba(240, 180, 41, 0.15); /* Light Gold */
            color: var(--brand-gold);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            margin: 0 auto 2rem;
            position: relative;
        }

            /* Decorative dots behind icon */
            .icon-wrapper::before {
                content: '';
                position: absolute;
                width: 140px;
                height: 140px;
                background: rgba(240, 180, 41, 0.05);
                border-radius: 50%;
                z-index: -1;
            }

        .error-code {
            color: var(--brand-sky);
            font-weight: 800;
            font-size: 1rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        .error-title {
            color: var(--brand-navy);
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .error-desc {
            color: #6c757d;
            margin-bottom: 2.5rem;
            line-height: 1.6;
        }

        .btn-primary-custom {
            background-color: var(--brand-navy);
            border-color: var(--brand-navy);
            color: #fff;
            font-weight: 500;
            padding: 0.8rem 2rem;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

            .btn-primary-custom:hover {
                background-color: var(--brand-sky);
                border-color: var(--brand-sky);
                transform: translateY(-2px);
                box-shadow: 0 8px 15px rgba(14, 165, 233, 0.2);
                color: #fff;
            }

        .btn-outline-custom {
            border: 1px solid #dee2e6;
            color: var(--brand-navy);
            font-weight: 500;
            padding: 0.8rem 2rem;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

            .btn-outline-custom:hover {
                background-color: #f8f9fa;
                border-color: #c1c9d0;
                color: var(--brand-navy);
            }
    </style>
</head>
<body>
    @await Html.PartialAsync("_Navbar")

    <div class="container px-4">
        <div class="error-container mx-auto">

            <div class="icon-wrapper">
                <i class="fa-solid fa-shield-lock"></i>
            </div>

            <div class="error-code">403 Error</div>
            <h2 class="error-title">Access Denied</h2>

            <p class="error-desc">
                Sorry, you don't have the required permissions to view this page. Please ensure you are logged in with the correct account role.
            </p>

            <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                <!-- Javascript သုံးပြီး နောက်ဆုံးဝင်ခဲ့တဲ့ စာမျက်နှာကို ပြန်သွားစေခြင်း -->
                <button onclick="history.back()" class="btn btn-outline-custom">
                    <i class="fa-solid fa-arrow-left me-2"></i> Go Back
                </button>

                <!-- Home သို့မဟုတ် Login သို့ ပြန်သွားရန် -->
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom">
                    <i class="fa-solid fa-house me-2"></i> Return Home
                </a>
            </div>

            <div class="mt-4 pt-4 border-top">
                <small class="text-muted">
                    If you believe this is a mistake, please contact <br>
                    <a href="mailto:pyaepaingkyaw@ucspinlon.edu.mm" class="text-decoration-none" style="color: var(--brand-sky);">admin@pupl.edu.mm</a>
                </small>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        Swal.fire({
            icon: 'warning',
            title: 'Access Denied',
            text: 'You do not have permission to view this page. Please login with the correct account.',
            confirmButtonText: 'Understood',
            customClass: { confirmButton: 'btn btn-primary' },
            buttonsStyling: false
        });
    </script>
</body>
</html>
