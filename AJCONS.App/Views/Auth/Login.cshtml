@model LoginDto
@{
    Layout = null;
    ViewData["Title"] = "Login";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

    <style>
        :root {
            --brand-navy: #0b1e40;
            --brand-sky: #0ea5e9;
            --brand-gold: #f0b429;
            --brand-navy-light: #122b59;
            --bg-light: #f8f9fa;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-light);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Slim branding navbar */
        .auth-navbar {
            background: linear-gradient(135deg, var(--brand-navy) 0%, var(--brand-navy-light) 100%);
            padding: 0.9rem 1.5rem;
        }

            .auth-navbar .auth-brand {
                color: #fff;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.6rem;
                font-weight: 600;
            }

                .auth-navbar .auth-brand img {
                    height: 30px;
                    width: auto;
                }

                .auth-navbar .auth-brand small {
                    font-weight: 400;
                    opacity: 0.75;
                }

            .auth-navbar .auth-nav {
                color: rgba(255, 255, 255, 0.85);
                text-decoration: none;
                font-weight: 500;
                transition: color 0.2s ease;
            }

                .auth-navbar .auth-nav:hover {
                    color: #fff;
                }

        body > .container {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Poppins', sans-serif;
        }

        /* Split Card Styling */
        .login-card {
            border: none;
            border-radius: 1.5rem;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }

        /* Left Side Branding */
        .login-branding {
            background: linear-gradient(135deg, var(--brand-navy) 0%, var(--brand-navy-light) 100%);
            color: #white;
            padding: 4rem 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
        }

            .login-branding::before {
                content: '';
                position: absolute;
                top: -50px;
                left: -50px;
                width: 200px;
                height: 200px;
                background: rgba(14, 165, 233, 0.15); /* Sky blue subtle glow */
                filter: blur(40px);
                border-radius: 50%;
            }

        /* Right Side Form */
        .login-form-wrapper {
            padding: 4rem 3rem;
            background: #ffffff;
        }

        /* Custom Inputs (Floating Labels) */
        .form-floating > .form-control:focus {
            border-color: var(--brand-sky);
            box-shadow: 0 0 0 0.25rem rgba(14, 165, 233, 0.15);
        }

        .form-control {
            border-radius: 0.75rem;
        }

        /* Custom Button */
        .btn-primary-custom {
            background-color: var(--brand-sky);
            border-color: var(--brand-sky);
            color: #fff;
            font-weight: 600;
            padding: 0.8rem;
            border-radius: 0.75rem;
            transition: all 0.3s ease;
        }

            .btn-primary-custom:hover {
                background-color: #0284c7;
                border-color: #0284c7;
                transform: translateY(-2px);
                box-shadow: 0 8px 15px rgba(14, 165, 233, 0.3);
            }

        /* Links */
        .text-sky {
            color: var(--brand-sky);
            text-decoration: none;
            font-weight: 500;
        }

            .text-sky:hover {
                color: #0284c7;
                text-decoration: underline;
            }

        /* Responsive */
        @@media (max-width: 991.98px) {
            .login-branding {
                padding: 3rem 2rem;
                text-align: center;
            }

            .login-form-wrapper {
                padding: 3rem 2rem;
            }
        }

        @@media (max-width: 575.98px) {
            .login-form-wrapper {
                padding: 2rem 1.5rem;
            }

            .login-card {
                margin: 0.5rem;
                border-radius: 1rem;
            }

            body > .container {
                align-items: flex-start;
                padding-top: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <nav class="auth-navbar d-flex justify-content-between align-items-center">
        <a class="auth-brand" asp-controller="Home" asp-action="Index">
            <img src="~/images/pupl.png" alt="PUPL Logo" />
            <span>PUPL <small>AJOCNS</small></span>
        </a>
        <a class="auth-nav" asp-controller="Home" asp-action="Index">
            <i class="fa-solid fa-house me-1"></i>Home
        </a>
    </nav>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-xl-10">
                <div class="card login-card">
                    <div class="row g-0">

                        <!-- Left Side: Branding -->
                        <div class="col-lg-5 login-branding d-none d-lg-flex">
                            <div class="mb-4">
                                <i class="fa-solid fa-graduation-cap" style="color: var(--brand-gold); font-size: 3rem;"></i>
                            </div>
                            <h2 class="text-white fw-bold mb-3">Welcome to AJOCNS</h2>
                            <p class="text-white-50 mb-0" style="line-height: 1.8;">
                                The official Alumni Job Opportunities & Career Networking System for Polytechnic University (Panglong).
                                Connect, grow, and lead.
                            </p>

                            <div class="mt-auto pt-5">
                                <small class="text-white-50">&copy; 2026 PUPL. All rights reserved.</small>
                            </div>
                        </div>

                        <!-- Right Side: Form -->
                        <div class="col-lg-7 login-form-wrapper">

                            <!-- Mobile Logo (Visible only on small screens) -->
                            <div class="d-lg-none text-center mb-4">
                                <i class="fa-solid fa-graduation-cap" style="color: var(--brand-gold); font-size: 2.5rem;"></i>
                                <h3 class="fw-bold mt-2" style="color: var(--brand-navy);">AJOCNS</h3>
                            </div>

                            <div class="mb-5 text-center text-lg-start">
                                <h3 class="fw-bold" style="color: var(--brand-navy);">Sign In to your account</h3>
                                <p class="text-muted">Please enter your credentials to proceed.</p>
                            </div>

                            <!-- Alert Box for Errors -->
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger rounded-3" role="alert">
                                    <div asp-validation-summary="All" class="mb-0 list-unstyled small"></div>
                                </div>
                            }

                            <!-- Login Form -->
                            <form asp-controller="Auth" asp-route-returnurl="@returnUrl" asp-action="Login" method="post">
                                <div class="mb-4 form-floating">
                                    <input asp-for="Email" type="email" class="form-control" id="floatingEmail" placeholder="name@example.com" autocomplete="username" />
                                    <label asp-for="Email" for="floatingEmail"><i class="fa-regular fa-envelope me-2 text-muted"></i>Email Address</label>
                                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- 💡 မျက်လုံးပုံလေးထည့်ရန် ပြင်ထားသော Password အကွက် -->
                                <div class="mb-4 form-floating position-relative">
                                    <input asp-for="Password" type="password" class="form-control pe-5" id="floatingPassword" placeholder="Password" autocomplete="current-password" />
                                    <label asp-for="Password" for="floatingPassword"><i class="fa-solid fa-lock me-2 text-muted"></i>Password</label>

                                    <!-- Eye Icon -->
                                    <i class="fa-solid fa-eye text-muted position-absolute" id="togglePassword" style="right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; z-index: 10;"></i>

                                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-5">
                                    <div class="form-check">
                                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe">
                                        <label class="form-check-label text-muted" for="rememberMe">
                                            Remember me
                                        </label>
                                    </div>
                                 
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary-custom">
                                       Login <i class="fa-solid fa-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </form>

                            <div class="text-center mt-5">
                                <p class="text-muted mb-0">
                                    Are you a verified PUPL student or alumnus? <br>
                                    <a asp-controller="Auth" asp-action="Register" class="text-sky fw-bold">Register as a mentor or partner</a>
                                </p>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const togglePassword = document.querySelector('#togglePassword');
        const passwordInput = document.querySelector('#floatingPassword');

        togglePassword.addEventListener('click', function () {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);

            this.classList.toggle('fa-eye');
            this.classList.toggle('fa-eye-slash');
        });

        @if (TempData["SweetAlert_Type"] != null)
        {
            <text>
            Swal.fire({
                icon: '@TempData["SweetAlert_Type"]',
                title: '@TempData["SweetAlert_Title"]',
                html: '@Html.Raw(TempData["SweetAlert_Message"])',
                confirmButtonText: 'OK',
                customClass: { confirmButton: 'btn btn-primary' },
                buttonsStyling: false
            });
            </text>
        }

        @if (ViewData["SweetAlert_Error"] != null)
        {
            <text>
            Swal.fire({
                icon: 'error',
                title: 'Login Failed',
                text: '@ViewData["SweetAlert_Error"]',
                confirmButtonText: 'OK',
                customClass: { confirmButton: 'btn btn-primary' },
                buttonsStyling: false
            });
            </text>
        }
    </script>

</body>
</html>
