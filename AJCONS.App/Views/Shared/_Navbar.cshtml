@using System.Security.Claims
@{
    var userName = User.Identity?.Name ?? "Guest";
    var userRole = User.FindFirstValue(ClaimTypes.Role) ?? "Visitor";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isAdmin = User.IsInRole("Admin");
}
<div class="shadow text-white" id="sidebar">
    <div class="sidebar-heading text-center py-3 fs-5 fw-bold border-bottom border-light border-opacity-25 sticky-top bg-transparent">
        <a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none d-flex align-items-center justify-content-center gap-2">
            <img src="~/images/pupl.png" width="30" alt="Logo" />
            <span>PUPL <small class="fw-normal opacity-75">AJOCNS</small></span>
        </a>
    </div>

    <div class="list-group list-group-flush my-3 px-2">
        @if (isAdmin)
        {
            <a class="nav-link sidebar-link rounded mb-1 px-3 py-2 @(controller == "Admin" && action == "Index" ? "active-menu" : "")" asp-controller="Admin" asp-action="Index">
                <i class="fa-solid fa-gauge-high me-2 text-center" style="width:20px"></i> Dashboard
            </a>
            <a class="nav-link sidebar-link rounded mb-1 px-3 py-2 @(controller == "Event" && action == "Index" ? "active-menu" : "")" asp-controller="Event" asp-action="Index">
                <i class="fa-solid fa-calendar-days me-2 text-center" style="width:20px"></i> Events
            </a>
            <a class="nav-link sidebar-link rounded mb-1 px-3 py-2 @(controller == "Admin" && action == "StudentManagement" ? "active-menu" : "")" asp-controller="Admin" asp-action="StudentManagement">
                <i class="fa-solid fa-user-graduate me-2 text-center" style="width:20px"></i> Students
            </a>
            <a class="nav-link sidebar-link rounded mb-1 px-3 py-2 @(controller == "Admin" && action == "GraduationRecords" ? "active-menu" : "")" asp-controller="Admin" asp-action="GraduationRecords">
                <i class="fa-solid fa-file-lines me-2 text-center" style="width:20px"></i> Graduation Records
            </a>
            <a class="nav-link sidebar-link rounded mb-1 px-3 py-2" href="#">
                <i class="fa-solid fa-circle-check me-2 text-center" style="width:20px"></i> Approvals
            </a>
        }
        else if (User.Identity?.IsAuthenticated == true)
        {
            <a class="nav-link sidebar-link rounded mb-1 px-3 py-2" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-house me-2 text-center" style="width:20px"></i> Home
            </a>
        }
    </div>
</div>
