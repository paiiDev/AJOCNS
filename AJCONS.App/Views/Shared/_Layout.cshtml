@using System.Security.Claims
@{
    var isHomePage = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Myanmar:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" type="image/png" href="~/images/pupl.png">
    <style>
        :root { --academic-blue: #0b5cab; --academic-blue-deep: #073d78; --academic-blue-soft: #eaf4ff; --academic-ink: #15253a; }
        body { margin: 0; min-height: 100vh; font-family: Inter, "Noto Sans Myanmar", sans-serif; color: var(--academic-ink); background: #f4f7fb; }
        .app-main { min-height: calc(100vh - 69px); }
        .adminlte-card { border: 1px solid #dfe7f0; border-radius: .55rem; box-shadow: 0 2px 6px rgba(24, 56, 92, .04); }
        .adminlte-card .card-header { border-bottom-color: #e6edf5; background: #fff; }
        .btn-academic { color: #fff; background: var(--academic-blue); border-color: var(--academic-blue); }
        .btn-academic:hover, .btn-academic:focus { color: #fff; background: var(--academic-blue-deep); border-color: var(--academic-blue-deep); }
        .text-academic { color: var(--academic-blue) !important; }
        @@media (max-width: 991.98px) { .app-main { min-height: calc(100vh - 61px); } }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition layout-top-nav">
    @if (!isHomePage)
    {
        <div id="dashboard-wrapper" class="d-flex">
            @await Html.PartialAsync("_Sidebar")

            <div id="page-content-wrapper" class="flex-grow-1 bg-light min-vh-100 d-flex flex-column">
                <nav class="navbar navbar-light bg-white shadow-sm py-2 px-3 sticky-top z-3">
                    <div class="d-flex align-items-center w-100">
                        <button class="btn btn-light border-0 text-muted" id="sidebarToggle">
                            <i class="fa-solid fa-bars fs-5"></i>
                        </button>
                        <ul class="navbar-nav ms-auto align-items-center flex-row">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark fw-semibold" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fa-solid fa-circle-user fs-5 text-primary align-middle me-1"></i> @User.Identity?.Name
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2 position-absolute">
                                        <li><span class="dropdown-item-text text-muted small">@(User.FindFirstValue(ClaimTypes.Role) ?? "Visitor")</span></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form id="logoutForm" asp-controller="Auth" asp-action="Logout" method="post">
                                                @Html.AntiForgeryToken()
                                                <button class="dropdown-item text-danger py-2" type="button" id="btnLogout">
                                                    <i class="fa-solid fa-right-from-bracket me-2"></i>Logout
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item ms-3">
                                    <a class="btn btn-primary btn-sm px-3" asp-controller="Auth" asp-action="Login">Login</a>
                                </li>
                            }
                        </ul>
                    </div>
                </nav>

                <main class="flex-grow-1" role="main">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main class="app-main" role="main">
            @RenderBody()
        </main>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var type = '@TempData["SweetAlert_Type"]';
            var title = '@TempData["SweetAlert_Title"]';
            var message = '@TempData["SweetAlert_Message"]';
            var redirect = '@TempData["SweetAlert_Redirect"]';
            if (!type) return;
            var opts = {
                icon: type,
                title: title || '',
                confirmButtonText: 'OK',
                customClass: { confirmButton: 'btn btn-primary' },
                buttonsStyling: false
            };
            if (message) opts.html = message;
            Swal.fire(opts).then(function () {
                if (redirect) window.location.href = redirect;
            });
        })();
    </script>
    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('toggled');
        });

        document.getElementById('btnLogout')?.addEventListener('click', function () {
            confirmLogout();
        });

        document.querySelectorAll('.sidebar-logout').forEach(function (btn) {
            btn.addEventListener('click', function () {
                confirmLogout();
            });
        });

        function confirmLogout() {
            Swal.fire({
                title: 'Logout?',
                text: 'Are you sure you want to logout?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, logout',
                cancelButtonText: 'Cancel'
            }).then(function (result) {
                if (result.isConfirmed) {
                    document.getElementById('logoutForm').submit();
                }
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
