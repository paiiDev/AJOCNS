@using System.Security.Claims
@using AJOCNS.Shared.DTOs.Mentor
@using AJOCNS.Shared.DTOs.StudentDashboard
@{
    var isHomePage = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase);
    var mentorProfile = ViewBag.Profile as MentorProfileDto;
    var studentProfile = ViewBag.StudentProfile as StudentDashboardDto;

    // Breadcrumb
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction     = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string breadcrumbSection = currentController switch {
        "Admin"           => "Admin",
        "Event"           => "Events",
        "Job"             => "Jobs",
        "Student"         => "Students",
        "Mentor"          => "Mentors",
        "ExternalPartner" => "External Partners",
        _                 => ""
    };
    string breadcrumbPage = currentAction switch {
        "Index"            => "Dashboard",
        "StudentManagement"=> "Student Management",
        "GraduationRecords"=> "Graduation Records",
        "EditGraduationRecord" => "Edit Record",
        "EditStudent"      => "Edit Student",
        "RegisterNewStudent"=> "Register Student",
        "Mentors"          => "Mentors",
        "MentorDetails"    => "Mentor Details",
        "ExternalPartners" => "External Partners",
        "ExternalPartnerDetails" => "Partner Details",
        "UserApprovals"    => "User Approvals",
        "ContentApprovals" => "Post Approvals",
        "CreateEvent"      => "Create Event",
        "EditEvent"        => "Edit Event",
        "Details"          => "Details",
        "Profile"          => "Profile",
        "JobBoard"         => "Job Board",
        "Jobs"             => "Job Posts",
        "Events"           => "Events",
        "MyJobPosts"       => "My Job Posts",
        _                  => currentAction
    };

    // Role avatar
    var userRole = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var userName = User.Identity?.Name ?? "";
    var initials = string.Join("", (userName.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                        .Take(2)
                        .Select(w => w[0].ToString().ToUpper()));
    if (string.IsNullOrEmpty(initials) && userName.Length > 0) initials = userName[0].ToString().ToUpper();
    string avatarClass = userRole switch {
        "Admin"           => "role-admin",
        "Student"         => "role-student",
        "Mentor"          => "role-mentor",
        "ExternalPartner" => "role-partner",
        _                 => "role-default"
    };

    // Pending approval count for bell
    int pendingCount = (ViewBag.PendingApprovalCount as int? ?? 0) + (ViewBag.PendingPostApprovalCount as int? ?? 0);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Myanmar:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" type="image/png" href="~/images/pupl.png">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (!isHomePage)
    {
        <!-- Mobile sidebar overlay -->
        <div id="sidebar-overlay"></div>

        <div id="dashboard-wrapper">
            @await Html.PartialAsync("_Sidebar")

            <div id="page-content-wrapper">

                <!-- Top Navbar -->
                <nav class="navbar-dashboard d-flex align-items-center gap-2">
                    <!-- Sidebar toggle -->
                    <button class="sidebar-toggle-btn" id="sidebarToggle" aria-label="Toggle sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>

                    <!-- Breadcrumb -->
                    @if (!string.IsNullOrEmpty(breadcrumbPage))
                    {
                        <div class="navbar-breadcrumb d-none d-sm-flex">
                            @if (!string.IsNullOrEmpty(breadcrumbSection) && breadcrumbSection != "Admin")
                            {
                                <span>@breadcrumbSection</span>
                                <span class="bc-sep"><i class="fa-solid fa-chevron-right" style="font-size:.65rem"></i></span>
                            }
                            <span class="bc-current">@breadcrumbPage</span>
                        </div>
                    }

                    <div class="ms-auto d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Notification bell (admin only) -->
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin" asp-action="UserApprovals"
                                   class="navbar-notify"
                                   title="Pending approvals">
                                    <i class="fa-solid fa-bell"></i>
                                    @if (pendingCount > 0)
                                    {
                                        <span class="notify-badge">@(pendingCount > 9 ? "9+" : pendingCount.ToString())</span>
                                    }
                                </a>
                            }

                            <!-- User dropdown -->
                            <div class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center text-dark fw-semibold pe-0"
                                   href="#" data-bs-toggle="dropdown" aria-expanded="false" style="font-size:.875rem">
                                    <span class="navbar-avatar @avatarClass">@initials</span>
                                    <span class="d-none d-md-inline">@User.Identity?.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="min-width:260px; border-radius:.65rem">
                                    @if (mentorProfile is not null)
                                    {
                                        <li class="dropdown-header pb-2 mb-1 border-bottom">
                                            <div class="fw-bold small">@mentorProfile.Name</div>
                                            <div class="text-muted" style="font-size:.72rem">@mentorProfile.Email</div>
                                            @if (!string.IsNullOrEmpty(mentorProfile.Expertise))
                                            {
                                                <div class="text-muted" style="font-size:.70rem">@mentorProfile.Expertise</div>
                                            }
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    @if (studentProfile is not null)
                                    {
                                        <li class="dropdown-header pb-2 mb-1 border-bottom">
                                            <div class="fw-bold small">@studentProfile.Name</div>
                                            <div class="text-muted" style="font-size:.72rem">@studentProfile.Email</div>
                                            <div class="text-muted" style="font-size:.70rem">SRN: @studentProfile.Srn · @studentProfile.Major</div>
                                            @if (!string.IsNullOrWhiteSpace(studentProfile.Phone))
                                            {
                                                <div class="text-muted" style="font-size:.70rem">@studentProfile.Phone</div>
                                            }
                                        </li>
                                    }
                                    @if (User.IsInRole("Student"))
                                    {
                                        <li><a asp-controller="Student" asp-action="Profile" class="dropdown-item"><i class="fa-solid fa-id-card me-2 text-primary"></i>View profile</a></li>
                                    }
                                    @if (User.IsInRole("Mentor"))
                                    {
                                        <li><a asp-controller="Mentor" asp-action="Profile" class="dropdown-item"><i class="fa-solid fa-id-card me-2 text-primary"></i>View profile</a></li>
                                    }
                                    @if (User.IsInRole("ExternalPartner"))
                                    {
                                        <li><a asp-controller="ExternalPartner" asp-action="Profile" class="dropdown-item"><i class="fa-solid fa-id-card me-2 text-primary"></i>View profile</a></li>
                                    }
                                    <li>
                                        <span class="dropdown-item-text text-muted small">
                                            <i class="fa-solid fa-circle-dot me-1"></i>@(userRole == "ExternalPartner" ? "External Partner" : userRole is "" ? "Visitor" : userRole)
                                        </span>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form id="logoutForm" asp-controller="Auth" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button class="dropdown-item text-danger py-2" type="button" id="btnLogout">
                                                <i class="fa-solid fa-right-from-bracket me-2"></i>Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-academic btn-sm px-3" asp-controller="Auth" asp-action="Login">Login</a>
                        }
                    </div>
                </nav>

                <main role="main">
                    @RenderBody()
                </main>

            </div><!-- /#page-content-wrapper -->
        </div><!-- /#dashboard-wrapper -->
    }
    else
    {
        <main role="main">
            @RenderBody()
        </main>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // ── SweetAlert TempData notifications ──────────────────
        (function () {
            var type    = '@TempData["SweetAlert_Type"]';
            var title   = '@TempData["SweetAlert_Title"]';
            var message = '@TempData["SweetAlert_Message"]';
            var redirect= '@TempData["SweetAlert_Redirect"]';
            if (!type) return;
            var opts = {
                icon: type,
                title: title || '',
                confirmButtonText: 'OK',
                customClass: { confirmButton: 'btn btn-academic' },
                buttonsStyling: false
            };
            if (message) opts.html = message;
            Swal.fire(opts).then(function () {
                if (redirect) window.location.href = redirect;
            });
        })();

        // ── Sidebar toggle + mobile overlay ────────────────────
        (function () {
            var sidebar   = document.getElementById('sidebar');
            var overlay   = document.getElementById('sidebar-overlay');
            var toggleBtn = document.getElementById('sidebarToggle');
            if (!sidebar || !toggleBtn) return;

            function isMobile() { return window.innerWidth <= 768; }

            toggleBtn.addEventListener('click', function () {
                sidebar.classList.toggle('toggled');
                if (overlay) {
                    if (isMobile()) {
                        overlay.classList.toggle('active', !sidebar.classList.contains('toggled'));
                    }
                }
            });

            if (overlay) {
                overlay.addEventListener('click', function () {
                    sidebar.classList.add('toggled');
                    overlay.classList.remove('active');
                });
            }
        })();

        // ── Logout confirmation ─────────────────────────────────
        function confirmLogout(formId) {
            Swal.fire({
                title: 'Logout?',
                text: 'Are you sure you want to logout?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, logout',
                cancelButtonText: 'Cancel'
            }).then(function (result) {
                if (result.isConfirmed) {
                    var form = document.getElementById(formId || 'logoutForm');
                    if (form) form.submit();
                }
            });
        }

        document.getElementById('btnLogout')?.addEventListener('click', function () {
            confirmLogout('logoutForm');
        });
        document.querySelectorAll('.sidebar-logout').forEach(function (btn) {
            btn.addEventListener('click', function () {
                confirmLogout('logoutFormSidebar');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
