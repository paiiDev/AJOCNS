@{
    ViewData["Title"] = "Alumni Career Network";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">

   

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <style>
        /* ==========================
                       NAVBAR
                    ========================== */

        .navbar {
            padding: 16px 0;
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(229, 231, 235, 0.8);
        }

        .navbar-brand {
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--dark) !important;
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            color: white;
            margin-right: 9px;
        }

        .nav-link {
            color: #4b5563 !important;
            font-size: 0.92rem;
            font-weight: 500;
            margin: 0 7px;
        }

            .nav-link:hover {
                color: var(--primary) !important;
            }

        .btn-login {
            color: var(--primary);
            font-weight: 600;
            padding: 9px 18px;
        }


        .btn-primary-custom:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(79, 70, 229, 0.3);
        }

        .btn-outline-custom {
            border: 1px solid #d1d5db;
            color: var(--dark);
            background: white;
            font-weight: 600;
            padding: 11px 20px;
            border-radius: 10px;
            transition: 0.25s ease;
        }

            .btn-outline-custom:hover {
                color: var(--primary);
                border-color: var(--primary);
            }

        /* ==========================
                       HERO
                    ========================== */

        .hero {
            position: relative;
            overflow: hidden;
            padding: 105px 0 95px;
        }


        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #eef2ff;
            color: var(--primary);
            border: 1px solid #e0e7ff;
            border-radius: 50px;
            padding: 8px 15px;
            font-size: 0.78rem;
            font-weight: 700;
            margin-bottom: 22px;
        }

        .hero h1 {
            font-size: clamp(2.5rem, 5vw, 4.2rem);
            line-height: 1.2;
            font-weight: 800;
            letter-spacing: -1.5px;
        }

            .hero h1 span {
                background: linear-gradient(135deg, var(--primary), var(--secondary));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

        .hero-description {
            font-size: 1.05rem;
            line-height: 2;
            color: var(--text);
            max-width: 650px;
            margin: 25px 0 32px;
        }

        .hero-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        /* Hero preview */

        .hero-card-wrapper {
            position: relative;
        }

        .hero-card {
            background: white;
            border-radius: 24px;
            padding: 27px;
            border: 1px solid #eef0f4;
            box-shadow: 0 25px 70px rgba(15, 23, 42, 0.12);
        }

        .hero-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

            .hero-card-header h5 {
                margin: 0;
                font-size: 1rem;
                font-weight: 750;
            }

        .status-badge {
            background: #dcfce7;
            color: #15803d;
            padding: 6px 10px;
            border-radius: 50px;
            font-size: 0.68rem;
            font-weight: 700;
        }

        .opportunity {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 14px;
            border: 1px solid #eef0f4;
            border-radius: 14px;
            margin-bottom: 11px;
        }

        .opportunity-icon {
            width: 44px;
            height: 44px;
            min-width: 44px;
            border-radius: 12px;
            background: #eef2ff;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .opportunity h6 {
            margin: 0 0 4px;
            font-size: 0.86rem;
            font-weight: 700;
        }

        .opportunity small {
            color: #6b7280;
            font-size: 0.72rem;
        }

        .floating-card {
            position: absolute;
            background: white;
            border-radius: 14px;
            padding: 13px 16px;
            box-shadow: 0 15px 40px rgba(15, 23, 42, 0.12);
            border: 1px solid #eef0f4;
            font-size: 0.78rem;
        }

            .floating-card.one {
                top: -25px;
                right: -20px;
            }

            .floating-card.two {
                bottom: -25px;
                left: -20px;
            }

        /* ==========================
                       GENERAL SECTION
                    ========================== */

        .section {
            padding: 90px 0;
        }

        .section-light {
            background: var(--light-bg);
        }

        .section-heading {
            max-width: 700px;
            margin: 0 auto 55px;
            text-align: center;
        }

        .section-label {
            color: var(--primary);
            text-transform: uppercase;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 1.4px;
            margin-bottom: 12px;
        }

        .section-heading h2 {
            font-size: 2.2rem;
            line-height: 1.5;
            font-weight: 800;
            margin-bottom: 13px;
        }

        .section-heading p {
            color: var(--text);
            line-height: 1.9;
            font-size: 0.93rem;
        }

        /* ==========================
                       FEATURE CARDS
                    ========================== */

        .feature-card {
            height: 100%;
            padding: 30px;
            background: white;
            border: 1px solid var(--border);
            border-radius: 18px;
            transition: 0.25s ease;
        }

            .feature-card:hover {
                transform: translateY(-7px);
                border-color: #c7d2fe;
                box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
            }


        .feature-icon {
            width: 53px;
            height: 53px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 15px;
            background: #eef2ff;
            color: var(--primary);
            font-size: 1.35rem;
            margin-bottom: 20px;
        }

        .feature-card h5 {
            font-weight: 750;
            font-size: 1rem;
            margin-bottom: 12px;
        }

        .feature-card p {
            color: var(--text);
            font-size: 0.87rem;
            line-height: 1.9;
            margin: 0;
        }

        /* ==========================
                       ROLE CARDS
                    ========================== */

        .role-card {
            height: 100%;
            padding: 32px;
            border-radius: 20px;
            background: white;
            border: 1px solid var(--border);
            transition: 0.25s ease;
        }

            .role-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
            }

        .role-icon {
            width: 62px;
            height: 62px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #eef2ff, #f5f3ff);
            color: var(--primary);
            font-size: 1.6rem;
            margin-bottom: 20px;
        }

        .role-card h4 {
            font-size: 1.25rem;
            font-weight: 800;
            margin-bottom: 12px;
        }

        .role-card p {
            color: var(--text);
            font-size: 0.88rem;
            line-height: 1.9;
        }

        .role-list {
            list-style: none;
            padding: 0;
            margin: 20px 0 0;
        }

            .role-list li {
                color: #4b5563;
                margin-bottom: 11px;
                font-size: 0.82rem;
            }

            .role-list i {
                color: #22c55e;
                margin-right: 7px;
            }

        /* ==========================
                       HOW IT WORKS
                    ========================== */

        .step {
            text-align: center;
        }

        .step-number {
            width: 60px;
            height: 60px;
            margin: 0 auto 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            font-weight: 800;
            font-size: 1rem;
            box-shadow: 0 10px 25px rgba(79, 70, 229, 0.25);
        }

        .step h5 {
            font-size: 0.98rem;
            font-weight: 750;
            margin-bottom: 10px;
        }

        .step p {
            color: var(--text);
            font-size: 0.82rem;
            line-height: 1.8;
            max-width: 230px;
            margin: auto;
        }

        /* ==========================
                       EVENTS
                    ========================== */

        .event-preview {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid var(--border);
            transition: 0.25s ease;
            height: 100%;
        }

            .event-preview:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);
            }

        .event-top {
            height: 140px;
            padding: 23px;
            background: linear-gradient(135deg, #eef2ff, #f5f3ff);
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .event-type {
            background: white;
            color: var(--primary);
            border-radius: 50px;
            padding: 6px 10px;
            font-size: 0.68rem;
            font-weight: 700;
        }

        .event-date {
            width: 52px;
            height: 62px;
            background: white;
            border-radius: 12px;
            text-align: center;
            padding-top: 7px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.06);
        }

            .event-date strong {
                display: block;
                font-size: 1.2rem;
                color: var(--primary);
            }

            .event-date span {
                font-size: 0.65rem;
                color: #6b7280;
                font-weight: 700;
            }

        .event-body {
            padding: 24px;
        }

            .event-body h5 {
                font-size: 0.98rem;
                line-height: 1.6;
                font-weight: 750;
            }

            .event-body p {
                color: var(--text);
                font-size: 0.82rem;
                line-height: 1.8;
            }

        .event-meta {
            display: flex;
            gap: 13px;
            flex-wrap: wrap;
            color: #6b7280;
            font-size: 0.7rem;
        }

            .event-meta i {
                color: var(--primary);
            }

        /* ==========================
                       TRUST
                    ========================== */

        .trust-box {
            background: #111827;
            color: white;
            border-radius: 25px;
            padding: 55px;
            position: relative;
            overflow: hidden;
        }

            .trust-box::before {
                content: "";
                position: absolute;
                width: 350px;
                height: 350px;
                border-radius: 50%;
                background: rgba(99, 102, 241, 0.18);
                right: -100px;
                top: -150px;
            }

            .trust-box h2 {
                font-size: 2rem;
                line-height: 1.5;
                font-weight: 800;
                position: relative;
            }

            .trust-box > .row {
                position: relative;
            }

            .trust-box p {
                color: #d1d5db;
                line-height: 1.9;
                font-size: 0.87rem;
                position: relative;
            }

        .trust-item {
            display: flex;
            gap: 13px;
            margin-top: 22px;
            position: relative;
        }

        .trust-item-icon {
            min-width: 43px;
            height: 43px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #a5b4fc;
        }

        .trust-item h6 {
            margin: 0 0 5px;
            font-size: 0.84rem;
            font-weight: 700;
        }

        .trust-item small {
            color: #9ca3af;
            font-size: 0.7rem;
            line-height: 1.6;
        }

        /* ==========================
                       ALUMNI FLOW
                    ========================== */

        .flow-card {
            padding: 45px 30px;
            background: #f8fafc;
            border: 1px solid var(--border);
            border-radius: 20px;
        }

        .flow-item {
            padding: 18px;
            background: white;
            border-radius: 14px;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .flow-icon {
            width: 48px;
            height: 48px;
            min-width: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #eef2ff;
            color: var(--primary);
        }

        .flow-arrow {
            text-align: center;
            color: var(--primary);
            padding: 8px 0;
        }

        /* ==========================
                       CTA
                    ========================== */

        .cta-section {
            padding: 90px 0;
        }

        .cta-box {
            padding: 65px 35px;
            text-align: center;
            border-radius: 25px;
            background: radial-gradient( circle at top left, rgba(255, 255, 255, 0.12), transparent 35% ), linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
        }

            .cta-box h2 {
                font-size: 2.4rem;
                line-height: 1.5;
                font-weight: 800;
            }

            .cta-box p {
                max-width: 650px;
                margin: 18px auto 30px;
                color: rgba(255, 255, 255, 0.85);
                font-size: 0.88rem;
                line-height: 1.9;
            }

        .btn-white {
            background: white;
            color: var(--primary);
            border: none;
            padding: 12px 23px;
            border-radius: 10px;
            font-weight: 700;
            transition: 0.25s ease;
        }

            .btn-white:hover {
                background: #f8fafc;
                color: var(--primary-dark);
                transform: translateY(-2px);
            }

        /* ==========================
                       FOOTER
                    ========================== */

        footer {
            background: #0f172a;
            color: white;
            padding: 60px 0 25px;
        }

        .footer-brand {
            font-size: 1rem;
            font-weight: 800;
            margin-bottom: 15px;
        }

        .footer-text {
            color: #94a3b8;
            font-size: 0.8rem;
            line-height: 1.9;
            max-width: 400px;
        }

        .footer-title {
            font-size: 0.85rem;
            font-weight: 700;
            margin-bottom: 17px;
        }

        .footer-links {
            list-style: none;
            padding: 0;
        }

            .footer-links li {
                margin-bottom: 9px;
            }

            .footer-links a {
                color: #94a3b8;
                font-size: 0.75rem;
                transition: 0.2s ease;
            }

                .footer-links a:hover {
                    color: white;
                }

        .footer-bottom {
            border-top: 1px solid #1e293b;
            margin-top: 40px;
            padding-top: 20px;
            color: #64748b;
            font-size: 0.7rem;
        }

        /* ==========================
                       RESPONSIVE
                    ========================== */

        @@media (max-width: 991px) {
            .hero {
                padding: 75px 0;
            }

            .hero-card-wrapper {
                margin-top: 70px;
            }

            .floating-card.one {
                right: 0;
            }

            .floating-card.two {
                left: 0;
            }

            .section {
                padding: 70px 0;
            }

            .trust-box {
                padding: 40px 30px;
            }
        }

        @@media (max-width: 576px) {
            .navbar-brand {
                font-size: 0.9rem;
            }

            .hero h1 {
                font-size: 1.3rem;
            }

            .hero-description {
                font-size: 0.88rem;
            }

            .hero-card {
                padding: 20px;
            }

            .floating-card {
                display: none;
            }

            .section-heading h2 {
                font-size: 1.8rem;
            }

            .cta-box {
                padding: 50px 22px;
            }

                .cta-box h2 {
                    font-size: 1.8rem;
                }
        }


        .hero-visual {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 420px;
        }

        .hub {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            background: linear-gradient( 135deg, var( -- primary), #2c5282 );
            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: .85rem;
            box-shadow: 0 20px 50px rgba(26,54,93, .35);
            position: relative;
            z-index: 3;
            text-align: center;
            line-height: 1.3;
        }

            .hub i {
                font-size: 1.8rem;
                margin-bottom: 6px;
            }

            .hub .hub-sub {
                font-size: .55rem;
                font-weight: 500;
                opacity: .8;
            }

        .hub-ring {
            position: absolute;
            width: 170px;
            height: 170px;
            border-radius: 50%;
            border: 2px dashed rgba(200,169,81,.35);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 1;
        }

        .hub-ring-outer {
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            border: 1px solid rgba(26,54,93,.08);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 1;
        }

        .node {
            position: absolute;
            background: white;
            border-radius: 16px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 11px;
            box-shadow: 0 12px 30px rgba(15,23,42, .10);
            border: 1px solid #eef0f4;
            z-index: 3;
            transition: .25s ease;
            white-space: nowrap;
        }

            .node:hover {
                transform: translateY(-4px);
                box-shadow: 0 16px 40px rgba(15, 23,42, .15);
            }

            .node i {
                font-size: 1.2rem;
            }

            .node .node-label {
                font-size: .78rem;
                font-weight: 700;
                color: var( -- dark);
            }

            .node .node-sub {
                font-size: .62rem;
                color: #6b7280;
                font-weight: 500;
            }

        .node-student {
            top: 50%;
            left: -10px;
            transform: translateY(-50%);
        }

        .node-mentor {
            top: -10px;
            right: -10px;
        }

        .node-partner {
            top: 50%;
            right: -10px;
            transform: translateY(-50%);
        }

        .node-job {
            bottom: -10px;
            right: -10px;
        }

        .node-icon {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .node-icon.student-icon {
                background: #dbeafe;
                color: #2563eb;
            }

            .node-icon.mentor-icon {
                background: #fef9ec;
                color: #b45309;
            }

            .node-icon.partner-icon {
                background: #dcfce7;
                color: #16a34a;
            }

            .node-icon.job-icon {
                background: #f3e8ff;
                color: #9333ea;
            }

        .connector {
            position: absolute;
            background: rgba(26,54,93,.12);
            z-index: 2;
        }

        .connector-student {
            width: 50px;
            height: 2px;
            top: 50%;
            left: 90px;
            transform: translateY(-50%);
        }

        .connector-mentor {
            width: 2px;
            height: 50px;
            top: 70px;
            right: 140px;
        }

        .connector-partner {
            width: 50px;
            height: 2px;
            top: 50%;
            right: 90px;
            transform: translateY(-50%);
        }

        .connector-job {
            width: 2px;
            height: 50px;
            bottom: 70px;
            right: 140px;
        }

        .floating-card {
            position: absolute;
            background: white;
            border-radius: 14px;
            padding: 13px 16px;
            box-shadow: 0 15px 40px rgba(15, 23, 42, .12);
            border: 1px solid #eef0f4;
            font-size: .78rem;
        }

            .floating-card.one {
                top: -25px;
                right: -20px;
            }

            .floating-card.two {
                bottom: -25px;
                left: -20px;
            }
</style>
</head>

