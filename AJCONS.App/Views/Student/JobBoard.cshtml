@model List<AJOCNS.Shared.DTOs.Jobs.JobPostDto>
@{ ViewData["Title"] = "Job Board"; }
<div class="container py-5"><h1>Job board</h1><div class="row g-4 mt-2">@foreach(var job in Model){<div class="col-md-6 col-xl-4"><div class="card h-100 shadow-sm"><div class="card-body d-flex flex-column"><h5>@job.Title</h5><p class="text-muted">@job.CompanyName</p><p><span class="badge bg-primary">@job.JobType</span> <span class="text-muted">@job.Location</span></p><a asp-action="JobDetails" asp-route-id="@job.Id" class="btn btn-primary mt-auto">View and apply</a></div></div></div>}</div></div>
