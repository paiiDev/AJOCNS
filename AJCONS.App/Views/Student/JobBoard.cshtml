@model List<AJOCNS.Shared.DTOs.Jobs.JobPostDto>
@{ ViewData["Title"] = "Job Board"; }
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1 class="mb-1">Job board</h1><p class="text-muted mb-0">Explore opportunities from our community.</p></div>
        <a asp-controller="Student" asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-2"></i>Back to dashboard</a>
    </div>
    <div class="row g-4 mt-2">
        @foreach(var job in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5>@job.Title</h5>
                            @if(job.IsApplied)
                            {
                                <span class="badge text-bg-success rounded-pill">Applied</span>
                            }
                        </div>
                        <p class="text-muted mb-1">@job.CompanyName</p>
                        @if(string.Equals(job.PostedByRole, "Mentor", StringComparison.OrdinalIgnoreCase))
                        {
                            <small class="text-primary mb-3">
                                <i class="fa-solid fa-user-graduate me-1"></i>Posted by @job.PostedByName <span class="text-muted">(Alumni Mentor)</span>
                            </small>
                        }
                        else
                        {
                            <small class="text-muted mb-3">
                                <i class="fa-solid fa-building me-1"></i>Posted by @job.PostedByName
                            </small>
                        }
                        <p>
                            <span class="badge bg-primary">@job.JobType</span> <span class="text-muted">@job.Location</span>
                        </p>
                        @if(job.IsApplied)
                        {
                            <button class="btn btn-outline-success mt-auto" disabled>
                                <i class="fa-solid fa-check me-1"></i>Application submitted
                            </button>
                        }
                        else
                        {
                            <a asp-action="JobDetails" asp-route-id="@job.Id" class="btn btn-primary mt-auto">
                                @(string.Equals(job.PostedByRole, "ExternalPartner", StringComparison.OrdinalIgnoreCase) ? "View and apply" : "View details")
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
