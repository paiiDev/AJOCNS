@model List<AJOCNS.Shared.DTOs.Jobs.JobPostDto>
@{
    ViewData["Title"] = "Job Board";
    var jobTypes = Model.Select(j => j.JobType).Where(t => !string.IsNullOrWhiteSpace(t)).Select(t => t!).Distinct().OrderBy(t => t).ToList();
}
<div class="container-fluid px-lg-4 py-4">

    <!-- Page Header -->
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <div class="page-header-label">Career Center</div>
            <h1 class="page-header-title">Job Board</h1>
            <p class="page-header-sub">Explore opportunities from our community.</p>
        </div>
        <a asp-controller="Student" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>Back to dashboard
        </a>
    </div>

    <!-- Filters -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="d-flex flex-wrap gap-2" id="jobTypeFilter">
            <button type="button" class="btn btn-academic btn-sm rounded-pill px-3 filter-chip active" data-type="">
                <i class="fa-solid fa-border-all me-1" style="font-size:0.7rem;"></i>All
            </button>
            @foreach (var type in jobTypes)
            {
                <button type="button" class="btn btn-sm rounded-pill px-3 filter-chip btn-outline-secondary" data-type="@type">
                    @type
                </button>
            }
        </div>
        <div class="input-group input-group-sm" style="max-width:260px;">
            <span class="input-group-text bg-white"><i class="fa-solid fa-search text-muted"></i></span>
            <input type="text" id="jobSearch" class="form-control" placeholder="Search jobs, companies..." />
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="content-card">
            <div class="table-empty">
                <div class="empty-icon" style="background:var(--brand-blue-soft);color:var(--brand-blue);">
                    <i class="fa-solid fa-briefcase"></i>
                </div>
                <h4>No jobs posted yet</h4>
                <p>Job opportunities will appear here once mentors and partners post them.</p>
                <a asp-controller="Student" asp-action="Index" class="btn btn-academic btn-sm mt-2">
                    <i class="fa-solid fa-arrow-left me-1"></i>Back to dashboard
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4" id="jobCardGrid">
            @foreach (var job in Model)
            {
                <div class="col-md-6 col-xl-4 job-card-col"
                     data-type="@job.JobType"
                     data-search="@job.Title @job.CompanyName @job.Location @job.JobType @job.SalaryRange @job.Description">
                            <div class="job-card h-100 d-flex flex-column">
                                <div class="card-body d-flex flex-column p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="fw-bold mb-0" style="color:var(--text-primary);line-height:1.3;">@job.Title</h5>
                                        @if (job.IsApplied)
                                        {
                                            <span class="badge badge-success flex-shrink-0 ms-2">
                                                <i class="fa-solid fa-check me-1"></i>Applied
                                            </span>
                                        }
                                    </div>

                                    <p class="mb-2" style="color:var(--text-secondary);font-size:0.9rem;">
                                        <i class="fa-solid fa-building me-1" style="font-size:0.8rem;"></i>@job.CompanyName
                                    </p>

                                    @if (string.Equals(job.PostedByRole, "Mentor", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <small class="mb-3" style="color:var(--brand-blue);font-size:0.78rem;">
                                            <i class="fa-solid fa-user-graduate me-1"></i>Posted by @job.PostedByName
                                            <span style="color:var(--text-muted);">(Alumni Mentor)</span>
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="mb-3" style="color:var(--text-muted);font-size:0.78rem;">
                                            <i class="fa-solid fa-building me-1"></i>Posted by @job.PostedByName
                                        </small>
                                    }

                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        @if (!string.IsNullOrEmpty(job.JobType))
                                        {
                                            <span class="badge badge-primary">
                                                <i class="fa-solid fa-tag me-1" style="font-size:0.6rem;"></i>@job.JobType
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(job.Location))
                                        {
                                            <span class="badge badge-muted">
                                                <i class="fa-solid fa-location-dot me-1" style="font-size:0.6rem;"></i>@job.Location
                                            </span>
                                        }
                                    </div>

                                    <div class="mt-auto">
                                        @if (job.IsApplied)
                                        {
                                            <button class="btn btn-sm w-100" disabled
                                                    style="background:var(--success-soft);color:var(--success);border:none;font-weight:700;">
                                                <i class="fa-solid fa-check-circle me-1"></i>Application submitted
                                            </button>
                                        }
                                        else
                                        {
                                            <a asp-action="JobDetails" asp-route-id="@job.Id"
                                               class="btn btn-academic btn-sm w-100">
                                                @(string.Equals(job.PostedByRole, "ExternalPartner", StringComparison.OrdinalIgnoreCase)
                                                    ? "View and apply"
                                                    : "View details")
                                                <i class="fa-solid fa-arrow-right ms-1"></i>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
    </div>

@section Styles {
    <style>
        .filter-chip.active {
            background: var(--brand-blue, #2563eb) !important;
            border-color: var(--brand-blue, #2563eb) !important;
            color: #fff !important;
        }
        .job-card {
            transition: transform .2s ease, box-shadow .2s ease;
        }
        .job-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 32px rgba(16, 35, 63, .10) !important;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const grid = document.getElementById('jobCardGrid');
            const search = document.getElementById('jobSearch');
            const chips = document.querySelectorAll('.filter-chip');
            if (!grid) return;

            const applyFilters = () => {
                const term = (search?.value || '').toLowerCase();
                const activeChip = document.querySelector('.filter-chip.active');
                const type = activeChip?.getAttribute('data-type') || '';

                document.querySelectorAll('.job-card-col').forEach(col => {
                    const matchesType = !type || col.getAttribute('data-type') === type;
                    const haystack = (col.getAttribute('data-search') || '').toLowerCase();
                    const matchesTerm = !term || haystack.includes(term);
                    col.style.display = (matchesType && matchesTerm) ? '' : 'none';
                });
            };

            chips.forEach(chip => {
                chip.addEventListener('click', () => {
                    chips.forEach(c => {
                        c.classList.remove('active', 'btn-academic');
                        c.classList.add('btn-outline-secondary');
                    });
                    chip.classList.add('active', 'btn-academic');
                    chip.classList.remove('btn-outline-secondary');
                    applyFilters();
                });
            });

            search?.addEventListener('input', applyFilters);
        });
    </script>
}
