@model List<AJOCNS.Shared.DTOs.Events.EventDto>
@{
    ViewData["Title"] = "Events | AJCONS";
}

<div class="container-fluid px-lg-4 py-4">

    <!-- Page Header -->
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <div class="page-header-label">Student Portal</div>
            <h1 class="page-header-title">Upcoming Events</h1>
            <p class="page-header-sub">@Model.Count event(s) available for students.</p>
        </div>
        <a asp-controller="Student" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>

    <!-- Filters -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="d-flex flex-wrap gap-2" id="eventTypeFilter">
            <button type="button" class="btn btn-sm rounded-pill px-3 filter-chip active" data-type="">
                All
            </button>
            @foreach (var type in Model.Select(e => e.EventTypeName).Distinct())
            {
                <button type="button" class="btn btn-sm rounded-pill px-3 filter-chip btn-outline-secondary" data-type="@type">
                    @type
                </button>
            }
        </div>
        <div class="input-group input-group-sm" style="max-width:260px;">
            <span class="input-group-text bg-white"><i class="fa-solid fa-search text-muted"></i></span>
            <input type="text" id="eventSearch" class="form-control" placeholder="Search events..." />
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4" id="eventCardGrid">
            @foreach (var ev in Model)
            {
                <div class="col-md-6 col-xl-4 event-card-col"
                     data-type="@ev.EventTypeName"
                     data-search="@ev.EventTitle @ev.EventTypeName @ev.Location @ev.EventMode">
                    <div class="event-card h-100" role="button" tabindex="0" data-id="@ev.Id" title="View @ev.EventTitle">

                        <!-- Banner -->
                        <div class="ev-card-banner">
                            @if (!string.IsNullOrEmpty(ev.PosterImagePath))
                            {
                                <img src="@ev.PosterImagePath" alt="@ev.EventTitle poster"
                                     onerror="this.parentElement.classList.add('ev-card-no-poster');this.remove()" />
                            }
                            <div class="ev-card-shade"></div>
                            <span class="ev-card-type-badge">@ev.EventTypeName</span>
                            <div class="ev-card-date-chip">
                                <span class="ev-card-date-day">@ev.EventDate.ToString("dd")</span>
                                <span class="ev-card-date-month">@ev.EventDate.ToString("MMM")</span>
                            </div>
                            <i class="fa-solid fa-calendar-days ev-card-bg-icon"></i>
                        </div>

                        <!-- Body -->
                        <div class="ev-card-body">
                            <h5 class="ev-card-title">@ev.EventTitle</h5>
                            <p class="ev-card-desc">
                                @(string.IsNullOrEmpty(ev.Description) ? "No description provided." : (ev.Description.Length > 80 ? ev.Description.Substring(0, 80) + "..." : ev.Description))
                            </p>

                            <div class="ev-card-meta">
                                <span><i class="fa-regular fa-clock"></i>@ev.EventDate.ToString("dd MMM yyyy") · @ev.EventDate.ToString("hh:mm tt")</span>
                                <span><i class="fa-solid fa-location-dot"></i>@(string.IsNullOrEmpty(ev.Location) ? (ev.EventMode ?? "Online") : ev.Location)</span>
                                <span>
                                    <i class="fa-solid fa-users"></i>
                                    @if (ev.MaxCapacity.HasValue)
                                    {
                                        var seatsLeft = ev.MaxCapacity.Value - ev.RegisteredCount;
                                        @(seatsLeft > 0 ? $"{seatsLeft} seats left" : "Event full")
                                    }
                                    else
                                    {
                                        <text>Unlimited seats</text>
                                    }
                                </span>
                            </div>

                            <!-- Action -->
                            <div class="ev-card-action">
                                @if (ev.IsRegistered)
                                {
                                    <span class="btn btn-sm w-100 rounded-pill fw-semibold btn-outline-success" disabled>
                                        <i class="fa-solid fa-circle-check me-1"></i>Registered
                                    </span>
                                }
                                else
                                {
                                    <form asp-controller="Student" asp-action="RegisterEvent" asp-route-id="@ev.Id" method="post" class="d-inline w-100 confirm-register" data-event-title="@ev.EventTitle">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm w-100 rounded-pill fw-semibold btn-academic ev-register-btn"
                                                @(ev.MaxCapacity.HasValue && ev.MaxCapacity.Value - ev.RegisteredCount <= 0 ? "disabled" : "")>
                                            <i class="fa-solid fa-user-plus me-1"></i>Register
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="content-card">
            <div class="card-body text-center py-5">
                <div class="empty-icon mx-auto mb-3" style="background:var(--brand-blue-soft);color:var(--brand-blue);width:56px;height:56px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;">
                    <i class="fa-regular fa-calendar-xmark"></i>
                </div>
                <h5 class="fw-bold mb-1" style="color:var(--text-primary);">No upcoming events</h5>
                <p class="mb-0" style="color:var(--text-muted);">New events from mentors will appear here once approved.</p>
            </div>
        </div>
    }
</div>

<!-- Modal -->
<div class="modal fade" id="eventDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="modalContentArea">
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .ev-card-banner {
            position: relative;
            height: 170px;
            background: linear-gradient(135deg, #1d4ed8, #7c3aed);
            overflow: hidden;
        }
        .ev-card-banner img {
            width: 100%;
            height: 170px;
            object-fit: cover;
            display: block;
        }
        .ev-card-no-poster { background: linear-gradient(135deg, #1d4ed8, #7c3aed); }
        .ev-card-shade {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,.45));
        }
        .ev-card-bg-icon {
            position: absolute;
            right: -15px;
            bottom: -15px;
            font-size: 110px;
            color: rgba(255,255,255,.10);
        }
        .ev-card-type-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(255,255,255,.92);
            color: #1d4ed8;
            font-weight: 600;
            font-size: .72rem;
            padding: .35em .75em;
            border-radius: 50rem;
            box-shadow: 0 2px 8px rgba(0,0,0,.12);
        }
        .ev-card-date-chip {
            position: absolute;
            right: 10px;
            bottom: 10px;
            background: rgba(255,255,255,.95);
            border-radius: 10px;
            padding: .3rem .55rem;
            text-align: center;
            line-height: 1.1;
            box-shadow: 0 4px 12px rgba(0,0,0,.15);
        }
        .ev-card-date-day { display: block; font-size: 1rem; font-weight: 800; color: #1d4ed8; }
        .ev-card-date-month { display: block; font-size: .62rem; font-weight: 700; color: #64748b; text-transform: uppercase; }

        .event-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(16,35,63,.06);
            background: #fff;
            overflow: hidden;
            cursor: pointer;
            transition: transform .25s ease, box-shadow .25s ease;
        }
        .event-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 32px rgba(16,35,63,.10);
        }
        .ev-card-body { padding: 1.25rem; }
        .ev-card-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary, #142033);
            margin-bottom: .35rem;
            min-height: 2.8rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .ev-card-desc {
            font-size: .82rem;
            color: var(--text-muted, #64748b);
            line-height: 1.55;
            margin-bottom: .75rem;
            min-height: 2.6rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .ev-card-meta {
            display: flex;
            flex-direction: column;
            gap: .35rem;
            margin-bottom: 1rem;
        }
        .ev-card-meta span {
            display: flex;
            align-items: center;
            gap: .5rem;
            font-size: .78rem;
            color: var(--text-secondary, #4b5563);
        }
        .ev-card-meta i {
            width: 16px;
            text-align: center;
            font-size: .75rem;
        }
        .ev-card-meta .fa-clock { color: var(--brand-blue, #2563eb); }
        .ev-card-meta .fa-location-dot { color: var(--brand-rose, #e05269); }
        .ev-card-meta .fa-users { color: var(--brand-teal, #0f9f8f); }
        .ev-card-action { margin-top: auto; }

        .filter-chip.active {
            background: var(--brand-blue, #2563eb) !important;
            border-color: var(--brand-blue, #2563eb) !important;
            color: #fff !important;
        }
    </style>
}

@section Scripts {
    <script>
        function swalEscape(str) {
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const grid = document.getElementById('eventCardGrid');
            const search = document.getElementById('eventSearch');
            const chips = document.querySelectorAll('.filter-chip');

            if (!grid) return;

            const applyFilters = () => {
                const term = (search?.value || '').toLowerCase();
                const activeChip = document.querySelector('.filter-chip.active');
                const type = activeChip?.getAttribute('data-type') || '';

                document.querySelectorAll('.event-card-col').forEach(col => {
                    const matchesType = !type || col.getAttribute('data-type') === type;
                    const haystack = (col.getAttribute('data-search') || '').toLowerCase();
                    const matchesTerm = !term || haystack.includes(term);
                    col.style.display = (matchesType && matchesTerm) ? '' : 'none';
                });
            };

            chips.forEach(chip => {
                chip.addEventListener('click', () => {
                    chips.forEach(c => {
                        c.classList.remove('active');
                        c.classList.add('btn-outline-secondary');
                    });
                    chip.classList.add('active');
                    chip.classList.remove('btn-outline-secondary');
                    applyFilters();
                });
            });

            search?.addEventListener('input', applyFilters);

            const openModal = (eventId) => {
                const modalElement = document.getElementById('eventDetailsModal');
                const modal = new bootstrap.Modal(modalElement);
                const contentArea = document.getElementById('modalContentArea');
                contentArea.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
                modal.show();

                fetch(`@Url.Action("GetEventDetailsModal", "Student")?id=${eventId}`)
                    .then(response => {
                        if (!response.ok) throw new Error('Network Error');
                        return response.text();
                    })
                    .then(html => { contentArea.innerHTML = html; })
                    .catch(() => {
                        contentArea.innerHTML = '<div class="p-4 text-danger">There was an error fetching event details.</div>';
                    });
            };

            grid.querySelectorAll('.event-card').forEach(card => {
                card.addEventListener('click', () => {
                    const btn = card.querySelector('.confirm-register button[type=submit]');
                    if (btn && btn.disabled) return;
                    openModal(card.getAttribute('data-id'));
                });
                card.addEventListener('keydown', e => {
                    if ((e.key === 'Enter' || e.key === ' ') && e.target.tagName !== 'BUTTON' && e.target.tagName !== 'A') {
                        e.preventDefault();
                        openModal(card.getAttribute('data-id'));
                    }
                });
                card.querySelectorAll('.confirm-register').forEach(form => {
                    form.addEventListener('click', e => e.stopPropagation());
                    form.addEventListener('submit', function (event) {
                        event.preventDefault();
                        const title = this.getAttribute('data-event-title') || 'this event';
                        const formEl = this;
                        Swal.fire({
                            title: 'Before you register',
                            html: `
                                <div style="text-align:left">
                                    <p class="mb-2" style="font-size:.95rem">
                                        You're registering for <strong>${swalEscape(title)}</strong>. Please review the event etiquette:
                                    </p>
                                    <ul style="text-align:left;font-size:.9rem;line-height:1.7;padding-left:1.2rem">
                                        <li><i class="fa-solid fa-video text-primary me-1"></i> This is a <strong>free</strong> webinar — no payment is required.</li>
                                        <li><i class="fa-solid fa-comments text-info me-1"></i> Join on time and keep your microphone muted unless asked to speak.</li>
                                        <li><i class="fa-solid fa-hand text-success me-1"></i> Use the raise-hand feature; do not interrupt the speaker or other mentees.</li>
                                        <li><i class="fa-solid fa-user-shield text-warning me-1"></i> Be respectful to the mentor and fellow mentees at all times.</li>
                                        <li><i class="fa-solid fa-check-double text-danger me-1"></i> Only register if you can attend — don't take a seat you won't use.</li>
                                    </ul>
                                    <label class="form-check mt-2" style="font-size:.9rem">
                                        <input type="checkbox" class="form-check-input" id="swalAgree">
                                        <span class="form-check-label">I agree to follow these rules and will attend responsibly.</span>
                                    </label>
                                </div>
                            `,
                            icon: 'info',
                            showCancelButton: true,
                            confirmButtonColor: '#2563eb',
                            cancelButtonColor: '#6c757d',
                            confirmButtonText: 'Yes, I agree & register',
                            cancelButtonText: 'Cancel',
                            allowOutsideClick: false,
                            didRender: () => {
                                const agree = document.getElementById('swalAgree');
                                const btn = Swal.getConfirmButton();
                                btn.disabled = !agree.checked;
                                agree.addEventListener('change', () => {
                                    btn.disabled = !agree.checked;
                                });
                            },
                            preConfirm: () => {
                                if (!document.getElementById('swalAgree').checked) {
                                    Swal.showValidationMessage('Please agree to the event rules to register.');
                                    return false;
                                }
                                return true;
                            }
                        }).then(result => {
                            if (result.isConfirmed) {
                                formEl.submit();
                            }
                        });
                    });
                });
            });
        });
    </script>
}
