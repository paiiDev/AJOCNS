@model List<AJOCNS.Shared.DTOs.Events.EventDto>
@{
    ViewData["Title"] = "Events | AJCONS";
}

<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="text-uppercase fw-bold small text-academic mb-1" style="letter-spacing:.08em">
                        Student portal
                    </div>
                    <h1 class="h2 fw-bold mb-1">Upcoming events</h1>
                    <p class="text-muted mb-0">@Model.Count event(s) available for students.</p>
                </div>
                <a asp-controller="Student" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-2"></i>Back to dashboard
                </a>
            </div>
        </div>
    </section>

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div class="d-flex flex-wrap gap-2" id="eventTypeFilter">
                    <button type="button" class="btn btn-academic btn-sm rounded-pill px-3 filter-chip active" data-type="">
                        All
                    </button>
                    @foreach (var type in Model.Select(e => e.EventTypeName).Distinct())
                    {
                        <button type="button" class="btn btn-sm rounded-pill px-3 filter-chip btn-outline-secondary" data-type="@type">
                            @type
                        </button>
                    }
                </div>
                <div class="input-group input-group-sm" style="max-width:300px">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" id="eventSearch" class="form-control" placeholder="Search events..." />
                </div>
            </div>

            @if (Model.Any())
            {
                <div class="row g-4" id="eventCardGrid">
                    @foreach (var ev in Model)
                    {
                        <div class="col-md-6 col-xl-4 event-card-col"
                             data-type="@ev.EventTypeName"
                             data-search="@(ev.EventTitle) @ev.EventTypeName @ev.Location @ev.EventMode">
                            <div class="card border-0 rounded-4 shadow-sm h-100 overflow-hidden event-card"
                                 role="button" tabindex="0" data-id="@ev.Id"
                                 title="View details for @ev.EventTitle">
                                @if (!string.IsNullOrEmpty(ev.PosterImagePath))
                                {
                                    <div class="event-banner position-relative overflow-hidden">
                                        <img src="@ev.PosterImagePath" alt="@ev.EventTitle poster"
                                             onerror="this.parentElement.classList.add('no-poster');this.remove()" />
                                        <span class="badge event-type-badge">@ev.EventTypeName</span>
                                        <div class="event-banner-shade"></div>
                                        <div class="event-date-chip">
                                            <span class="event-date-chip-day">@ev.EventDate.ToString("dd")</span>
                                            <span class="event-date-chip-month text-uppercase">@ev.EventDate.ToString("MMM")</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="event-banner event-banner-gradient position-relative overflow-hidden">
                                        <i class="fa-solid fa-calendar-days event-banner-icon"></i>
                                        <span class="badge event-type-badge">@ev.EventTypeName</span>
                                        <div class="event-date-chip">
                                            <span class="event-date-chip-day">@ev.EventDate.ToString("dd")</span>
                                            <span class="event-date-chip-month text-uppercase">@ev.EventDate.ToString("MMM")</span>
                                        </div>
                                    </div>
                                }

                                <div class="card-body d-flex flex-column p-4">
                                    <h5 class="fw-bold mb-2 text-dark event-card-title">@ev.EventTitle</h5>
                                    <p class="text-muted small mb-4 event-card-desc">
                                        @(string.IsNullOrEmpty(ev.Description) ? "No description provided." : (ev.Description.Length > 70 ? ev.Description.Substring(0, 70) + "..." : ev.Description))
                                    </p>

                                    <ul class="list-unstyled event-meta mb-4">
                                        <li>
                                            <i class="fa-regular fa-clock text-academic"></i>
                                            <span>@ev.EventDate.ToString("dd MMM yyyy")<span class="text-muted"> · </span>@ev.EventDate.ToString("hh:mm tt")</span>
                                        </li>
                                        <li>
                                            <i class="fa-solid fa-location-dot text-danger"></i>
                                            <span>@(string.IsNullOrEmpty(ev.Location) ? (ev.EventMode ?? "Online") : ev.Location)</span>
                                        </li>
                                        <li>
                                            <i class="fa-solid fa-users text-success"></i>
                                            <span>
                                                @if (ev.MaxCapacity.HasValue)
                                                {
                                                    var seatsLeft = ev.MaxCapacity.Value - ev.RegisteredCount;
                                                    <text>@(seatsLeft > 0 ? seatsLeft + " seats left" : "Event full")</text>
                                                }
                                                else
                                                {
                                                    <text>Unlimited seats</text>
                                                }
                                            </span>
                                        </li>
                                    </ul>

                                    <div class="mt-auto">
                                        @if (ev.IsRegistered)
                                        {
                                            <span class="btn btn-outline-success btn-sm w-100 rounded-pill fw-semibold disabled" aria-disabled="true">
                                                <i class="fa-solid fa-circle-check me-1"></i>Registered
                                            </span>
                                        }
                                        else
                                        {
                                            <form asp-controller="Student" asp-action="RegisterEvent" asp-route-id="@ev.Id" method="post" class="d-inline w-100 confirm-register" data-event-title="@ev.EventTitle">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-academic btn-sm w-100 rounded-pill fw-semibold event-open-btn"
                                                        @(ev.MaxCapacity.HasValue && ev.MaxCapacity.Value - ev.RegisteredCount <= 0 ? "disabled" : "")>
                                                    <i class="fa-solid fa-user-plus me-1"></i>Register
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card adminlte-card border-0 rounded-4 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fa-regular fa-calendar-xmark fs-1 text-muted mb-3 d-block"></i>
                        <h5 class="fw-bold text-dark mb-1">No upcoming events</h5>
                        <p class="text-muted mb-0">New events from mentors will appear here once approved.</p>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

<div class="modal fade" id="eventDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="modalContentArea">
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .event-card {
            cursor: pointer;
            transition: transform .2s ease, box-shadow .2s ease;
        }
        .event-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 30px rgba(11, 92, 171, .14) !important;
        }
        .event-card:focus-visible {
            outline: 3px solid rgba(11, 92, 171, .4);
            outline-offset: 2px;
        }
        .event-banner {
            height: 165px;
            background: #dfe9f5;
        }
        .event-banner img {
            width: 100%;
            height: 165px;
            object-fit: cover;
            display: block;
        }
        .event-banner.no-poster {
            background: linear-gradient(135deg, var(--academic-blue-deep), var(--academic-blue));
        }
        .event-banner-gradient {
            background: linear-gradient(135deg, var(--academic-blue-deep), var(--academic-blue));
        }
        .event-banner-icon {
            position: absolute;
            right: -18px;
            bottom: -18px;
            font-size: 120px;
            color: rgba(255, 255, 255, .12);
        }
        .event-banner-shade {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, .35));
        }
        .event-type-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            background: rgba(255, 255, 255, .92);
            color: var(--academic-blue-deep);
            font-weight: 600;
            padding: .4em .8em;
            border-radius: 50rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, .12);
        }
        .event-date-chip {
            position: absolute;
            right: 12px;
            bottom: 12px;
            background: rgba(255, 255, 255, .95);
            border-radius: .75rem;
            padding: .35rem .6rem;
            text-align: center;
            line-height: 1.1;
            box-shadow: 0 4px 12px rgba(0, 0, 0, .18);
        }
        .event-date-chip-day {
            display: block;
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--academic-blue);
        }
        .event-date-chip-month {
            display: block;
            font-size: .68rem;
            font-weight: 700;
            color: #6c757d;
        }
        .event-card-title {
            min-height: 3.2rem;
        }
        .event-card-desc {
            min-height: 3.2rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .event-meta li {
            display: flex;
            align-items: center;
            gap: .6rem;
            font-size: .85rem;
            margin-bottom: .5rem;
            color: #343a40;
        }
        .event-meta li i {
            width: 18px;
            text-align: center;
        }
        .filter-chip.active {
            background: var(--academic-blue);
            border-color: var(--academic-blue);
            color: #fff;
        }
    </style>
}

@section Scripts {
    <script>
        function swalEscape(str) {
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const grid = document.getElementById('eventCardGrid');
            const search = document.getElementById('eventSearch');
            const chips = document.querySelectorAll('.filter-chip');

            if (!grid) return;

            const applyFilters = () => {
                const term = (search?.value || '').toLowerCase();
                const activeChip = document.querySelector('.filter-chip.active');
                const type = activeChip?.getAttribute('data-type') || '';

                document.querySelectorAll('.event-card-col').forEach(col => {
                    const matchesType = !type || col.getAttribute('data-type') === type;
                    const haystack = (col.getAttribute('data-search') || '').toLowerCase();
                    const matchesTerm = !term || haystack.includes(term);
                    col.style.display = (matchesType && matchesTerm) ? '' : 'none';
                });
            };

            chips.forEach(chip => {
                chip.addEventListener('click', () => {
                    chips.forEach(c => {
                        c.classList.remove('active', 'btn-academic');
                        c.classList.add('btn-outline-secondary');
                    });
                    chip.classList.add('active', 'btn-academic');
                    chip.classList.remove('btn-outline-secondary');
                    applyFilters();
                });
            });

            search?.addEventListener('input', applyFilters);

            const openModal = (eventId) => {
                const modalElement = document.getElementById('eventDetailsModal');
                const modal = new bootstrap.Modal(modalElement);
                const contentArea = document.getElementById('modalContentArea');
                contentArea.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
                modal.show();

                fetch(`@Url.Action("GetEventDetailsModal", "Student")?id=${eventId}`)
                    .then(response => {
                        if (!response.ok) throw new Error('Network Error');
                        return response.text();
                    })
                    .then(html => { contentArea.innerHTML = html; })
                    .catch(() => {
                        contentArea.innerHTML = '<div class="p-4 text-danger">There was an error fetching event details.</div>';
                    });
            };

            grid.querySelectorAll('.event-card').forEach(card => {
                card.addEventListener('click', () => {
                    const btn = card.querySelector('.confirm-register button[type=submit]');
                    if (btn && btn.disabled) return;
                    openModal(card.getAttribute('data-id'));
                });
                card.addEventListener('keydown', e => {
                    if ((e.key === 'Enter' || e.key === ' ') && e.target.tagName !== 'BUTTON' && e.target.tagName !== 'A') {
                        e.preventDefault();
                        openModal(card.getAttribute('data-id'));
                    }
                });
                card.querySelectorAll('.confirm-register').forEach(form => {
                    form.addEventListener('click', e => e.stopPropagation());
                    form.addEventListener('submit', function (event) {
                        event.preventDefault();
                        const title = this.getAttribute('data-event-title') || 'this event';
                        const formEl = this;
                        Swal.fire({
                            title: 'Before you register',
                            html: `
                                <div style="text-align:left">
                                    <p class="mb-2" style="font-size:.95rem">
                                        You're registering for <strong>${swalEscape(title)}</strong>. Please review the event etiquette:
                                    </p>
                                    <ul style="text-align:left;font-size:.9rem;line-height:1.7;padding-left:1.2rem">
                                        <li><i class="fa-solid fa-video text-primary me-1"></i> This is a <strong>free</strong> webinar — no payment is required.</li>
                                        <li><i class="fa-solid fa-comments text-info me-1"></i> Join on time and keep your microphone muted unless asked to speak.</li>
                                        <li><i class="fa-solid fa-hand text-success me-1"></i> Use the raise-hand feature; do not interrupt the speaker or other mentees.</li>
                                        <li><i class="fa-solid fa-user-shield text-warning me-1"></i> Be respectful to the mentor and fellow mentees at all times.</li>
                                        <li><i class="fa-solid fa-check-double text-danger me-1"></i> Only register if you can attend — don't take a seat you won't use.</li>
                                    </ul>
                                    <label class="form-check mt-2" style="font-size:.9rem">
                                        <input type="checkbox" class="form-check-input" id="swalAgree">
                                        <span class="form-check-label">I agree to follow these rules and will attend responsibly.</span>
                                    </label>
                                </div>
                            `,
                            icon: 'info',
                            showCancelButton: true,
                            confirmButtonColor: '#0b5cab',
                            cancelButtonColor: '#6c757d',
                            confirmButtonText: 'Yes, I agree & register',
                            cancelButtonText: 'Cancel',
                            allowOutsideClick: false,
                            didRender: () => {
                                const agree = document.getElementById('swalAgree');
                                const btn = Swal.getConfirmButton();
                                btn.disabled = !agree.checked;
                                agree.addEventListener('change', () => {
                                    btn.disabled = !agree.checked;
                                });
                            },
                            preConfirm: () => {
                                if (!document.getElementById('swalAgree').checked) {
                                    Swal.showValidationMessage('Please agree to the event rules to register.');
                                    return false;
                                }
                                return true;
                            }
                        }).then(result => {
                            if (result.isConfirmed) {
                                formEl.submit();
                            }
                        });
                    });
                });
            });
        });
    </script>
}