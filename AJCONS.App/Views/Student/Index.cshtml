@model AJOCNS.Shared.DTOs.StudentDashboard.StudentDashboardDto
@using AJOCNS.Shared.DTOs.Events
@using AJOCNS.Shared.DTOs.Jobs
@{
    ViewData["Title"] = "Student Dashboard | AJCONS";

    var registeredEvents = ViewBag.RegisteredEvents as List<EventDto> ?? new List<EventDto>();
    var upcomingEvents = registeredEvents
        .Where(e => string.Equals(e.Status, "Upcoming", StringComparison.OrdinalIgnoreCase))
        .OrderBy(e => e.EventDate)
        .ToList();
    var completedEvents = registeredEvents
        .Where(e => string.Equals(e.Status, "Completed", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var activityTotal = registeredEvents.Count;
    var activityPercent = activityTotal > 0 ? (int)Math.Round((double)completedEvents.Count / activityTotal * 100) : 0;
    var appliedJobs = ViewBag.AppliedJobs as List<AppliedJobDto> ?? new List<AppliedJobDto>();
}

<!-- Wrapper consistent with the app shell: content below the top navbar -->
<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="text-uppercase fw-bold small text-academic mb-1" style="letter-spacing:.08em">
                        Student portal
                    </div>
                    <h1 class="h2 fw-bold mb-1">My dashboard</h1>
                    <p class="text-muted mb-0">Welcome back, @Model.Name.</p>
                </div>
                <a asp-controller="Student" asp-action="Event" class="btn btn-academic">
                    <i class="fa-solid fa-calendar-plus me-2"></i>Browse events
                </a>
            </div>
        </div>
    </section>

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">

            @{
                var gradClass = Model.GraduationStatus.ToLower() switch
                {
                    "graduated" => "text-bg-success",
                    "dropout" => "text-bg-secondary",
                    _ => "badge bg-info"
                };
            }

            <!-- Quick stats grid driven by actual profile -->
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 rounded-4 shadow-sm h-100 bg-white">
                        <div class="card-body p-4 d-flex align-items-center">
                            <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary me-3">
                                <i class="fa-solid fa-user-graduate fs-4"></i>
                            </div>
                            <div>
                                <h6 class="text-muted mb-1">My Major</h6>
                                <h6 class="fw-bold mb-0 text-dark text-truncate" title="@Model.Major">@Model.Major</h6>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 rounded-4 shadow-sm h-100 bg-white">
                        <div class="card-body p-4 d-flex align-items-center">
                            <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success me-3">
                                <i class="fa-solid fa-calendar-days fs-4"></i>
                            </div>
                            <div>
                                <h6 class="text-muted mb-1">Academic Year</h6>
                                <h6 class="fw-bold mb-0 text-dark">@(Model.AcademicYear ?? "—")</h6>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 rounded-4 shadow-sm h-100 bg-white">
                        <div class="card-body p-4 d-flex align-items-center">
                            <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning me-3">
                                <i class="fa-solid fa-certificate fs-4"></i>
                            </div>
                            <div>
                                <h6 class="text-muted mb-2">Programme Status</h6>
                                <span class="badge @gradClass rounded-pill fw-semibold">
                                    @Model.GraduationStatus
                                    @if (Model.IsGraduated && Model.GraduationYear.HasValue)
                                    {
                                        <text> · @Model.GraduationYear</text>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card border-0 rounded-4 shadow-sm h-100">
                        <div class="card-header bg-white border-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0"><i class="fa-solid fa-briefcase text-primary me-2"></i> My Job Applications</h6>
                            <a asp-controller="Student" asp-action="JobBoard" class="small text-decoration-none">Browse jobs</a>
                        </div>
                        <div class="card-body p-4">
                            @if (!appliedJobs.Any()) { <p class="text-muted small mb-0">You have not applied for any jobs yet.</p> }
                            else { foreach (var application in appliedJobs.Take(3)) { <div class="d-flex justify-content-between align-items-center border-bottom py-2"><div class="min-w-0"><div class="fw-semibold text-truncate">@application.Title</div><small class="text-muted">@application.CompanyName</small></div><span class="badge rounded-pill ms-2 @(application.Status == "Shortlisted" ? "text-bg-success" : application.Status == "Rejected" ? "text-bg-danger" : "text-bg-warning")">@application.Status</span></div> } }
                        </div>
                    </div>
                </div>

                <!-- Event activity (real data) -->
                <div class="col-lg-4">
                    <div class="card border-0 rounded-4 shadow-sm h-100">
                        <div class="card-header bg-white border-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0"><i class="fa-solid fa-chart-simple text-primary me-2"></i> My Event Activity</h6>
                            <a asp-controller="Student" asp-action="Event" class="text-decoration-none small">Browse</a>
                        </div>
                        <div class="card-body p-4">
                            @if (activityTotal == 0)
                            {
                                <p class="text-muted small mb-3">You haven't registered for any events yet.</p>
                                <div class="d-grid">
                                    <a asp-controller="Student" asp-action="Event" class="btn btn-academic btn-sm">
                                        <i class="fa-solid fa-magnifying-glass me-1"></i> Explore events
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-end justify-content-between mb-3">
                                    <div>
                                        <span class="display-6 fw-bold text-dark">@activityTotal</span>
                                        <span class="text-muted small d-block">registrations</span>
                                    </div>
                                    <div class="text-end">
                                        <span class="fw-semibold text-success small"><i class="fa-solid fa-circle-check me-1"></i>@completedEvents.Count completed</span>
                                        <span class="fw-semibold text-primary small d-block mt-1"><i class="fa-solid fa-calendar-days me-1"></i>@upcomingEvents.Count upcoming</span>
                                    </div>
                                </div>
                                <div class="progress mb-2" style="height:10px;">
                                    <div class="progress-bar bg-success rounded-pill" role="progressbar" style="width:@activityPercent%;" aria-valuenow="@activityPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <div class="text-muted small fw-semibold">@activityPercent% completed</div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Registered events (real data) -->
                <div class="col-lg-4">
                    <div class="card border-0 rounded-4 shadow-sm h-100">
                        <div class="card-header bg-white border-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i> My Upcoming Events</h6>
                            <a asp-controller="Student" asp-action="Event" class="text-decoration-none small">View All</a>
                        </div>
                        <div class="card-body p-4">
                            @if (upcomingEvents.Count == 0)
                            {
                                <p class="text-muted small mb-0">No upcoming events. Explore the event directory to register.</p>
                            }
                            else
                            {
                                var shownEvents = upcomingEvents.Take(3).ToList();
                                for (int i = 0; i < shownEvents.Count; i++)
                                {
                                    var evt = shownEvents[i];
                                    <div class="d-flex align-items-center @(i < shownEvents.Count - 1 ? "mb-3 pb-3 border-bottom" : "")">
                                        <div class="bg-light rounded-3 text-center p-2 me-3" style="width:60px;">
                                            <span class="d-block fw-bold text-primary">@evt.EventDate.Day</span>
                                            <span class="d-block small text-muted text-uppercase">@evt.EventDate.ToString("MMM")</span>
                                        </div>
                                        <div class="min-w-0" style="min-width: 0; overflow: hidden;">
                                            <h6 class="fw-bold mb-1 text-truncate" title="@evt.EventTitle">@evt.EventTitle</h6>
                                            <span class="text-muted small d-block text-truncate">
                                                @if (string.Equals(evt.EventMode, "Online", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <i class="fa-solid fa-video me-1"></i><text>Online</text>
                                                }
                                                else
                                                {
                                                    <i class="fa-solid fa-location-dot me-1"></i>@(string.IsNullOrWhiteSpace(evt.Location) ? "Onsite" : evt.Location)
                                                }
                                            </span>
                                        </div>
                                    </div>
                                }
                                if (upcomingEvents.Count > 3)
                                {
                                    <a asp-controller="Student" asp-action="Event" class="small text-decoration-none mt-3 d-inline-block">+@(upcomingEvents.Count - 3) more upcoming</a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>