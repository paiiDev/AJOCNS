@model AJOCNS.Shared.DTOs.StudentDashboard.StudentDashboardDto
@using AJOCNS.Shared.DTOs.Events
@using AJOCNS.Shared.DTOs.Jobs
@{
    ViewData["Title"] = "Student Dashboard | AJCONS";

    var registeredEvents = ViewBag.RegisteredEvents as List<EventDto> ?? new List<EventDto>();
    var upcomingEvents = registeredEvents
        .Where(e => string.Equals(e.Status, "Upcoming", StringComparison.OrdinalIgnoreCase))
        .OrderBy(e => e.EventDate)
        .ToList();
    var completedEvents = registeredEvents
        .Where(e => string.Equals(e.Status, "Completed", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var activityTotal = registeredEvents.Count;
    var activityPercent = activityTotal > 0 ? (int)Math.Round((double)completedEvents.Count / activityTotal * 100) : 0;
    var appliedJobs = ViewBag.AppliedJobs as List<AppliedJobDto> ?? new List<AppliedJobDto>();
}

<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="page-header-label">Student Portal</div>
                    <h1 class="page-header-title">My Dashboard</h1>
                    <p class="page-header-sub">Welcome back, @Model.Name.</p>
                </div>
                <a asp-controller="Student" asp-action="Event" class="btn btn-academic">
                    <i class="fa-solid fa-calendar-plus me-2"></i>Browse events
                </a>
            </div>
        </div>
    </section>

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">

            @{
                var gradClass = Model.GraduationStatus.ToLower() switch
                {
                    "graduated" => "badge-success",
                    "dropout" => "badge-muted",
                    _ => "badge-info"
                };
            }

            <!-- Quick stats grid -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="stat-card h-100">
                        <div class="stat-card-body">
                            <div>
                                <div class="stat-card-label">My Major</div>
                                <div class="stat-card-num" style="font-size:1.1rem;font-weight:700;color:var(--text-primary);" title="@Model.Major">@Model.Major</div>
                            </div>
                            <div class="stat-card-icon stat-icon-blue">
                                <i class="fa-solid fa-user-graduate"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card h-100">
                        <div class="stat-card-body">
                            <div>
                                <div class="stat-card-label">Academic Year</div>
                                <div class="stat-card-num" style="font-size:1.1rem;font-weight:700;color:var(--text-primary);">@(Model.AcademicYear ?? "—")</div>
                            </div>
                            <div class="stat-card-icon stat-icon-teal">
                                <i class="fa-solid fa-calendar-days"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-card h-100">
                        <div class="stat-card-body">
                            <div>
                                <div class="stat-card-label">Programme Status</div>
                                <span class="status-pill @gradClass mt-1">
                                    @Model.GraduationStatus
                                    @if (Model.IsGraduated && Model.GraduationYear.HasValue)
                                    {
                                        <text> · @Model.GraduationYear</text>
                                    }
                                </span>
                            </div>
                            <div class="stat-card-icon stat-icon-amber">
                                <i class="fa-solid fa-certificate"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- Job Applications -->
                <div class="col-lg-4">
                    <div class="content-card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center pt-4 pb-3 px-4">
                            <h6 class="fw-bold mb-0">
                                <i class="fa-solid fa-briefcase me-2" style="color:var(--brand-blue);"></i>My Job Applications
                            </h6>
                            <a asp-controller="Student" asp-action="JobBoard" class="small text-decoration-none" style="color:var(--brand-blue);">Browse jobs</a>
                        </div>
                        <div class="card-body p-4">
                            @if (!appliedJobs.Any())
                            {
                                <div class="text-center py-3">
                                    <i class="fa-solid fa-briefcase mb-2" style="font-size:1.5rem;color:var(--border);"></i>
                                    <p class="text-muted small mb-0">You have not applied for any jobs yet.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var application in appliedJobs.Take(3))
                                {
                                    <div class="d-flex justify-content-between align-items-center @(application != appliedJobs.Take(3).Last() ? "border-bottom py-3" : "pt-2")">
                                        <div class="min-w-0">
                                            <span class="table-name text-truncate d-block">@application.Title</span>
                                            <span class="table-email">@application.CompanyName</span>
                                        </div>
                                        @if (application.Status == "Shortlisted")
                                        {
                                            <span class="status-pill status-pill-success flex-shrink-0 ms-2"><i class="fa-solid fa-circle"></i>@application.Status</span>
                                        }
                                        else if (application.Status == "Rejected")
                                        {
                                            <span class="status-pill status-pill-danger flex-shrink-0 ms-2"><i class="fa-solid fa-circle"></i>@application.Status</span>
                                        }
                                        else
                                        {
                                            <span class="status-pill status-pill-warning flex-shrink-0 ms-2"><i class="fa-solid fa-clock"></i>@application.Status</span>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Event Activity -->
                <div class="col-lg-4">
                    <div class="content-card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center pt-4 pb-3 px-4">
                            <h6 class="fw-bold mb-0">
                                <i class="fa-solid fa-chart-simple me-2" style="color:var(--brand-blue);"></i>My Event Activity
                            </h6>
                            <a asp-controller="Student" asp-action="Event" class="small text-decoration-none" style="color:var(--brand-blue);">Browse</a>
                        </div>
                        <div class="card-body p-4">
                            @if (activityTotal == 0)
                            {
                                <div class="text-center py-3">
                                    <i class="fa-solid fa-calendar-days mb-2" style="font-size:1.5rem;color:var(--border);"></i>
                                    <p class="text-muted small mb-3">You haven't registered for any events yet.</p>
                                    <a asp-controller="Student" asp-action="Event" class="btn btn-academic btn-sm">
                                        <i class="fa-solid fa-magnifying-glass me-1"></i>Explore events
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-end justify-content-between mb-3">
                                    <div>
                                        <span class="display-6 fw-bold" style="color:var(--text-primary);">@activityTotal</span>
                                        <span class="d-block" style="color:var(--text-muted);font-size:0.8rem;">registrations</span>
                                    </div>
                                    <div class="text-end">
                                        <span class="status-pill status-pill-success"><i class="fa-solid fa-circle"></i>@completedEvents.Count completed</span>
                                        <span class="status-pill status-pill-info mt-1"><i class="fa-solid fa-circle"></i>@upcomingEvents.Count upcoming</span>
                                    </div>
                                </div>
                                <div class="progress mb-2" style="height:8px;border-radius:999px;">
                                    <div class="progress-bar rounded-pill" role="progressbar" style="width:@activityPercent%;background:var(--success);border-radius:999px;" aria-valuenow="@activityPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <div class="small fw-semibold" style="color:var(--text-muted);">@activityPercent% completed</div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Upcoming Events -->
                <div class="col-lg-4">
                    <div class="content-card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center pt-4 pb-3 px-4">
                            <h6 class="fw-bold mb-0">
                                <i class="fa-solid fa-clock-rotate-left me-2" style="color:var(--brand-blue);"></i>My Upcoming Events
                            </h6>
                            <a asp-controller="Student" asp-action="Event" class="small text-decoration-none" style="color:var(--brand-blue);">View All</a>
                        </div>
                        <div class="card-body p-4">
                            @if (upcomingEvents.Count == 0)
                            {
                                <div class="text-center py-3">
                                    <i class="fa-solid fa-calendar-xmark mb-2" style="font-size:1.5rem;color:var(--border);"></i>
                                    <p class="text-muted small mb-0">No upcoming events. Explore the event directory to register.</p>
                                </div>
                            }
                            else
                            {
                                var shownEvents = upcomingEvents.Take(3).ToList();
                                for (int i = 0; i < shownEvents.Count; i++)
                                {
                                    var evt = shownEvents[i];
                                    <div class="d-flex align-items-center @(i < shownEvents.Count - 1 ? "mb-3 pb-3 border-bottom" : "")">
                                        <div class="text-center p-2 me-3" style="width:56px;border-radius:10px;background:var(--brand-blue-soft);">
                                            <span class="d-block fw-bold" style="color:var(--brand-blue);font-size:1.1rem;">@evt.EventDate.Day</span>
                                            <span class="d-block text-uppercase" style="font-size:0.65rem;color:var(--text-muted);font-weight:700;">@evt.EventDate.ToString("MMM")</span>
                                        </div>
                                        <div class="min-w-0">
                                            <span class="table-name text-truncate d-block" title="@evt.EventTitle">@evt.EventTitle</span>
                                            <span class="table-email">
                                                @if (string.Equals(evt.EventMode, "Online", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <i class="fa-solid fa-video me-1" style="font-size:0.65rem;"></i><text>Online</text>
                                                }
                                                else
                                                {
                                                    <i class="fa-solid fa-location-dot me-1" style="font-size:0.65rem;"></i>@(string.IsNullOrWhiteSpace(evt.Location) ? "Onsite" : evt.Location)
                                                }
                                            </span>
                                        </div>
                                    </div>
                                }
                                if (upcomingEvents.Count > 3)
                                {
                                    <a asp-controller="Student" asp-action="Event" class="small mt-2 d-inline-block" style="color:var(--brand-blue);">+@(upcomingEvents.Count - 3) more upcoming</a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
