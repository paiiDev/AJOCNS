@model AJOCNS.Shared.DTOs.Jobs.JobPostDto
@{ ViewData["Title"] = Model.Title; }
<div class="container py-5"><div class="card shadow-sm"><div class="card-body"><h1>@Model.Title</h1><p class="text-muted">@Model.CompanyName · @Model.JobType · @Model.Location</p><h5>Description</h5><p style="white-space:pre-line">@Model.Description</p><h5>Requirements</h5><p style="white-space:pre-line">@Model.Requirements</p>@if (string.Equals(Model.PostedByRole, "ExternalPartner", StringComparison.OrdinalIgnoreCase)){<button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#applyJobModal">Apply now</button>}else{<span class="badge text-bg-secondary">Applications are not available for this post</span>}</div></div></div>
@if (string.Equals(Model.PostedByRole, "ExternalPartner", StringComparison.OrdinalIgnoreCase)){@await Html.PartialAsync("_ApplyJobModal", Model)}
