@model AJOCNS.Shared.DTOs.Jobs.JobPostDto
<div class="modal fade" id="applyJobModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form asp-controller="Student" asp-action="ApplyJob" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="hidden" name="JobPostId" value="@Model.Id" /><div class="modal-header"><h5>Apply for @Model.Title</h5></div><div class="modal-body"><label class="form-label">Cover letter</label><textarea name="CoverLetter" maxlength="1000" required class="form-control" rows="6"></textarea><label class="form-label mt-3">CV (PDF)</label><input name="Resume" type="file" accept=".pdf,application/pdf" required class="form-control" /></div><div class="modal-footer"><button type="submit" class="btn btn-primary">Submit application</button></div></form></div></div></div>
