@model AJOCNS.Shared.DTOs.Jobs.JobPostDto

<style>
    .job-modal-hero {
        position: relative;
        min-height: 200px;
        border-radius: 0;
        background: linear-gradient(135deg, var(--academic-blue-deep), var(--academic-blue));
        overflow: hidden;
        padding: 2rem 2.25rem 1.5rem;
    }
    .job-modal-hero-icon {
        position: absolute;
        right: -20px;
        bottom: -20px;
        font-size: 150px;
        color: rgba(255,255,255,.12);
    }
    .job-modal-close {
        position: absolute;
        top: 14px;
        right: 16px;
        z-index: 3;
        background: rgba(255,255,255,.25);
        border-radius: 50%;
        padding: .5rem;
        color: #fff;
    }
    .job-modal-close:hover { background: rgba(255,255,255,.4); }
    .job-modal-badge {
        background: rgba(255,255,255,.92);
        color: var(--academic-blue-deep);
        font-weight: 600;
        padding: .45em .9em;
        border-radius: 50rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.15);
    }
    .job-modal-title { font-size: 1.6rem; margin-bottom: .1rem; text-shadow: 0 2px 6px rgba(0,0,0,.3); }
    .job-modal-company { font-size: .95rem; opacity: .95; }
    .job-modal-body { padding: 1.5rem 1.75rem; }
    .job-modal-fact {
        display: flex;
        align-items: center;
        gap: .8rem;
        background: #f6f8fb;
        border: 1px solid #eef2f6;
        border-radius: .75rem;
        padding: .8rem 1rem;
        height: 100%;
    }
    .job-modal-fact-icon {
        width: 42px;
        height: 42px;
        border-radius: .6rem;
        background: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 6px rgba(24,56,92,.08);
        flex-shrink: 0;
    }
    .job-modal-fact-label {
        display: block;
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #8a94a6;
        font-weight: 600;
    }
    .job-modal-fact-value {
        display: block;
        font-weight: 600;
        color: #15253a;
        font-size: .95rem;
        word-break: break-word;
    }
    .job-modal-section-title {
        font-weight: 700;
        color: #15253a;
        margin-bottom: .5rem;
    }
    .job-modal-desc {
        color: #5a6473;
        line-height: 1.7;
        white-space: pre-line;
        font-size: .95rem;
    }
    .job-modal-req {
        background: #f6f8fb;
        border: 1px solid #eef2f6;
        border-radius: .75rem;
        padding: 1rem 1.25rem;
        color: #5a6473;
        line-height: 1.7;
        white-space: pre-line;
        font-size: .95rem;
    }
</style>

<div class="job-modal-hero">
    <i class="fa-solid fa-briefcase job-modal-hero-icon"></i>

    <button type="button" class="btn-close job-modal-close" data-bs-dismiss="modal" aria-label="Close"></button>

    <div class="d-flex flex-wrap gap-2 mb-3">
        <span class="badge job-modal-badge"><i class="fa-solid fa-tag me-1"></i>@(Model.JobType ?? "General")</span>
        <span class="badge text-bg-success"><i class="fa-solid fa-check-circle me-1"></i>Open for applications</span>
    </div>
    <h3 class="job-modal-title fw-bold text-white">@Model.Title</h3>
    <p class="job-modal-company text-white mb-0"><i class="fa-solid fa-building me-1"></i>@Model.CompanyName</p>
</div>

<div class="job-modal-body">
    <div class="row g-2 mb-4">
        <div class="col-sm-6 col-md-4">
            <div class="job-modal-fact">
                <div class="job-modal-fact-icon text-success"><i class="fa-solid fa-money-bill-wave"></i></div>
                <div>
                    <span class="job-modal-fact-label">Salary</span>
                    <span class="job-modal-fact-value">@(string.IsNullOrEmpty(Model.SalaryRange) ? "-" : Model.SalaryRange)</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4">
            <div class="job-modal-fact">
                <div class="job-modal-fact-icon text-danger"><i class="fa-solid fa-location-dot"></i></div>
                <div>
                    <span class="job-modal-fact-label">Location</span>
                    <span class="job-modal-fact-value">@(string.IsNullOrEmpty(Model.Location) ? "-" : Model.Location)</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4">
            <div class="job-modal-fact">
                <div class="job-modal-fact-icon text-primary"><i class="fa-solid fa-briefcase"></i></div>
                <div>
                    <span class="job-modal-fact-label">Job Type</span>
                    <span class="job-modal-fact-value">@(Model.JobType ?? "-")</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4">
            <div class="job-modal-fact">
                <div class="job-modal-fact-icon text-warning"><i class="fa-regular fa-calendar-check"></i></div>
                <div>
                    <span class="job-modal-fact-label">Apply By</span>
                    <span class="job-modal-fact-value">@Model.ClosingDate.ToString("dd MMM yyyy")</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4">
            <div class="job-modal-fact">
                <div class="job-modal-fact-icon text-primary"><i class="fa-regular fa-clock"></i></div>
                <div>
                    <span class="job-modal-fact-label">Posted On</span>
                    <span class="job-modal-fact-value">@Model.PostedDate.ToString("dd MMM yyyy")</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4">
            <div class="job-modal-fact">
                <div class="job-modal-fact-icon text-secondary"><i class="fa-solid fa-user-tie"></i></div>
                <div>
                    <span class="job-modal-fact-label">Posted By</span>
                    <span class="job-modal-fact-value">@(Model.PostedByName ?? "AJCONS")</span>
                </div>
            </div>
        </div>
    </div>

    <h6 class="job-modal-section-title"><i class="fa-solid fa-circle-info me-2"></i>About This Job</h6>
    <p class="job-modal-desc mb-4">
        @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided for this job." : Model.Description)
    </p>

    <h6 class="job-modal-section-title"><i class="fa-solid fa-list-check me-2"></i>Requirements</h6>
    @if (string.IsNullOrWhiteSpace(Model.Requirements))
    {
        <p class="job-modal-desc mb-0 text-muted">No specific requirements listed.</p>
    }
    else
    {
        <div class="job-modal-req">@Model.Requirements</div>
    }
</div>

<div class="modal-footer bg-light border-top-0 rounded-bottom-4">
    <button type="button" class="btn btn-outline-secondary px-4 fw-semibold" data-bs-dismiss="modal">Close</button>
</div>