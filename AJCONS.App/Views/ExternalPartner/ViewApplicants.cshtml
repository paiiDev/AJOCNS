@model List<AJOCNS.Shared.DTOs.Jobs.ApplicantListDto>
@{ ViewData["Title"] = "Job Applicants"; }
<div class="container py-5"><h1>Job applicants</h1><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Applied</th><th>Cover letter</th><th>Resume</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var applicant in Model){<tr><td>@applicant.StudentName<br /><small>@applicant.StudentEmail</small></td><td>@applicant.AppliedDate.ToString("dd MMM yyyy")</td><td>@applicant.CoverLetter</td><td><a href="@applicant.ResumeUrl" target="_blank">Download CV</a></td><td>@applicant.Status</td><td><form asp-action="UpdateApplicantStatus" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="applicationId" value="@applicant.ApplicationId" /><input type="hidden" name="jobPostId" value="@Context.Request.Query["jobPostId"]" /><select name="status" class="form-select form-select-sm"><option>Shortlisted</option><option>Rejected</option><option>Pending</option></select><button class="btn btn-sm btn-primary">Save</button></form></td></tr>}</tbody></table></div></div>
