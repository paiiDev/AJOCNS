@{
    ViewData["Title"] = "Partner Jobs | AJCONS";
}
<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="text-uppercase fw-bold small text-academic mb-1" style="letter-spacing:.08em">
                        External partner portal
                    </div>
                    <h1 class="h2 fw-bold mb-1">Job opportunities</h1>
                    <p class="text-muted mb-0">Roles your company offers to PUPL graduates.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">
            <div class="card border-0 rounded-4 shadow-sm bg-white">
                <div class="card-body p-4">
                    <p class="text-muted mb-0">
                        <i class="fa-solid fa-circle-info text-academic me-2"></i>
                        The job posting panel for partners is being prepared. Check back soon to add
                        and manage your company's opportunities.
                    </p>
                </div>
            </div>
        </div>
    </section>
</div>