@model List<AJOCNS.Shared.DTOs.Jobs.JobPostDto>
@{ ViewData["Title"] = "My Job Posts"; }
<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="page-header-label">Partner Workspace</div>
                    <h1 class="page-header-title">Job Post Management</h1>
                    <p class="page-header-sub">Create, manage, and review applicants for your company roles.</p>
                </div>
                <a asp-controller="Job" asp-action="CreateJobPost" class="btn btn-academic">
                    <i class="fa-solid fa-plus me-2"></i>Post a job
                </a>
            </div>
        </div>
    </section>

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">
            <!-- Stat Cards -->
            <div class="row g-3 mb-4">
                <div class="col-sm-4">
                    <div class="stat-card">
                        <div class="stat-card-body">
                            <div>
                                <div class="stat-card-num">@Model.Count</div>
                                <div class="stat-card-label">Total posts</div>
                            </div>
                            <div class="stat-card-icon stat-icon-blue">
                                <i class="fa-solid fa-briefcase"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="stat-card">
                        <div class="stat-card-body">
                            <div>
                                <div class="stat-card-num" style="color:var(--success);">@Model.Count(x => x.Status == "Open")</div>
                                <div class="stat-card-label">Open posts</div>
                            </div>
                            <div class="stat-card-icon stat-icon-green">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="stat-card">
                        <div class="stat-card-body">
                            <div>
                                <div class="stat-card-num" style="color:var(--warning);">@Model.Count(x => x.Status == "Pending")</div>
                                <div class="stat-card-label">Pending approval</div>
                            </div>
                            <div class="stat-card-icon stat-icon-amber">
                                <i class="fa-solid fa-clock"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Job Posts Table -->
            <div class="adminlte-card">
                <div class="card-header d-flex align-items-center gap-3 py-3">
                    <h3 class="card-title fw-bold mb-0">
                        <i class="fa-solid fa-briefcase me-2"></i>All job posts
                    </h3>
                    <span class="status-pill status-pill-info flex-shrink-0 ms-auto">
                        <i class="fa-solid fa-list"></i>@Model.Count total
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Position</th>
                                <th>Status</th>
                                <th>Closing date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="4">
                                        <div class="table-empty">
                                            <div class="empty-icon" style="background:var(--brand-blue-soft);color:var(--brand-blue);">
                                                <i class="fa-solid fa-briefcase"></i>
                                            </div>
                                            <h4>No job posts yet</h4>
                                            <p>Create your first opportunity to start receiving applications.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var job in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="table-name">@job.Title</span>
                                            <span class="table-email">@job.CompanyName · @(job.Location ?? "Remote")</span>
                                        </td>
                                        <td>
                                            @if (job.Status == "Open")
                                            {
                                                <span class="status-pill status-pill-success"><i class="fa-solid fa-circle"></i>Open</span>
                                            }
                                            else if (job.Status == "Rejected")
                                            {
                                                <span class="status-pill status-pill-danger"><i class="fa-solid fa-circle"></i>Rejected</span>
                                            }
                                            else if (job.Status == "Pending")
                                            {
                                                <span class="status-pill status-pill-warning"><i class="fa-solid fa-clock"></i>Pending</span>
                                            }
                                            else
                                            {
                                                <span class="status-pill status-pill-muted"><i class="fa-solid fa-circle"></i>@job.Status</span>
                                            }
                                        </td>
                                        <td class="table-detail">@job.ClosingDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <div class="table-actions">
                                                @if (job.Status == "Rejected")
                                                {
                                                    <form asp-controller="Job" asp-action="DeleteJobPost" asp-route-id="@job.Id" method="post" class="d-inline confirm-delete" data-job-title="@job.Title">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="fa-solid fa-trash-can me-1"></i>Delete
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <a asp-action="ViewApplicants" asp-route-jobPostId="@job.Id"
                                                       class="btn btn-sm btn-outline-primary">
                                                        <i class="fa-solid fa-users me-1"></i>Applicants
                                                    </a>
                                                    <a asp-controller="Job" asp-action="EditJobPost" asp-route-id="@job.Id"
                                                       class="btn btn-sm btn-outline-secondary">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.confirm-delete').forEach(form => {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    const title = this.getAttribute('data-job-title') || 'this job post';
                    const formEl = this;

                    Swal.fire({
                        title: 'Delete job post?',
                        text: `"${title}" will be permanently deleted. This cannot be undone.`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Yes, delete',
                        cancelButtonText: 'Cancel'
                    }).then(result => {
                        if (result.isConfirmed) {
                            formEl.submit();
                        }
                    });
                });
            });
        });
    </script>
}
