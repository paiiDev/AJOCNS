@model List<AJOCNS.Shared.DTOs.Jobs.JobPostDto>
@{ ViewData["Title"] = "My Job Posts"; }
<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div><div class="text-uppercase small fw-bold text-primary mb-1">Partner workspace</div><h1 class="fw-bold mb-1">Job post management</h1><p class="text-muted mb-0">Create, manage, and review applicants for your company roles.</p></div>
        <a asp-controller="Job" asp-action="CreateJobPost" class="btn btn-primary rounded-pill px-4"><i class="fa-solid fa-plus me-2"></i>Post a job</a>
    </div>
    <div class="row g-3 mb-4"><div class="col-sm-4"><div class="card border-0 shadow-sm rounded-4"><div class="card-body"><small class="text-muted">Total posts</small><h3 class="fw-bold mb-0">@Model.Count</h3></div></div></div><div class="col-sm-4"><div class="card border-0 shadow-sm rounded-4"><div class="card-body"><small class="text-muted">Open posts</small><h3 class="fw-bold text-success mb-0">@Model.Count(x => x.Status == "Open")</h3></div></div></div><div class="col-sm-4"><div class="card border-0 shadow-sm rounded-4"><div class="card-body"><small class="text-muted">Pending approval</small><h3 class="fw-bold text-warning mb-0">@Model.Count(x => x.Status == "Pending")</h3></div></div></div></div>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">Position</th><th>Status</th><th>Closing date</th><th class="text-end pe-4">Actions</th></tr></thead><tbody>
    @if (!Model.Any()) { <tr><td colspan="4" class="text-center py-5 text-muted">No job posts yet. Create your first opportunity.</td></tr> }
    @foreach (var job in Model) { <tr><td class="ps-4"><div class="fw-semibold">@job.Title</div><small class="text-muted">@job.CompanyName · @(job.Location ?? "Remote")</small></td><td><span class="badge rounded-pill @(job.Status == "Open" ? "text-bg-success" : job.Status == "Rejected" ? "text-bg-danger" : "text-bg-warning")">@job.Status</span></td><td>@job.ClosingDate.ToString("dd MMM yyyy")</td><td class="text-end pe-4"><a asp-action="ViewApplicants" asp-route-jobPostId="@job.Id" class="btn btn-sm btn-outline-primary rounded-pill me-1"><i class="fa-solid fa-users me-1"></i>Applicants</a><a asp-controller="Job" asp-action="EditJobPost" asp-route-id="@job.Id" class="btn btn-sm btn-outline-secondary rounded-pill"><i class="fa-solid fa-pen"></i></a></td></tr> }
    </tbody></table></div></div>
</div>
