@{
    ViewData["Title"] = "External Partner | AJCONS";
}
<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="page-header-label">External Partner Portal</div>
                    <h1 class="page-header-title">Partner Dashboard</h1>
                    <p class="page-header-sub">Welcome back, @User.Identity?.Name. Thank you for partnering with PUPL.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="content-card h-100">
                        <div class="card-body p-4 p-lg-5">
                            <span class="badge badge-primary mb-3 px-3 py-2">
                                <i class="fa-solid fa-building me-2"></i>Your partner hub
                            </span>
                            <h2 class="fw-bold mb-3" style="color:var(--text-primary);">Connect with future talent</h2>
                            <p class="mb-0" style="color:var(--text-secondary);line-height:1.8;">
                                As an external partner you can post job opportunities and events for PUPL
                                graduates. Create an event or job post and it will go live once an admin approves it.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 d-flex flex-column gap-4">
                    <div class="content-card h-100 position-relative overflow-hidden"
                         style="background: linear-gradient(135deg, var(--brand-navy) 0%, var(--brand-navy-light, #122b59) 100%);">
                        <div class="card-body p-4 p-lg-5 text-white position-relative">
                            <i class="fa-solid fa-calendar-days position-absolute opacity-10" style="font-size:120px; right:-20px; bottom:-20px;"></i>
                            <span class="badge" style="background:rgba(255,255,255,0.2);color:#fff;" class="mb-3 px-3 py-2">Quick link</span>
                            <h4 class="fw-bold mb-2">Events</h4>
                            <p class="text-white-50 mb-4">
                                Manage and review the events your company offers to students.
                            </p>
                            <a asp-controller="ExternalPartner" asp-action="Events"
                               class="btn btn-light fw-bold px-4 py-2 rounded-pill shadow-sm" style="color:var(--brand-blue);">
                                <i class="fa-solid fa-calendar-days me-2"></i>View events
                            </a>
                        </div>
                    </div>
                    <div class="content-card h-100 position-relative overflow-hidden"
                         style="background: linear-gradient(135deg, #14402a 0%, #1b5e3d 100%);">
                        <div class="card-body p-4 p-lg-5 text-white position-relative">
                            <i class="fa-solid fa-briefcase position-absolute opacity-10" style="font-size:120px; right:-20px; bottom:-20px;"></i>
                            <span class="badge" style="background:rgba(255,255,255,0.2);color:#fff;" class="mb-3 px-3 py-2">Quick link</span>
                            <h4 class="fw-bold mb-2">Job opportunities</h4>
                            <p class="text-white-50 mb-4">
                                Manage and review the roles your company offers to graduates.
                            </p>
                            <a asp-controller="ExternalPartner" asp-action="Jobs"
                               class="btn btn-light fw-bold px-4 py-2 rounded-pill shadow-sm" style="color:#16a34a;">
                                <i class="fa-solid fa-briefcase me-2"></i>View jobs
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
