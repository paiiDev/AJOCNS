@using AJOCNS.Shared.DTOs.Events
@using AJOCNS.Shared.DTOs.Jobs
@{
    ViewData["Title"] = "Post Approvals | AJCONS";
    var pendingEvents = ViewBag.PendingEvents as List<EventDto> ?? new List<EventDto>();
    var pendingJobs = ViewBag.PendingJobs as List<JobPostDto> ?? new List<JobPostDto>();
    var totalPending = pendingEvents.Count + pendingJobs.Count;
}
<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="text-uppercase fw-bold small text-academic mb-1" style="letter-spacing:.08em">
                        Content administration
                    </div>
                    <h1 class="h2 fw-bold mb-1">Event &amp; job post approvals</h1>
                    <p class="text-muted mb-0">Review events and job posts submitted by mentors and external partners.</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Index" asp-controller="Admin" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-gauge-high me-2"></i>Dashboard
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">
            <div class="card adminlte-card mb-4">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3 py-3">
                    <h3 class="card-title fw-bold mb-0"><i class="fa-solid fa-calendar-days me-2"></i>Pending events</h3>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="fa-solid fa-search text-muted"></i></span>
                            <input type="search" id="eventSearch" class="form-control" placeholder="Search events..." aria-label="Search pending events" />
                        </div>
                        <span class="badge rounded-pill text-bg-warning">@pendingEvents.Count waiting</span>
                    </div>
                </div>
                <div class="table-responsive">
                    @if (pendingEvents.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa-solid fa-inbox fs-2 mb-3 d-block"></i>
                            No pending events waiting for approval.
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover mb-0 align-middle event-table" style="min-width:760px;">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Event</th>
                                    <th>Type</th>
                                    <th>Date &amp; Time</th>
                                    <th>Submitted by</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ev in pendingEvents)
                                {
                                    <tr>
                                        <td class="ps-4"><strong>@ev.EventTitle</strong></td>
                                        <td>@ev.EventTypeName</td>
                                        <td>@ev.EventDate.ToString("dd MMM yyyy, HH:mm")</td>
                                        <td>@ev.CreatedByName</td>
                                        <td class="text-end pe-4">
                                                <div class="d-inline-flex gap-2">
                                                    <button type="button" class="btn btn-sm btn-outline-primary approval-details" data-url="@Url.Action("PendingEventDetails", "Admin", new { id = ev.Id })"><i class="fa-solid fa-eye me-1"></i>Details</button>
                                                <form asp-action="RejectEventPost" asp-controller="Admin" asp-route-id="@ev.Id" method="post" class="d-inline reject-form">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Reject @ev.EventTitle">
                                                        <i class="fa-solid fa-xmark me-1"></i>Reject
                                                    </button>
                                                </form>
                                                <form asp-action="ApproveEventPost" asp-controller="Admin" asp-route-id="@ev.Id" method="post" class="d-inline approve-form">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success" title="Approve @ev.EventTitle">
                                                        <i class="fa-solid fa-check me-1"></i>Approve
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div id="eventNoResults" class="text-center py-5 text-muted d-none">No events match your search.</div>
                    }
                </div>
            </div>

            <div class="card adminlte-card">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3 py-3">
                    <h3 class="card-title fw-bold mb-0"><i class="fa-solid fa-briefcase me-2"></i>Pending job posts</h3>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="fa-solid fa-search text-muted"></i></span>
                            <input type="search" id="jobSearch" class="form-control" placeholder="Search job posts..." aria-label="Search pending job posts" />
                        </div>
                        <span class="badge rounded-pill text-bg-warning">@pendingJobs.Count waiting</span>
                    </div>
                </div>
                <div class="table-responsive">
                    @if (pendingJobs.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa-solid fa-inbox fs-2 mb-3 d-block"></i>
                            No pending job posts waiting for approval.
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover mb-0 align-middle job-table" style="min-width:820px;">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Title</th>
                                    <th>Company</th>
                                    <th>Type</th>
                                    <th>Closing Date</th>
                                    <th>Submitted by</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in pendingJobs)
                                {
                                    <tr>
                                        <td class="ps-4"><strong>@job.Title</strong></td>
                                        <td>@job.CompanyName</td>
                                        <td>@(job.JobType ?? "-")</td>
                                        <td>@job.ClosingDate.ToString("dd MMM yyyy")</td>
                                        <td>@job.PostedByName</td>
                                        <td class="text-end pe-4">
                                                <div class="d-inline-flex gap-2">
                                                    <button type="button" class="btn btn-sm btn-outline-primary approval-details" data-url="@Url.Action("PendingJobDetails", "Admin", new { id = job.Id })"><i class="fa-solid fa-eye me-1"></i>Details</button>
                                                <form asp-action="RejectJobPost" asp-controller="Admin" asp-route-id="@job.Id" method="post" class="d-inline reject-form">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Reject @job.Title">
                                                        <i class="fa-solid fa-xmark me-1"></i>Reject
                                                    </button>
                                                </form>
                                                <form asp-action="ApproveJobPost" asp-controller="Admin" asp-route-id="@job.Id" method="post" class="d-inline approve-form">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success" title="Approve @job.Title">
                                                        <i class="fa-solid fa-check me-1"></i>Approve
                                                    </button>
                                                </form>
                                            </div>

                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div id="jobNoResults" class="text-center py-5 text-muted d-none">No job posts match your search.</div>
                    }
                </div>

<div class="modal fade" id="approvalDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="approvalDetailsContent">
            <div class="text-center p-5"><div class="spinner-border text-primary"></div></div>
        </div>
    </div>
</div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const setupSearch = (inputId, tableClass, emptyId) => {
                const input = document.getElementById(inputId);
                const rows = [...document.querySelectorAll(`.${tableClass} tbody tr`)];
                const empty = document.getElementById(emptyId);
                input?.addEventListener('input', () => {
                    const term = input.value.trim().toLowerCase();
                    let visible = 0;
                    rows.forEach(row => {
                        const matches = row.innerText.toLowerCase().includes(term);
                        row.classList.toggle('d-none', !matches);
                        if (matches) visible++;
                    });

                    empty?.classList.toggle('d-none', visible !== 0);
                });
            };
            setupSearch('eventSearch', 'event-table', 'eventNoResults');
            setupSearch('jobSearch', 'job-table', 'jobNoResults');

            document.querySelectorAll('.approval-details').forEach(button => {
                button.addEventListener('click', async () => {
                    const content = document.getElementById('approvalDetailsContent');
                    content.innerHTML = '<div class="text-center p-5"><div class="spinner-border text-primary"></div></div>';
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('approvalDetailsModal')).show();
                    try {
                        const response = await fetch(button.dataset.url);
                        content.innerHTML = response.ok ? await response.text() : '<div class="alert alert-danger m-4">Details could not be loaded.</div>';
                    } catch {
                        content.innerHTML = '<div class="alert alert-danger m-4">Details could not be loaded.</div>';
                    }
                });
            });

            document.querySelectorAll('.approve-form').forEach(form => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    const title = form.querySelector('button[type="submit"]').getAttribute('title') || 'item';
                    const result = await Swal.fire({
                        title: 'Approve this post?',
                        text: `${title} will become visible after approval.`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, approve',
                        cancelButtonText: 'Cancel'
                    });
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });

            document.querySelectorAll('.reject-form').forEach(form => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    const title = form.querySelector('button[type="submit"]').getAttribute('title') || 'item';
                    const result = await Swal.fire({
                        title: 'Reject this post?',
                        text: `${title} will be marked as rejected.`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, reject',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#dc3545'
                    });
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}