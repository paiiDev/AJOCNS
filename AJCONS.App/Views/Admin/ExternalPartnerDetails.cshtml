@model AJOCNS.Shared.DTOs.Auth.ExternalPartnerAdminDto
@{
    ViewData["Title"] = "External Partner Details | AJCONS";
    var isPending = ViewBag.IsPending as bool? ?? true;
    var returnAction = ViewBag.ReturnAction as string;
    var backAction = returnAction == "ExternalPartners" ? "ExternalPartners" : "UserApprovals";
}
<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="text-uppercase fw-bold small text-academic mb-1" style="letter-spacing:.08em">Account administration</div>
                    <h1 class="h2 fw-bold mb-1">External partner details</h1>
                    <p class="text-muted mb-0">@(isPending ? "Review the submitted information before approving this registration." : "View the full profile information for this external partner.")</p>
                </div>
                <a asp-action="@backAction" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-2"></i>Back to @(isPending ? "approvals" : "partners")
                </a>
            </div>
        </div>
    </section>

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card adminlte-card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center py-3">
                            <h3 class="card-title fw-bold mb-0">Account information</h3>
                            <span class="badge rounded-pill @(Model.Status == "Active" ? "text-bg-success" : Model.Status == "Pending" ? "text-bg-warning" : "text-bg-secondary")">@Model.Status</span>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Full name</small>
                                    <strong>@Model.Name</strong>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Email address</small>
                                    <strong>@Model.Email</strong>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Company</small>
                                    <strong>@Model.CompanyName</strong>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Position</small>
                                    <strong>@Model.PositionName</strong>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Phone</small>
                                    <strong>@(string.IsNullOrWhiteSpace(Model.Phone) ? "Not provided" : Model.Phone)</strong>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Submitted</small>
                                    <strong>@Model.CreatedAt.ToString("d MMM yyyy, hh:mm tt")</strong>
                                </div>
                                <div class="col-12">
                                    <small class="text-muted d-block">Area of expertise</small>
                                    <strong>@(string.IsNullOrWhiteSpace(Model.Expertise) ? "Not provided" : Model.Expertise)</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card adminlte-card h-100">
                        <div class="card-header py-3">
                            <h3 class="card-title fw-bold mb-0">@(isPending ? "Review decision" : "Account status")</h3>
                        </div>
                        <div class="card-body p-4">
                            @if (isPending)
                            {
                                <p class="text-muted">Confirm that the submitted partner and company information is appropriate before granting access.</p>
                                <div class="d-grid gap-2 mt-4">
                                    <form asp-action="ApproveUser" asp-controller="Admin" method="post" class="approve-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@Model.UserId" />
                                        <button type="submit" class="btn btn-success w-100">
                                            <i class="fa-solid fa-check me-2"></i>Approve partner
                                        </button>
                                    </form>
                                    <form asp-action="RejectUser" asp-controller="Admin" method="post" class="reject-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@Model.UserId" />
                                        <button type="submit" class="btn btn-outline-danger w-100">
                                            <i class="fa-solid fa-xmark me-2"></i>Reject registration
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">Manage this partner's access to the platform.</p>
                                <div class="d-grid gap-2 mt-4">
                                    @if (Model.Status == "Active")
                                    {
                                        <form asp-action="UpdateExternalPartnerStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@Model.UserId" />
                                            <input type="hidden" name="status" value="Inactive" />
                                            <button type="submit" class="btn btn-outline-danger w-100">
                                                <i class="fa-solid fa-user-slash me-2"></i>Deactivate account
                                            </button>
                                        </form>
                                    }
                                    else if (Model.Status == "Inactive")
                                    {
                                        <form asp-action="UpdateExternalPartnerStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@Model.UserId" />
                                            <input type="hidden" name="status" value="Active" />
                                            <button type="submit" class="btn btn-success w-100">
                                                <i class="fa-solid fa-user-check me-2"></i>Activate account
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.approve-form').forEach(form => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    const result = await Swal.fire({
                        title: 'Approve this external partner?',
                        text: 'They will be able to log in immediately after approval.',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, approve',
                        cancelButtonText: 'Cancel'
                    });
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });

            document.querySelectorAll('.reject-form').forEach(form => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    const result = await Swal.fire({
                        title: 'Reject this registration?',
                        text: 'Their account will be rejected and they cannot log in.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, reject',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#dc3545'
                    });
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}
