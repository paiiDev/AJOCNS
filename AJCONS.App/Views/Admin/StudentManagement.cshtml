@using AJOCNS.Shared.DTOs.StudentRegistration
@model AJOCNS.Shared.DTOs.StudentRegistration.PagedStudentDto
@{
    ViewData["Title"] = "Student Management | AJCONS";
    var selectedMajorId = ViewBag.SelectedMajorId as int?;
    var selectedAcyId = ViewBag.SelectedAcyId as int?;
    var isGradMode = Context.Request.Query["gradMode"] == "true";
    var gradYearParam = Context.Request.Query["gradYear"].ToString();
    var statusStats = ViewBag.StudentStatusStats as StudentStatusStatsDto;
    var majorCount = ViewBag.Majors != null && ViewBag.Majors.IsSuccess ? ViewBag.Majors.Data.Count : 0;
    var acyCount = ViewBag.AcademicYears != null && ViewBag.AcademicYears.IsSuccess ? ViewBag.AcademicYears.Data.Count : 0;
}
<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="text-uppercase fw-bold small text-academic mb-1" style="letter-spacing:.08em">
                        Academic administration
                    </div>
                    <h1 class="h2 fw-bold mb-1">Student management</h1>
                    <p class="text-muted mb-0">@Model.TotalCount registered student record(s).</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="GraduationRecords" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-scroll me-2"></i>Graduation Records
                    </a>
                    <button type="button" id="bulkToggleBtn" class="btn btn-outline-primary">
                        <i class="fa-solid fa-layer-group me-2"></i>Bulk Major Update
                    </button>
                    <button type="button" id="gradToggleBtn" class="btn btn-outline-warning">
                        <i class="fa-solid fa-graduation-cap me-2"></i>Manage Graduation
                    </button>
                    <button type="button" id="saveAllBtn" class="btn btn-success d-none">
                        <i class="fa-solid fa-floppy-disk me-2"></i>Save All
                    </button>
                    <a asp-action="RegisterNewStudent" class="btn btn-academic">
                        <i class="fa-solid fa-user-plus me-2"></i>
                        Add new student
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4 col-xxl">
                    <div class="small-box text-bg-primary mb-0 shadow-sm">
                        <div class="inner">
                            <h3>@(statusStats?.Total ?? Model.TotalCount)</h3>
                            <p>Registered students</p>
                        </div>
                        <div class="icon"><i class="fa-solid fa-user-graduate"></i></div>
                        <a asp-action="StudentManagement" class="small-box-footer">
                            View directory <i class="fa-solid fa-arrow-circle-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xxl">
                    <div class="small-box text-bg-success mb-0 shadow-sm">
                        <div class="inner">
                            <h3>@(statusStats?.Graduated ?? 0)</h3>
                            <p>Graduated</p>
                        </div>
                        <div class="icon"><i class="fa-solid fa-graduation-cap"></i></div>
                        <a asp-action="GraduationRecords" class="small-box-footer">
                            View records <i class="fa-solid fa-arrow-circle-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xxl">
                    <div class="small-box bg-info mb-0 shadow-sm">
                        <div class="inner">
                            <h3>@(statusStats?.Undergraduate ?? 0)</h3>
                            <p>In study</p>
                        </div>
                        <div class="icon"><i class="fa-solid fa-book-open-reader"></i></div>
                        <a href="#" class="small-box-footer">Undergraduate cohort <i class="fa-solid fa-arrow-circle-right"></i></a>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xxl">
                    <div class="small-box bg-secondary mb-0 shadow-sm">
                        <div class="inner">
                            <h3>@(statusStats?.Dropout ?? 0)</h3>
                            <p>Dropout</p>
                        </div>
                        <div class="icon"><i class="fa-solid fa-user-xmark"></i></div>
                        <a asp-action="StudentManagement" asp-route-excludeDropout="false" class="small-box-footer">
                            Manage records <i class="fa-solid fa-arrow-circle-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xxl">
                    <div class="small-box bg-warning mb-0 shadow-sm">
                        <div class="inner">
                            <h3>@majorCount</h3>
                            <p>Majors &amp; programme</p>
                        </div>
                        <div class="icon"><i class="fa-solid fa-layer-group"></i></div>
                        <a asp-action="StudentManagement" class="small-box-footer">
                            Filter by major <i class="fa-solid fa-arrow-circle-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xxl">
                    <div class="small-box bg-primary bg-opacity-75 mb-0 shadow-sm">
                        <div class="inner">
                            <h3>@acyCount</h3>
                            <p>Academic years</p>
                        </div>
                        <div class="icon"><i class="fa-solid fa-calendar-days"></i></div>
                        <a asp-action="StudentManagement" class="small-box-footer">
                            Filter by year <i class="fa-solid fa-arrow-circle-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <form method="get" id="filterForm" class="mb-3 d-flex flex-wrap gap-2 align-items-center">
                <label class="fw-semibold small text-muted mb-0"><i class="fa-solid fa-filter me-1"></i>Filter by major:</label>
                <select name="majorId" class="form-select form-select-sm" style="max-width:320px" onchange="this.form.submit()">
                    <option value="">All majors</option>
                    @if (ViewBag.Majors != null && ViewBag.Majors.IsSuccess)
                    {
                        foreach (var major in ViewBag.Majors.Data)
                        {
                            <option value="@major.Id" selected="@(selectedMajorId == major.Id)">@major.MajorName</option>
                        }
                    }
                </select>
                <label class="fw-semibold small text-muted mb-0 ms-2"><i class="fa-solid fa-calendar-days me-1"></i>Academic Year:</label>
                <select name="acyId" class="form-select form-select-sm" style="max-width:220px" onchange="this.form.submit()">
                    <option value="">All academic years</option>
                    @if (ViewBag.AcademicYears != null && ViewBag.AcademicYears.IsSuccess)
                    {
                        foreach (var acy in ViewBag.AcademicYears.Data)
                        {
                            <option value="@acy.AcyId" selected="@(selectedAcyId == acy.AcyId)">@acy.AcademicYear</option>
                        }
                    }
                </select>
                @if (selectedMajorId != null || selectedAcyId != null)
                {
                    <a asp-action="StudentManagement" class="btn btn-sm btn-outline-secondary">Clear</a>
                }
            </form>

            <div class="card adminlte-card">
                <div class="card-header py-3 d-flex flex-wrap gap-3 justify-content-between align-items-center">
                    <h3 class="card-title fw-bold mb-0">Student directory</h3>
                    <div class="input-group input-group-sm ms-auto" style="max-width:260px">
                        <span class="input-group-text bg-white">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span><input id="studentSearch" class="form-control" type="search"
                                      placeholder="Search students" aria-label="Search students" />
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="studentsTable">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">SRN</th>
                                <th>Name</th>
                                <th>Major</th>
                                <th>Academic Year</th>
                                <th>Phone</th>
                                <th>Father Name</th>
                                <th>Address</th>
                                <th>Graduation Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Students.Any())
                            {
                                foreach (var student in Model.Students)
                                {
                                    <tr>
                                        <td class="ps-4 text-muted fw-semibold">@student.Srn</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                               
                                                    <strong class="d-block">@student.Name</strong>
                                            </div>
                                        </td>
                                        <td>@student.Major</td>
                                        <td>@(student.AcademicYear ?? "-")</td>
                                        <td>
                                            @if (string.IsNullOrEmpty(student.Phone))
                                            {
                                                <span class="text-warning fst-italic">Not provided</span>
                                            }
                                            else
                                            {
                                                @student.Phone
                                            }
                                        </td>
                                        <td>
                                            @if (string.IsNullOrEmpty(student.FatherName))
                                            {
                                                <span class="text-warning fst-italic">Not provided</span>
                                            }
                                            else
                                            {
                                                @student.FatherName
                                            }
                                        </td>
                                        <td>
                                            @if (string.IsNullOrEmpty(student.Address))
                                            {
                                                <span class="text-warning fst-italic">Not provided</span>
                                            }
                                            else
                                            {
                                                @student.Address
                                            }
                                        </td>
                                        <td>
                                            @if (student.GraduationStatus == "Graduated")
                                            {
                                                <span class="badge text-bg-success">Graduated</span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background:#eaf4ff;color:#073d78">
                                                    @(student.GraduationStatus ?? "Undergraduate")
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end pe-4 action-cell">
                                            <div class="normal-actions">
                                                <a asp-action="EditStudent" asp-route-id="@student.StudentId" class="btn btn-sm btn-outline-primary"
                                                   aria-label="Edit @student.Name"><i class="fa-solid fa-pen"></i></a>
                                                <form asp-action="DeleteStudent" asp-route-id="@student.StudentId" method="post" class="d-inline delete-form">
                                                    @Html.AntiForgeryToken()
                                                    <button type="button" class="btn btn-sm btn-outline-danger ms-1 delete-btn"
                                                            aria-label="Delete @student.Name" data-name="@student.Name"><i class="fa-solid fa-trash"></i></button>
                                                </form>
                                            </div>
                                            <div class="bulk-actions d-none">
                                                <select class="form-select form-select-sm bulk-major-select" data-student-id="@student.StudentId" style="min-width:180px">
                                                    <option value="">-- Assign major --</option>
                                                    @if (ViewBag.Majors != null && ViewBag.Majors.IsSuccess)
                                                    {
                                                        foreach (var major in ViewBag.Majors.Data)
                                                        {
                                                            <option value="@major.Id" selected="@(major.Id == student.MajorId)">@major.MajorName</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="grad-actions d-none">
                                                @{
                                                    var currentStatus = student.GraduationStatus ?? "Undergraduate";
                                                    var knownStatuses = new List<string> { "Undergraduate", "Graduated" };
                                                }
                                                <select class="form-select form-select-sm bulk-grad-select" data-student-id="@student.StudentId" style="min-width:180px">
                                                    @if (knownStatuses.Contains(currentStatus))
                                                    {
                                                        <option value="Undergraduate" selected="@(currentStatus == "Undergraduate")">Undergraduate</option>
                                                        <option value="Graduated" selected="@(currentStatus == "Graduated")">Graduated</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="Undergraduate">Undergraduate</option>
                                                        <option value="@currentStatus" selected>@currentStatus</option>
                                                        <option value="Graduated">Graduated</option>
                                                    }
                                                </select>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-5 text-muted">
                                        <i class="fa-regular fa-folder-open fs-2 d-block mb-2"></i>No student records
                                        found. Add a student to begin.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-white py-3">
                        <nav aria-label="Student pagination">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                    <a class="page-link" asp-action="StudentManagement" asp-route-page="@(Model.CurrentPage - 1)" asp-route-majorId="@selectedMajorId" asp-route-acyId="@selectedAcyId" asp-route-gradMode="@(isGradMode ? "true" : null)" asp-route-gradYear="@(isGradMode ? gradYearParam : null)" asp-route-excludeDropout="@(isGradMode ? true : null)">Prev</a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="StudentManagement" asp-route-page="@i" asp-route-majorId="@selectedMajorId" asp-route-acyId="@selectedAcyId" asp-route-gradMode="@(isGradMode ? "true" : null)" asp-route-gradYear="@(isGradMode ? gradYearParam : null)" asp-route-excludeDropout="@(isGradMode ? true : null)">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                    <a class="page-link" asp-action="StudentManagement" asp-route-page="@(Model.CurrentPage + 1)" asp-route-majorId="@selectedMajorId" asp-route-acyId="@selectedAcyId" asp-route-gradMode="@(isGradMode ? "true" : null)" asp-route-gradYear="@(isGradMode ? gradYearParam : null)" asp-route-excludeDropout="@(isGradMode ? true : null)">Next</a>
                                </li>
                            </ul>
                        </nav>
                        <div class="text-center text-muted small mt-2">
                            Page @Model.CurrentPage of @Model.TotalPages — showing @Model.Students.Count of @Model.TotalCount students
                        </div>
                    </div>
                }

                <div class="card-footer bg-white text-muted small py-3">
                    Student records are managed through the academic administration system.
                </div>
            </div>
        </div>
    </section>
</div>

<form id="antiforgeryForm" class="d-none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        var bulkMode = false;
        var gradMode = false;
        var gradYearInput = '@Context.Request.Query["gradYear"]';
        var academicYears = [
            @if (ViewBag.AcademicYears != null && ViewBag.AcademicYears.IsSuccess)
            {
                foreach (var acy in ViewBag.AcademicYears.Data)
                {
                    @:{ id: @acy.AcyId, name: '@acy.AcademicYear' },
                }
            }
        ];

        function setBulkMode(enabled) {
            bulkMode = enabled;
            if (enabled) gradMode = false;
            applyMode();
        }

        function enterGradMode() {
            gradMode = true;
            bulkMode = false;
            applyMode();
        }

        function exitGradMode() {
            gradMode = false;
            applyMode();
        }

        function applyMode() {
            document.querySelectorAll('.normal-actions').forEach(function (el) {
                el.classList.toggle('d-none', bulkMode || gradMode);
            });
            document.querySelectorAll('.bulk-actions').forEach(function (el) {
                el.classList.toggle('d-none', !bulkMode);
            });
            document.querySelectorAll('.grad-actions').forEach(function (el) {
                el.classList.toggle('d-none', !gradMode);
            });

            var saveBtn = document.getElementById('saveAllBtn');
            saveBtn.classList.toggle('d-none', !bulkMode && !gradMode);
            saveBtn.innerHTML = gradMode
                ? '<i class="fa-solid fa-floppy-disk me-2"></i>Save Graduation Statuses'
                : '<i class="fa-solid fa-floppy-disk me-2"></i>Save All';

            var bulkBtn = document.getElementById('bulkToggleBtn');
            bulkBtn.innerHTML = bulkMode
                ? '<i class="fa-solid fa-xmark me-1"></i>Cancel Bulk Mode'
                : '<i class="fa-solid fa-layer-group me-1"></i>Bulk Major Update';
            bulkBtn.classList.toggle('btn-outline-primary', !bulkMode);
            bulkBtn.classList.toggle('btn-outline-secondary', bulkMode);

            var gradBtn = document.getElementById('gradToggleBtn');
            gradBtn.innerHTML = gradMode
                ? '<i class="fa-solid fa-xmark me-1"></i>Exit Graduation Mode'
                : '<i class="fa-solid fa-graduation-cap me-1"></i>Manage Graduation';
            gradBtn.classList.toggle('btn-outline-warning', !gradMode);
            gradBtn.classList.toggle('btn-outline-secondary', gradMode);
        }

        document.getElementById('studentSearch')?.addEventListener('input', function () {
            var term = this.value.toLowerCase();
            document.querySelectorAll('#studentsTable tbody tr').forEach(function (row) {
                row.style.display = row.innerText.toLowerCase().includes(term) ? '' : 'none';
            });
        });

        document.querySelectorAll('.delete-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var name = this.getAttribute('data-name');
                var form = this.closest('form');
                Swal.fire({
                    title: 'Delete student?',
                    text: 'Are you sure you want to delete "' + name + '"? This action cannot be undone.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });

        document.getElementById('bulkToggleBtn')?.addEventListener('click', function () {
            setBulkMode(!bulkMode);
        });

        document.getElementById('gradToggleBtn')?.addEventListener('click', function () {
            if (gradMode) {
                exitGradMode();
                return;
            }

            var optionsHtml = academicYears.map(function (y) {
                return '<option value="' + y.id + '">' + y.name + '</option>';
            }).join('');

            var currentYear = new Date().getFullYear();

            Swal.fire({
                title: 'Manage graduation',
                html:
                    '<label style="display:block;text-align:left;font-weight:600;font-size:.875rem;margin-bottom:.25rem">Academic Year (Enrollment Year)</label>' +
                    '<select id="swal-acy" class="swal2-input" style="display:flex;width:80%">' +
                    '<option value="">-- Select enrollment year --</option>' + optionsHtml + '</select>' +
                    '<label style="display:block;text-align:left;font-weight:600;font-size:.875rem;margin-bottom:.25rem">Graduation Year</label>' +
                    '<input id="swal-grad-year" type="number" class="swal2-input" placeholder="e.g. ' + currentYear + '" min="1900" max="2100" style="display:flex;width:80%">',
                showCancelButton: true,
                focusConfirm: false,
                confirmButtonColor: '#0b5cab',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Continue',
                cancelButtonText: 'Cancel',
                preConfirm: function () {
                    var acy = document.getElementById('swal-acy').value;
                    var gradYear = document.getElementById('swal-grad-year').value;
                    if (!acy) {
                        Swal.showValidationMessage('Please select an enrollment year.');
                        return false;
                    }
                    var year = parseInt(gradYear, 10);
                    if (!gradYear || isNaN(year) || year < 1900 || year > 2100) {
                        Swal.showValidationMessage('Please enter a valid graduation year.');
                        return false;
                    }
                    return { acyId: acy, graduationYear: year };
                }
            }).then(function (result) {
                if (result.isConfirmed && result.value) {
                    window.location.href = '@Url.Action("StudentManagement", "Admin")' + '?acyId=' + result.value.acyId + '&gradMode=true&gradYear=' + result.value.graduationYear + '&excludeDropout=true';
                }
            });
        });

        @if (isGradMode)
        {
            @:enterGradMode();
        }

        document.getElementById('saveAllBtn')?.addEventListener('click', function () {
            if (gradMode) {
                saveGraduations();
            } else {
                saveMajors();
            }
        });

        function postUpdates(url, payload, successText) {
            var token = document.querySelector('#antiforgeryForm input[name="__RequestVerificationToken"]').value;
            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            })
            .then(function (res) { return res.json(); })
            .then(function (data) {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Saved!',
                        text: successText
                    }).then(function () { window.location.reload(); });
                } else {
                    Swal.fire({ icon: 'error', title: 'Save Failed', text: data.message || 'Something went wrong.' });
                }
            })
            .catch(function () {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Network error. Please try again.' });
            });
        }

        function saveMajors() {
            var selects = document.querySelectorAll('.bulk-major-select');
            var updates = [];
            var invalid = false;
            selects.forEach(function (sel) {
                if (!sel.value) { invalid = true; return; }
                updates.push({ StudentId: parseInt(sel.getAttribute('data-student-id')), MajorId: parseInt(sel.value) });
            });

            if (invalid) {
                Swal.fire({ icon: 'warning', title: 'Incomplete selection', text: 'Please assign a major to every student before saving.' });
                return;
            }

            Swal.fire({
                title: 'Save all changes?',
                text: 'This will migrate ' + updates.length + ' student(s) to their assigned majors.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0b5cab',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, save all',
                cancelButtonText: 'Cancel'
            }).then(function (result) {
                if (!result.isConfirmed) return;
                postUpdates('@Url.Action("BulkUpdateMajors", "Admin")', updates, 'All students have been migrated successfully.');
            });
        }

        function saveGraduations() {
            var graduationYear = parseInt(gradYearInput, 10);
            if (!gradYearInput || isNaN(graduationYear) || graduationYear < 1900 || graduationYear > 2100) {
                Swal.fire({ icon: 'warning', title: 'Missing graduation year', text: 'Graduation year is missing. Please click Manage Graduation again and enter the enrollment and graduation years.' });
                return;
            }

            var selects = document.querySelectorAll('.bulk-grad-select');
            var updates = [];
            selects.forEach(function (sel) {
                updates.push({ StudentId: parseInt(sel.getAttribute('data-student-id')), GraduationStatus: sel.value });
            });

            var graduatingCount = updates.filter(function (u) { return u.GraduationStatus === 'Graduated'; }).length;

            Swal.fire({
                title: 'Save graduation statuses?',
                text: graduatingCount > 0
                    ? updatingText(graduatingCount, updates.length)
                    : 'This will update the graduation status of ' + updates.length + ' student(s).',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0b5cab',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, save all',
                cancelButtonText: 'Cancel'
            }).then(function (result) {
                if (!result.isConfirmed) return;
                postUpdates('@Url.Action("BulkUpdateGraduations", "Admin")', { updates: updates, graduationYear: graduationYear },
                    'Graduation statuses updated. Graduation records were created for newly graduated students.');
            });
        }

        function updatingText(graduatingCount, total) {
            return 'This will mark ' + graduatingCount + ' student(s) as graduated with graduation year ' + gradYearInput + ' (a graduation record will be created automatically) and update ' + total + ' record(s) in total.';
        }
    </script>
}
