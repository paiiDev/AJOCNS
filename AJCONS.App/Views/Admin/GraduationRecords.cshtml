@model AJOCNS.Shared.DTOs.GraduationRecords.PagedGraduationRecordDto
@{
    ViewData["Title"] = "Graduation Records | AJCONS";
    var selectedGraduationYear = ViewBag.SelectedGraduationYear as short?;
    var selectedDegreeCode = ViewBag.SelectedDegreeCode as string;
}
<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="text-uppercase fw-bold small text-academic mb-1" style="letter-spacing:.08em">
                        Academic administration
                    </div>
                    <h1 class="h2 fw-bold mb-1">Graduation records</h1>
                    <p class="text-muted mb-0">@Model.TotalCount graduation record(s).</p>
                </div>
                <a asp-action="StudentManagement" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-2"></i>Back to students
                </a>
            </div>
        </div>
    </section>

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">
            <form method="get" id="filterForm" class="mb-3 d-flex flex-wrap gap-2 align-items-center">
                <label class="fw-semibold small text-muted mb-0"><i class="fa-solid fa-filter me-1"></i>Filter by degree:</label>
                <select name="degreeCode" class="form-select form-select-sm" style="max-width:280px" onchange="this.form.submit()">
                    <option value="">All degrees</option>
                    @if (ViewBag.Degrees != null && ViewBag.Degrees.IsSuccess)
                    {
                        foreach (var degree in ViewBag.Degrees.Data)
                        {
                            <option value="@degree.DegreeCode" selected="@(selectedDegreeCode == degree.DegreeCode)">@degree.DegreeName (@degree.DegreeCode)</option>
                        }
                    }
                </select>
                <label class="fw-semibold small text-muted mb-0 ms-2"><i class="fa-solid fa-calendar-days me-1"></i>Graduation year:</label>
                <select name="graduationYear" class="form-select form-select-sm" style="max-width:220px" onchange="this.form.submit()">
                    <option value="">All graduation years</option>
                    @if (ViewBag.GraduationYears != null && ViewBag.GraduationYears.IsSuccess)
                    {
                        foreach (var year in ViewBag.GraduationYears.Data)
                        {
                            <option value="@year" selected="@(selectedGraduationYear == year)">@year</option>
                        }
                    }
                </select>
                @if (!string.IsNullOrEmpty(selectedDegreeCode) || selectedGraduationYear != null)
                {
                    <a asp-action="GraduationRecords" class="btn btn-sm btn-outline-secondary">Clear</a>
                }
            </form>

            <div class="card adminlte-card">
                <div class="card-header py-3 d-flex flex-wrap gap-3 justify-content-between align-items-center">
                    <h3 class="card-title fw-bold mb-0">Graduation record directory</h3>
                    <div class="input-group input-group-sm ms-auto" style="max-width:260px">
                        <span class="input-group-text bg-white">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span><input id="recordSearch" class="form-control" type="search"
                                      placeholder="Search records" aria-label="Search records" />
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="recordsTable">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">GRN</th>
                                <th>Official Name</th>
                                <th>Degree</th>
                                <th>Graduation Year</th>
                                <th>Student SRN</th>
                                <th>Accreditation Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Records.Any())
                            {
                                foreach (var record in Model.Records)
                                {
                                    <tr>
                                        <td class="ps-4 text-muted fw-semibold">@record.Grn</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="avatar rounded-circle text-white p-1 fw-bold"
                                                      style="background:#0b5cab">GR</span>
                                                <strong class="d-block">@record.OfficialName</strong>
                                            </div>
                                        </td>
                                        <td>@record.DegreeName</td>
                                        <td>@record.GraduationYear</td>
                                        <td>@(record.Srn ?? "-")</td>
                                        <td>
                                            @if (record.AccStatus == "Active")
                                            {
                                                <span class="badge text-bg-success">@record.AccStatus</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-danger">@record.AccStatus</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4 action-cell">
                                            <a asp-action="EditGraduationRecord" asp-route-id="@record.Id" class="btn btn-sm btn-outline-primary"
                                               aria-label="Edit @record.OfficialName"><i class="fa-solid fa-pen"></i></a>
                                            <form asp-action="DeleteGraduationRecord" asp-route-id="@record.Id" method="post" class="d-inline delete-form">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="btn btn-sm btn-outline-danger ms-1 delete-btn"
                                                        aria-label="Delete @record.OfficialName" data-name="@record.OfficialName"><i class="fa-solid fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="fa-regular fa-folder-open fs-2 d-block mb-2"></i>No graduation records
                                        found. Graduate a student to create one.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-white py-3">
                        <nav aria-label="Graduation record pagination">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                    <a class="page-link" asp-action="GraduationRecords" asp-route-page="@(Model.CurrentPage - 1)" asp-route-degreeCode="@selectedDegreeCode" asp-route-graduationYear="@selectedGraduationYear">Prev</a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="GraduationRecords" asp-route-page="@i" asp-route-degreeCode="@selectedDegreeCode" asp-route-graduationYear="@selectedGraduationYear">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                    <a class="page-link" asp-action="GraduationRecords" asp-route-page="@(Model.CurrentPage + 1)" asp-route-degreeCode="@selectedDegreeCode" asp-route-graduationYear="@selectedGraduationYear">Next</a>
                                </li>
                            </ul>
                        </nav>
                        <div class="text-center text-muted small mt-2">
                            Page @Model.CurrentPage of @Model.TotalPages — showing @Model.Records.Count of @Model.TotalCount records
                        </div>
                    </div>
                }

                <div class="card-footer bg-white text-muted small py-3">
                    Graduation records are managed through the academic administration system.
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.getElementById('recordSearch')?.addEventListener('input', function () {
            var term = this.value.toLowerCase();
            document.querySelectorAll('#recordsTable tbody tr').forEach(function (row) {
                row.style.display = row.innerText.toLowerCase().includes(term) ? '' : 'none';
            });
        });

        document.querySelectorAll('.delete-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var name = this.getAttribute('data-name');
                var form = this.closest('form');
                Swal.fire({
                    title: 'Delete graduation record?',
                    text: 'Are you sure you want to delete the record for "' + name + '"? This action cannot be undone.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}
