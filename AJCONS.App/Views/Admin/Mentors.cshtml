@model AJOCNS.Shared.DTOs.Mentor.PagedMentorDto
@{
    ViewData["Title"] = "Mentors | AJCONS";
    var searchParam = Context.Request.Query["search"].ToString();
}
<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="page-header-label">Alumni Administration</div>
                    <h1 class="page-header-title">Mentors</h1>
                    <p class="page-header-sub">Manage alumni mentor accounts and their access to the platform.</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Index" asp-controller="Admin" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-gauge-high me-2"></i>Dashboard
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">
            <div class="card adminlte-card">
                <div class="card-header d-flex align-items-center gap-3 py-3">
                    <h3 class="card-title fw-bold mb-0"><i class="fa-solid fa-user-graduate me-2"></i>All mentors</h3>
                    <div class="ms-auto d-flex align-items-center gap-2 flex-shrink-0">
                        <form method="get" class="input-group input-group-sm mentor-search" style="max-width:200px;">
                            <span class="input-group-text bg-white"><i class="fa-solid fa-search text-muted"></i></span>
                            <input type="search" name="search" value="@searchParam" class="form-control" placeholder="Search mentors..." />
                            <button type="submit" class="d-none"></button>
                        </form>
                        <span class="status-pill status-pill-info flex-shrink-0">
                            <i class="fa-solid fa-users"></i>@Model.TotalCount total
                        </span>
                    </div>
                </div>
                <div class="table-responsive">
                    @if (Model.TotalCount == 0)
                    {
                        <div class="table-empty">
                            <div class="empty-icon" style="background:var(--info-soft);color:var(--info);">
                                <i class="fa-solid fa-user-graduate"></i>
                            </div>
                            <h4>No mentors yet</h4>
                            <p>No alumni mentors have registered yet.</p>
                        </div>
                    }
                    else if (Model.Mentors.Count == 0)
                    {
                        <div class="table-empty">
                            <div class="empty-icon" style="background:var(--info-soft);color:var(--info);">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </div>
                            <h4>No mentors match your search</h4>
                            <p>Try a different name, email, expertise, or GRN.</p>
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover mb-0 align-middle mentor-table" style="min-width:900px;">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Mentor</th>
                                    <th>Expertise</th>
                                    <th>Alumni</th>
                                    <th>Current Positions</th>
                                    <th>Account</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mentor in Model.Mentors)
                                {
                                    var isActive = string.Equals(mentor.Status, "Active", StringComparison.OrdinalIgnoreCase);
                                    var isPending = string.Equals(mentor.Status, "Pending", StringComparison.OrdinalIgnoreCase);
                                    var nameParts = (mentor.Name ?? "Mentor").Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                    var initials = string.Concat(nameParts.Take(2).Select(w => char.ToUpperInvariant(w[0])));
                                    if (string.IsNullOrWhiteSpace(initials)) { initials = "M"; }

                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="table-avatar table-avatar-teal">@initials</div>
                                                <div>
                                                    <div class="table-name">@mentor.Name</div>
                                                    <div class="table-email">@mentor.Email</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (string.IsNullOrWhiteSpace(mentor.Expertise))
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                            else
                                            {
                                                @mentor.Expertise
                                            }
                                        </td>
                                        <td class="small">
                                            <div>Class of @mentor.AlumniGy</div>
                                            <div class="text-muted">@mentor.AlumniGrn</div>
                                        </td>
                                        <td>
                                            @if (mentor.CurrentPositions.Any())
                                            {
                                                <div class="d-flex flex-column small">
                                                    @foreach (var pos in mentor.CurrentPositions.Take(2))
                                                    {
                                                        <span><i class="fa-solid fa-briefcase me-1 text-primary"></i>@pos.PositionName &middot; @pos.CompanyName</span>
                                                    }
                                                    @if (mentor.CurrentPositions.Count > 2)
                                                    {
                                                        <span class="text-muted">+@(mentor.CurrentPositions.Count - 2) more</span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (isActive)
                                            {
                                                <span class="status-pill status-pill-success"><i class="fa-solid fa-circle"></i>Active</span>
                                            }
                                            else if (isPending)
                                            {
                                                <span class="status-pill status-pill-warning"><i class="fa-solid fa-clock"></i>Pending</span>
                                            }
                                            else
                                            {
                                                <span class="status-pill status-pill-muted"><i class="fa-solid fa-circle"></i>Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="table-actions">
                                                <a asp-action="MentorDetails" asp-controller="Admin" asp-route-userId="@mentor.UserId" class="btn btn-sm btn-outline-primary">
                                                    <i class="fa-solid fa-eye me-1"></i>Details
                                                </a>
                                                @if (isActive)
                                                {
                                                    <form asp-action="DeactivateMentor" asp-controller="Admin" asp-route-id="@mentor.UserId" method="post" class="d-inline deactivate-form">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="@mentor.Name">
                                                            <i class="fa-solid fa-user-slash me-1"></i>Deactivate
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <form asp-action="ActivateMentor" asp-controller="Admin" asp-route-id="@mentor.UserId" method="post" class="d-inline activate-form">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-success" title="@mentor.Name">
                                                            <i class="fa-solid fa-user-check me-1"></i>Activate
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-white py-3">
                        <nav aria-label="Mentor pagination">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                    <a class="page-link" asp-action="Mentors" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@(!string.IsNullOrEmpty(searchParam) ? searchParam : null)">Prev</a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Mentors" asp-route-page="@i" asp-route-search="@(!string.IsNullOrEmpty(searchParam) ? searchParam : null)">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                    <a class="page-link" asp-action="Mentors" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@(!string.IsNullOrEmpty(searchParam) ? searchParam : null)">Next</a>
                                </li>
                            </ul>
                        </nav>
                        <div class="text-center text-muted small mt-2">
                            Page @Model.CurrentPage of @Model.TotalPages — showing @Model.Mentors.Count of @Model.TotalCount mentors
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.deactivate-form').forEach(form => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    const name = form.querySelector('button[type="submit"]').getAttribute('title') || 'this mentor';
                    const result = await Swal.fire({
                        title: 'Deactivate mentor?',
                        text: `${name} will be unable to sign in until reactivated.`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, deactivate',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#dc3545'
                    });
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });

            document.querySelectorAll('.activate-form').forEach(form => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    const name = form.querySelector('button[type="submit"]').getAttribute('title') || 'this mentor';
                    const result = await Swal.fire({
                        title: 'Activate mentor?',
                        text: `${name} will be able to sign in again.`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, activate',
                        cancelButtonText: 'Cancel'
                    });
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}