@using AJOCNS.Shared.DTOs.Auth
@{
    ViewData["Title"] = "Admin Dashboard | AJCONS";
    var pendingUsers = ViewBag.PendingUsers as List<PendingUserApprovalDto> ?? new List<PendingUserApprovalDto>();
    var activeStudents = ViewBag.ActiveStudentCount ?? 0;
    var activeMentors = ViewBag.ActiveMentorCount ?? 0;
    var pendingTotal = (ViewBag.PendingApprovalCount ?? 0) + (ViewBag.PendingPostApprovalCount ?? 0);
    var careerEvents = ViewBag.CareerEventCount ?? 0;
}

<!-- Welcome Header -->
<div class="container-fluid px-lg-4">
    <div class="admin-welcome">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <h1>Dashboard</h1>
                <p>Overview of the AJCONS academic community and system activity.</p>
            </div>
            <div class="admin-header-actions">
                <a asp-action="CreateEvent" asp-controller="Event"
                   class="btn btn-academic">
                    <i class="fa-solid fa-calendar-plus me-2"></i>Create Event
                </a>
                <a asp-action="RegisterNewStudent" asp-controller="Admin"
                   class="btn btn-outline-secondary">
                    <i class="fa-solid fa-user-plus me-2"></i>Add Student
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content pb-5">
    <div class="container-fluid px-lg-4">

        <!-- Stat Cards -->
        <div class="row g-3 mb-4 admin-stat-row">

            <!-- Students -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-card-body">
                        <div>
                            <div class="stat-card-num">@activeStudents</div>
                            <div class="stat-card-label">Verified Students</div>
                        </div>
                        <div class="stat-card-icon stat-icon-blue">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>
                    </div>
                    <a asp-action="StudentManagement" asp-controller="Admin"
                       class="stat-card-footer text-decoration-none stat-footer-blue">
                        <i class="fa-solid fa-arrow-right fa-xs"></i> View directory
                    </a>
                </div>
            </div>

            <!-- Mentors -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-card-body">
                        <div>
                            <div class="stat-card-num">@activeMentors</div>
                            <div class="stat-card-label">Active Alumni Mentors</div>
                        </div>
                        <div class="stat-card-icon stat-icon-teal">
                            <i class="fa-solid fa-chalkboard-user"></i>
                        </div>
                    </div>
                    <a asp-controller="Admin" asp-action="Mentors"
                       class="stat-card-footer text-decoration-none stat-footer-teal">
                        <i class="fa-solid fa-arrow-right fa-xs"></i> View mentors
                    </a>
                </div>
            </div>

            <!-- Pending Approvals -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-card-body">
                        <div>
                            <div class="stat-card-num">@pendingTotal</div>
                            <div class="stat-card-label">Pending Approvals</div>
                        </div>
                        <div class="stat-card-icon stat-icon-amber">
                            <i class="fa-solid fa-clipboard-check"></i>
                        </div>
                    </div>
                    <a asp-controller="Admin" asp-action="UserApprovals"
                       class="stat-card-footer text-decoration-none stat-footer-amber">
                        <i class="fa-solid fa-arrow-right fa-xs"></i> Review queue
                    </a>
                </div>
            </div>

            <!-- Events -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-card-body">
                        <div>
                            <div class="stat-card-num">@careerEvents</div>
                            <div class="stat-card-label">Career Events Hosted</div>
                        </div>
                        <div class="stat-card-icon stat-icon-green">
                            <i class="fa-solid fa-calendar-days"></i>
                        </div>
                    </div>
                    <a asp-controller="Event" asp-action="Index"
                       class="stat-card-footer text-decoration-none stat-footer-green">
                        <i class="fa-solid fa-arrow-right fa-xs"></i> View events
                    </a>
                </div>
            </div>

        </div>

        <!-- Main Content -->
        <div class="row g-4">

            <!-- Pending Profile Approvals -->
            <div class="col-lg-8">
                <div class="dash-card">
                    <div class="dash-card-header">
                        <h3>
                            <i class="fa-solid fa-circle-check"></i>
                            Pending profile approvals
                        </h3>
                        <div class="d-flex align-items-center gap-2">
                            <div class="input-group input-group-sm" style="max-width:200px;">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-search text-muted"></i></span>
                                <input type="search" id="dashApprovalSearch" class="form-control" placeholder="Search..." />
                            </div>
                            @if (pendingTotal > 0)
                            {
                                <span class="status-pill status-pill-warning flex-shrink-0">
                                    <i class="fa-solid fa-clock"></i>@pendingTotal pending
                                </span>
                            }
                            <a asp-controller="Admin" asp-action="UserApprovals"
                               class="btn btn-sm btn-outline-primary flex-shrink-0">View all</a>
                        </div>
                    </div>

                    @if (pendingUsers.Count == 0)
                    {
                        <div class="pending-empty">
                            <div class="empty-icon">
                                <i class="fa-solid fa-inbox"></i>
                            </div>
                            <h4>All caught up</h4>
                            <p>No pending user registrations waiting for review.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive pending-table">
                            <table class="table table-hover mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th>Applicant</th>
                                        <th>Role</th>
                                        <th>Submitted</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in pendingUsers)
                                    {
                                        <tr>
                                            <td>
                                                <span class="applicant-name">@user.Name</span>
                                                <span class="applicant-email d-block">@user.Email</span>
                                            </td>
                                            <td>
                                                @if (user.Role == "Mentor")
                                                {
                                                    <span class="role-badge role-badge-mentor">Alumni Mentor</span>
                                                }
                                                else if (user.Role == "ExternalPartner")
                                                {
                                                    <span class="role-badge role-badge-partner">External Partner</span>
                                                }
                                                else
                                                {
                                                    <span class="role-badge role-badge-other">@user.Role</span>
                                                }
                                            </td>
                                            <td class="text-muted" style="font-size:0.82rem;">
                                                @user.CreatedAt.ToString("d MMM yyyy")
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="Admin" asp-action="UserApprovals"
                                                   class="btn btn-sm btn-academic">Review</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="col-lg-4">
                <div class="dash-card">
                    <div class="dash-card-header">
                        <h3>
                            <i class="fa-solid fa-bolt"></i>
                            Quick actions
                        </h3>
                    </div>
                    <div class="quick-actions-grid">

                        <a asp-action="GraduationRecords" asp-controller="Admin"
                           class="quick-action-card">
                            <span class="quick-action-icon stat-icon-blue">
                                <i class="fa-solid fa-file-lines"></i>
                            </span>
                            <span class="qa-label">Graduation Records</span>
                            <span class="qa-sub">Academic records</span>
                        </a>

                        <a asp-action="StudentManagement" asp-controller="Admin"
                           class="quick-action-card">
                            <span class="quick-action-icon stat-icon-teal">
                                <i class="fa-solid fa-book-open"></i>
                            </span>
                            <span class="qa-label">Majors &amp; Degrees</span>
                            <span class="qa-sub">Programme info</span>
                        </a>

                        <a asp-action="ExternalPartners" asp-controller="Admin"
                           class="quick-action-card">
                            <span class="quick-action-icon stat-icon-amber">
                                <i class="fa-solid fa-building"></i>
                            </span>
                            <span class="qa-label">External Partners</span>
                            <span class="qa-sub">Partner accounts</span>
                        </a>

                        <a asp-action="ContentApprovals" asp-controller="Admin"
                           class="quick-action-card">
                            <span class="quick-action-icon stat-icon-green">
                                <i class="fa-solid fa-clipboard-check"></i>
                            </span>
                            <span class="qa-label">Post Approvals</span>
                            <span class="qa-sub">Events &amp; job posts</span>
                            @if (ViewBag.PendingPostApprovalCount > 0)
                            {
                                <span class="quick-action-badge">@ViewBag.PendingPostApprovalCount</span>
                            }
                        </a>

                    </div>
                </div>
            </div>

        </div>

    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var search = document.getElementById('dashApprovalSearch');
            var rows = document.querySelectorAll('.pending-table tbody tr');
            if (!search || !rows.length) return;
            search.addEventListener('input', function () {
                var term = this.value.toLowerCase();
                rows.forEach(function (row) {
                    row.style.display = row.innerText.toLowerCase().includes(term) ? '' : 'none';
                });
            });
        });
    </script>
}
