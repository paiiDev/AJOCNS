@model AJOCNS.Shared.DTOs.Auth.PagedExternalPartnerDto
@{
    ViewData["Title"] = "External Partners | AJCONS";
    var searchParam = Context.Request.Query["search"].ToString();
}
<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="page-header-label">Partner Directory</div>
                    <h1 class="page-header-title">External Partners</h1>
                    <p class="page-header-sub">Review partner accounts and manage their access to the platform.</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Index" asp-controller="Admin" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-gauge-high me-2"></i>Dashboard
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">
            <div class="card adminlte-card border-0">
                <div class="card-header d-flex align-items-center gap-3 py-3">
                    <h3 class="card-title fw-bold mb-0">All partners</h3>
                    <div class="ms-auto d-flex align-items-center gap-2 flex-shrink-0">
                        <form method="get" class="input-group input-group-sm" style="max-width:200px;">
                            <span class="input-group-text bg-white"><i class="fa-solid fa-search text-muted"></i></span>
                            <input type="search" name="search" value="@searchParam" class="form-control" placeholder="Search partners..." />
                            <button type="submit" class="d-none"></button>
                        </form>
                        <span class="status-pill status-pill-info flex-shrink-0">
                            <i class="fa-solid fa-building"></i>@Model.TotalCount total
                        </span>
                        <a asp-action="UserApprovals" class="btn btn-sm btn-outline-primary flex-shrink-0">Review pending</a>
                    </div>
                </div>
                @if (Model.TotalCount == 0)
                {
                    <div class="table-empty">
                        <div class="empty-icon" style="background:var(--brand-teal-soft);color:var(--brand-teal);">
                            <i class="fa-solid fa-building-circle-check"></i>
                        </div>
                        <h4>No partners yet</h4>
                        <p>No external partner accounts have been registered yet.</p>
                    </div>
                }
                else if (Model.Partners.Count == 0)
                {
                    <div class="table-empty">
                        <div class="empty-icon" style="background:var(--brand-teal-soft);color:var(--brand-teal);">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </div>
                        <h4>No partners match your search</h4>
                        <p>Try a different name, company, position, email, or phone.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 partner-table" style="min-width:850px;">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Partner</th>
                                    <th>Company</th>
                                    <th>Position</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Access</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var partner in Model.Partners)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="table-avatar table-avatar-navy">
                                                    @partner.Name?.Substring(0, Math.Min(1, partner.Name.Length)).ToUpper()
                                                </span>
                                                <div>
                                                    <span class="table-name">@partner.Name</span>
                                                    <span class="table-email">@partner.Email</span>
                                                    @if (!string.IsNullOrWhiteSpace(partner.Phone))
                                                    {
                                                        <span class="table-email">@partner.Phone</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>@partner.CompanyName</td>
                                        <td>@partner.PositionName</td>
                                        <td>
                                            @if (partner.Status == "Active")
                                            {
                                                <span class="status-pill status-pill-success"><i class="fa-solid fa-circle"></i>Active</span>
                                            }
                                            else if (partner.Status == "Pending")
                                            {
                                                <span class="status-pill status-pill-warning"><i class="fa-solid fa-clock"></i>Pending</span>
                                            }
                                            else
                                            {
                                                <span class="status-pill status-pill-muted"><i class="fa-solid fa-circle"></i>Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="table-actions">
                                                <a asp-action="ExternalPartnerDetails" asp-controller="Admin" asp-route-userId="@partner.UserId" asp-route-returnAction="ExternalPartners" class="btn btn-sm btn-outline-primary">
                                                    <i class="fa-solid fa-eye me-1"></i>Details
                                                </a>
                                                @if (partner.Status == "Active")
                                                {
                                                    <form asp-action="UpdateExternalPartnerStatus" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@partner.UserId" />
                                                        <input type="hidden" name="status" value="Inactive" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                                    </form>
                                                }
                                                else if (partner.Status == "Inactive")
                                                {
                                                    <form asp-action="UpdateExternalPartnerStatus" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@partner.UserId" />
                                                        <input type="hidden" name="status" value="Active" />
                                                        <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <a asp-action="UserApprovals" class="btn btn-sm btn-academic">Review</a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-white py-3">
                        <nav aria-label="Partner pagination">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                    <a class="page-link" asp-action="ExternalPartners" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@(!string.IsNullOrEmpty(searchParam) ? searchParam : null)">Prev</a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="ExternalPartners" asp-route-page="@i" asp-route-search="@(!string.IsNullOrEmpty(searchParam) ? searchParam : null)">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                    <a class="page-link" asp-action="ExternalPartners" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@(!string.IsNullOrEmpty(searchParam) ? searchParam : null)">Next</a>
                                </li>
                            </ul>
                        </nav>
                        <div class="text-center text-muted small mt-2">
                            Page @Model.CurrentPage of @Model.TotalPages — showing @Model.Partners.Count of @Model.TotalCount partners
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
</div>
