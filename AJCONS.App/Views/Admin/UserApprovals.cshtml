@using AJOCNS.Shared.DTOs.Auth
@{
    ViewData["Title"] = "User Approvals | AJCONS";
    var pendingUsers = ViewBag.PendingUsers as List<PendingUserApprovalDto> ?? new List<PendingUserApprovalDto>();
}
<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="page-header-label">Account Administration</div>
                    <h1 class="page-header-title">User Approvals</h1>
                    <p class="page-header-sub">Pending mentor and external partner registrations awaiting review.</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Index" asp-controller="Admin" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-gauge-high me-2"></i>Dashboard
                    </a>
                </div>
            </div>
        </div>
    </section>
    <section class="content pb-5">
        <div class="container-fluid px-lg-4">
            <div class="card adminlte-card">
                <div class="card-header d-flex align-items-center gap-3 py-3">
                    <h3 class="card-title fw-bold mb-0">Pending registrations</h3>
                    <div class="ms-auto d-flex align-items-center gap-2 flex-shrink-0">
                        <div class="input-group input-group-sm" style="max-width:220px;">
                            <span class="input-group-text bg-white"><i class="fa-solid fa-search text-muted"></i></span>
                            <input type="search" id="approvalSearch" class="form-control" placeholder="Search applicants..." aria-label="Search pending applicants" />
                        </div>
                        <span class="status-pill status-pill-warning flex-shrink-0">
                            <i class="fa-solid fa-clock"></i>@pendingUsers.Count waiting
                        </span>
                    </div>
                </div>
                <div class="px-4 pt-3 approval-filters" role="group" aria-label="Filter approvals by role">
                    <a asp-action="UserApprovals" asp-route-role="All"
                       class="filter-pill @(ViewBag.SelectedRole == "All" ? "active" : "")">
                        All
                    </a>
                    <a asp-action="UserApprovals" asp-route-role="Mentor"
                       class="filter-pill @(ViewBag.SelectedRole == "Mentor" ? "active" : "")">
                        Alumni Mentors
                    </a>
                    <a asp-action="UserApprovals" asp-route-role="ExternalPartner"
                       class="filter-pill @(ViewBag.SelectedRole == "ExternalPartner" ? "active" : "")">
                        External Partners
                    </a>
                </div>
                <div class="table-responsive">
                    @if (pendingUsers.Count == 0)
                    {
                        <div class="table-empty">
                            <div class="empty-icon" style="background:var(--brand-blue-soft);color:var(--brand-blue);">
                                <i class="fa-solid fa-inbox"></i>
                            </div>
                            <h4>All caught up</h4>
                            <p>No pending user registrations to review.</p>
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Applicant</th>
                                    <th>Role</th>
                                    <th>Submitted</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in pendingUsers)
                                {
                                    <tr data-role="@user.Role">
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="table-avatar @(user.Role == "Mentor" ? "table-avatar-teal" : "table-avatar-navy")">
                                                    @user.Name?.Substring(0, Math.Min(1, user.Name.Length)).ToUpper()
                                                </span>
                                                <div>
                                                    <span class="table-name">@user.Name</span>
                                                    <span class="table-email">@user.Email</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (user.Role == "Mentor")
                                            {
                                                <span class="status-pill status-pill-info">
                                                    <i class="fa-solid fa-circle"></i>Alumni Mentor
                                                </span>
                                            }
                                            else if (user.Role == "ExternalPartner")
                                            {
                                                <span class="status-pill status-pill-purple">
                                                    <i class="fa-solid fa-circle"></i>External Partner
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-pill status-pill-muted">
                                                    <i class="fa-solid fa-circle"></i>@user.Role
                                                </span>
                                            }
                                        </td>
                                        <td class="table-detail">@user.CreatedAt.ToString("d MMM yyyy, hh:mm tt")</td>
                                        <td>
                                            <div class="table-actions">
                                                @if (user.Role == "Mentor")
                                                {
                                                    <form asp-action="VerifyUser" asp-controller="Admin" method="post" class="d-inline verify-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@user.UserId" />
                                                        <button type="submit" class="btn btn-sm btn-success">
                                                            <i class="fa-solid fa-user-check me-1"></i>Verify
                                                        </button>
                                                    </form>
                                                    <form asp-action="RejectUser" asp-controller="Admin" method="post" class="d-inline reject-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@user.UserId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="fa-solid fa-xmark me-1"></i>Reject
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <a asp-action="ExternalPartnerDetails" asp-controller="Admin" asp-route-userId="@user.UserId" class="btn btn-sm btn-outline-primary">
                                                        <i class="fa-solid fa-eye me-1"></i>Details
                                                    </a>
                                                    <form asp-action="ApproveUser" asp-controller="Admin" method="post" class="d-inline approve-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@user.UserId" />
                                                        <button type="submit" class="btn btn-sm btn-success">
                                                            <i class="fa-solid fa-check me-1"></i>Approve
                                                        </button>
                                                    </form>
                                                    <form asp-action="RejectUser" asp-controller="Admin" method="post" class="d-inline reject-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@user.UserId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="fa-solid fa-xmark me-1"></i>Reject
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div id="approvalNoResults" class="text-center py-5 text-muted d-none">
                            <i class="fa-solid fa-filter fs-2 mb-3 d-block"></i>No pending registrations match your filters.
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const search = document.getElementById('approvalSearch');
            const rows = [...document.querySelectorAll('.approval-filters ~ .table-responsive table tbody tr')];
            const empty = document.getElementById('approvalNoResults');
            const filterRows = () => {
                const term = search?.value.trim().toLowerCase() || '';
                let visible = 0;
                rows.forEach(row => {
                    const matches = row.innerText.toLowerCase().includes(term);
                    row.classList.toggle('d-none', !matches);
                    if (matches) visible++;
                });
                empty?.classList.toggle('d-none', visible !== 0);
            };
            search?.addEventListener('input', filterRows);

            document.querySelectorAll('.verify-form').forEach(form => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    const button = form.querySelector('button[type="submit"]');
                    const originalHtml = button.innerHTML;
                    button.disabled = true;
                    button.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin me-2"></i>Verifying...';

                    const result = await Swal.fire({
                        title: 'Verify this alumni mentor?',
                        text: 'We will check the GRN against graduation records, approve the account, and email the confirmation.',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, verify',
                        cancelButtonText: 'Cancel'
                    });
                    if (!result.isConfirmed) {
                        button.disabled = false;
                        button.innerHTML = originalHtml;
                        return;
                    }

                    const url = form.getAttribute('action');
                    const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
                    const userId = form.querySelector('input[name="userId"]').value;

                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: 'userId=' + encodeURIComponent(userId) + '&__RequestVerificationToken=' + encodeURIComponent(token)
                    });
                    const data = await response.json();

                    button.disabled = false;
                    button.innerHTML = originalHtml;

                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Verified & Approved!',
                            text: data.message,
                            confirmButtonText: 'OK'
                        }).then(() => window.location.reload());
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Verification Failed',
                            text: data.message,
                            confirmButtonText: 'OK'
                        });
                    }
                });
            });

            document.querySelectorAll('.approve-form').forEach(form => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    const result = await Swal.fire({
                        title: 'Approve this applicant?',
                        text: 'They will be able to log in immediately after approval.',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, approve',
                        cancelButtonText: 'Cancel'
                    });
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });

            document.querySelectorAll('.reject-form').forEach(form => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    const result = await Swal.fire({
                        title: 'Reject this applicant?',
                        text: 'Their account will become inactive.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, reject',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#dc3545'
                    });
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        })
    </script>
}