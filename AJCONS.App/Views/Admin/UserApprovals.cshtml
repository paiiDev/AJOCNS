@using AJOCNS.Shared.DTOs.Auth
@{
    ViewData["Title"] = "User Approvals | AJCONS";
    var pendingUsers = ViewBag.PendingUsers as List<PendingUserApprovalDto> ?? new List<PendingUserApprovalDto>();
}
<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="text-uppercase fw-bold small text-academic mb-1" style="letter-spacing:.08em">
                        Account administration
                    </div>
                    <h1 class="h2 fw-bold mb-1">User approvals</h1>
                    <p class="text-muted mb-0">Pending mentor and external partner registrations awaiting review.</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Index" asp-controller="Admin" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-gauge-high me-2"></i>Dashboard
                    </a>
                </div>
            </div>
        </div>
    </section>
    <section class="content pb-5">
        <div class="container-fluid px-lg-4">
            <div class="card adminlte-card">
                <div class="card-header d-flex justify-content-between align-items-center py-3">
                    <h3 class="card-title fw-bold mb-0">Pending registrations</h3>
                    <span class="badge rounded-pill text-bg-warning">@pendingUsers.Count waiting</span>
                </div>
                <div class="table-responsive">
                    @if (pendingUsers.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa-solid fa-inbox fs-2 mb-3 d-block"></i>
                            No pending user registrations to review.
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Applicant</th>
                                    <th>Role</th>
                                    <th>Submitted</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in pendingUsers)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <strong>@user.Name</strong>
                                            <small class="d-block text-muted">@user.Email</small>
                                        </td>
                                        <td>
                                            @if (user.Role == "Mentor")
                                            {
                                                <span class="badge text-bg-info">Alumni Mentor</span>
                                            }
                                            else if (user.Role == "ExternalPartner")
                                            {
                                                <span class="badge text-bg-primary">External Partner</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-secondary">@user.Role</span>
                                            }
                                        </td>
                                        <td>@user.CreatedAt.ToString("d MMM yyyy, hh:mm tt")</td>
                                        <td class="text-end pe-4">
                                            @if (user.Role == "Mentor")
                                            {
                                                <div class="d-inline-flex gap-2">
                                                    <form asp-action="VerifyUser" asp-controller="Admin" method="post" class="d-inline verify-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@user.UserId" />
                                                        <button type="submit" class="btn btn-sm btn-success">
                                                            <i class="fa-solid fa-user-check me-1"></i>Verify
                                                        </button>
                                                    </form>
                                                    <form asp-action="RejectUser" asp-controller="Admin" method="post" class="d-inline reject-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@user.UserId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="fa-solid fa-xmark me-1"></i>Reject
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-inline-flex gap-2">
                                                    <form asp-action="ApproveUser" asp-controller="Admin" method="post" class="d-inline approve-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@user.UserId" />
                                                        <button type="submit" class="btn btn-sm btn-success">
                                                            <i class="fa-solid fa-check me-1"></i>Approve
                                                        </button>
                                                    </form>
                                                    <form asp-action="RejectUser" asp-controller="Admin" method="post" class="d-inline reject-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@user.UserId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="fa-solid fa-xmark me-1"></i>Reject
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.verify-form').forEach(form => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    const button = form.querySelector('button[type="submit"]');
                    const originalHtml = button.innerHTML;
                    button.disabled = true;
                    button.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin me-2"></i>Verifying...';

                    const result = await Swal.fire({
                        title: 'Verify this alumni mentor?',
                        text: 'We will check the GRN against graduation records, approve the account, and email the confirmation.',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, verify',
                        cancelButtonText: 'Cancel'
                    });
                    if (!result.isConfirmed) {
                        button.disabled = false;
                        button.innerHTML = originalHtml;
                        return;
                    }

                    const url = form.getAttribute('action');
                    const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
                    const userId = form.querySelector('input[name="userId"]').value;

                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: 'userId=' + encodeURIComponent(userId) + '&__RequestVerificationToken=' + encodeURIComponent(token)
                    });
                    const data = await response.json();

                    button.disabled = false;
                    button.innerHTML = originalHtml;

                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Verified & Approved!',
                            text: data.message,
                            confirmButtonText: 'OK'
                        }).then(() => window.location.reload());
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Verification Failed',
                            text: data.message,
                            confirmButtonText: 'OK'
                        });
                    }
                });
            });

            document.querySelectorAll('.approve-form').forEach(form => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    const result = await Swal.fire({
                        title: 'Approve this applicant?',
                        text: 'They will be able to log in immediately after approval.',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, approve',
                        cancelButtonText: 'Cancel'
                    });
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });

            document.querySelectorAll('.reject-form').forEach(form => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    const result = await Swal.fire({
                        title: 'Reject this applicant?',
                        text: 'Their account will become inactive.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, reject',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#dc3545'
                    });
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        })
    </script>
}