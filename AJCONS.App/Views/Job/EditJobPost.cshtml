@model AJOCNS.Shared.DTOs.Jobs.UpdateJobPostDto
@{
    ViewData["Title"] = "Edit Job Post";
    Layout = "_Layout";
}

<section class="content-header py-4 py-lg-5">
    <div class="container-fluid px-lg-4">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
            <div>
                <div class="text-uppercase fw-bold small text-academic mb-1" style="letter-spacing:.08em">
                    Job management
                </div>
                <h1 class="h2 fw-bold mb-1">Edit job post</h1>
                <p class="text-muted mb-0">Update the details of this job opportunity.</p>
            </div>
            <a asp-action="Index" asp-controller="Job" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-2"></i>Back to job posts
            </a>
        </div>
    </div>
</section>

<section class="content pb-5">
    <div class="container-fluid px-lg-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card adminlte-card">
                    <div class="card-header py-3">
                        <h3 class="card-title fw-bold mb-0">
                            <i class="fa-solid fa-pen-to-square me-2 text-academic"></i>Job information
                        </h3>
                    </div>

                    <form asp-action="EditJobPost" asp-controller="Job" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="card-body">
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger rounded-3" role="alert">
                                    <div asp-validation-summary="All" class="mb-0 list-unstyled small"></div>
                                </div>
                            }

                            <div class="mb-3">
                                <label asp-for="Title" class="form-label fw-semibold">Job Title <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="fa-solid fa-heading text-muted"></i></span>
                                    <input asp-for="Title" class="form-control" placeholder="e.g. Software Engineer" />
                                </div>
                                <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="CompanyName" class="form-label fw-semibold">Company Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="fa-solid fa-building text-muted"></i></span>
                                    <input asp-for="CompanyName" class="form-control" placeholder="e.g. PUPL Tech Ltd." />
                                </div>
                                <span asp-validation-for="CompanyName" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="JobType" class="form-label fw-semibold">Job Type</label>
                                        <select asp-for="JobType" class="form-select">
                                            <option value="">-- Select type --</option>
                                            @if (ViewBag.JobTypes != null)
                                            {
                                                foreach (var jobType in ViewBag.JobTypes)
                                                {
                                                    <option value="@jobType">@jobType</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="JobType" class="text-danger small mt-1 d-block"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Location" class="form-label fw-semibold">Location</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="fa-solid fa-location-dot text-muted"></i></span>
                                            <input asp-for="Location" class="form-control" placeholder="City / Remote" />
                                        </div>
                                        <span asp-validation-for="Location" class="text-danger small mt-1 d-block"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="SalaryRange" class="form-label fw-semibold">Salary Range</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="fa-solid fa-money-bill-wave text-muted"></i></span>
                                            <input asp-for="SalaryRange" class="form-control" placeholder="e.g. 2,500,000 - 3,500,000 MMK" />
                                        </div>
                                        <span asp-validation-for="SalaryRange" class="text-danger small mt-1 d-block"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ClosingDate" class="form-label fw-semibold">Closing Date <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="fa-solid fa-calendar-check text-muted"></i></span>
                                            <input asp-for="ClosingDate" type="datetime-local" class="form-control" />
                                        </div>
                                        <span asp-validation-for="ClosingDate" class="text-danger small mt-1 d-block"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                                <textarea asp-for="Description" rows="5" class="form-control" placeholder="Describe the role and responsibilities..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Requirements" class="form-label fw-semibold">Requirements</label>
                                <textarea asp-for="Requirements" rows="5" class="form-control" placeholder="List the qualifications and skills required..."></textarea>
                                <span asp-validation-for="Requirements" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="card-footer bg-white d-flex justify-content-end gap-2 py-3">
                            <a asp-action="Index" asp-controller="Job" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-academic">
                                <i class="fa-solid fa-check me-2"></i>Save changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>