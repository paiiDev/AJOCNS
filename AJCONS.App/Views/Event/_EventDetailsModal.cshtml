@model AJOCNS.Shared.DTOs.Events.EventDto

<div class="modal-header border-bottom-0 pb-0">
    <h4 class="modal-title fw-bold text-dark">@Model.EventTitle</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body pt-3">

    <div class="mb-4">
        <span class="badge text-bg-light border border-secondary-subtle px-3 py-2 rounded-pill shadow-sm text-secondary me-2">
            <i class="fa-solid fa-tag me-1"></i> @Model.EventTypeName
        </span>
        <span class="badge @(Model.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase) ? "text-bg-warning" : (Model.Status.Equals("Rejected", StringComparison.OrdinalIgnoreCase) ? "text-bg-danger" : (Model.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase) ? "text-bg-primary" : "text-bg-success"))) px-3 py-2 rounded-pill shadow-sm">
            <i class="fa-solid @(Model.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase) ? "fa-clock" : (Model.Status.Equals("Rejected", StringComparison.OrdinalIgnoreCase) ? "fa-xmark" : (Model.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase) ? "fa-check-circle" : "fa-check-circle"))) me-1"></i> @Model.Status
        </span>
    </div>

    @if (!string.IsNullOrEmpty(Model.PosterImagePath))
    {
        <div class="text-center mb-4 position-relative">
            <img src="@Model.PosterImagePath"
                 class="img-fluid rounded-4 shadow-sm w-100"
                 style="max-height: 350px; object-fit: cover;"
                 alt="Event Poster for @Model.EventTitle"
                 onerror="this.style.display='none'" /> 
        </div>
    }

    <div class="row g-3 mb-4 bg-light p-3 rounded-4 border border-light-subtle">
        <div class="col-sm-6">
            <div class="d-flex align-items-start">
                <div class="bg-white p-2 rounded-3 shadow-sm me-3 text-primary">
                    <i class="fa-regular fa-calendar-days fs-5"></i>
                </div>
                <div>
                    <strong class="d-block small text-muted text-uppercase" style="letter-spacing: 0.5px;">Date & Time</strong>
                    <span class="fw-semibold text-dark">@Model.EventDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="d-flex align-items-start">
                <div class="bg-white p-2 rounded-3 shadow-sm me-3 text-danger">
                    <i class="fa-solid fa-location-dot fs-5"></i>
                </div>
                <div>
                    <strong class="d-block small text-muted text-uppercase" style="letter-spacing: 0.5px;">Location / Mode</strong>
                    <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.Location) ? (Model.EventMode ?? "Online") : Model.Location)</span>
                </div>
            </div>
        </div>

        <div class="col-sm-6">
            <div class="d-flex align-items-start">
                <div class="bg-white p-2 rounded-3 shadow-sm me-3 text-success">
                    <i class="fa-solid fa-user-tie fs-5"></i>
                </div>
                <div>
                    <strong class="d-block small text-muted text-uppercase" style="letter-spacing: 0.5px;">Organizer</strong>
                    <span class="fw-semibold text-dark">@(Model.CreatedByName ?? "Unknown")</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="d-flex align-items-start">
                <div class="bg-white p-2 rounded-3 shadow-sm me-3 text-info">
                    <i class="fa-solid fa-users fs-5"></i>
                </div>
                <div>
                    <strong class="d-block small text-muted text-uppercase" style="letter-spacing: 0.5px;">Capacity</strong>
                    <span class="fw-semibold text-dark">@(Model.MaxCapacity?.ToString() ?? "Unlimited")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 🌟 Description Section -->
    <div>
        <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-circle-info text-muted me-2"></i>About This Event</h6>
        <p class="text-secondary lh-lg" style="white-space: pre-line; font-size: 0.95rem;">
            @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
        </p>
    </div>
</div>

<div class="modal-footer bg-light border-top-0 rounded-bottom-4">
    <button type="button" class="btn btn-outline-secondary px-4 fw-semibold" data-bs-dismiss="modal">Close</button>

    @if (Model.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
    {
        <div class="d-flex gap-2">
            <form asp-action="RejectEvent" asp-controller="Event" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger px-4 fw-semibold shadow-sm">
                    <i class="fa-solid fa-xmark me-2"></i>Reject
                </button>
            </form>
            <form asp-action="ApproveEvent" asp-controller="Event" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-success px-4 fw-semibold shadow-sm">
                    <i class="fa-solid fa-check me-2"></i>Approve
                </button>
            </form>
        </div>
    }
</div>