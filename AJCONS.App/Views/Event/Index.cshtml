@using System.Security.Claims
@model AJOCNS.Shared.DTOs.Events.PagedEventDto
@{
    ViewData["Title"] = "Events | AJCONS";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
    var isMentor = User.IsInRole("Mentor");
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var selectedEventType = ViewBag.SelectedEventType as string;
    var SelectedEventStatus = ViewBag.SelectedEventStatus as string;
}
<div class="content-wrapper bg-transparent">
    <section class="content-header py-4 py-lg-5">
        <div class="container-fluid px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <div class="text-uppercase fw-bold small text-academic mb-1" style="letter-spacing:.08em">
                        Event management
                    </div>
                    <h1 class="h2 fw-bold mb-1">Events</h1>
                    <p class="text-muted mb-0">@Model.TotalCount event(s) in total.</p>
                </div>
                <a asp-action="CreateEvent" asp-controller="Event" class="btn btn-academic">
                    <i class="fa-solid fa-calendar-plus me-2"></i>Create event
                </a>
            </div>
        </div>
    </section>

    <section class="content pb-5">
        <div class="container-fluid px-lg-4">

            <form method="get" id="filterForm" class="mb-3 d-flex flex-wrap gap-2 align-items-center">
                <label class="fw-semibold small text-muted mb-0"><i class="fa-solid fa-filter me-1"></i>Filter by Event Type:</label>
                <select name="eventType" class="form-select form-select-sm" style="max-width:280px" onchange="this.form.submit()">
                    <option value="">All event types</option>
                    @if (ViewBag.EventTypes != null && ViewBag.EventTypes.IsSuccess)
                    {
                        foreach (var eventType in ViewBag.EventTypes.Data)
                        {
                            <option value="@eventType.Name" selected="@(selectedEventType == eventType.Name.ToString())">@eventType.Name</option>
                        }
                    }
                </select>
                <label class="fw-semibold small text-muted mb-0 ms-2"><i class="fa-solid fa-calendar-days me-1"></i>Filter by Event Status:</label>
                <select name="eventStatus" class="form-select form-select-sm" style="max-width:220px" onchange="this.form.submit()">
                    <option value=""> Event Statuses </option>
                    @if (ViewBag.EventStatuses != null && ViewBag.EventStatuses.IsSuccess)
                    {
                        foreach (var eventStatus in ViewBag.EventStatuses.Data)
                        {
                            <option value="@eventStatus.Status" selected="@(SelectedEventStatus == eventStatus.Status.ToString())">@eventStatus.Status</option>
                        }
                    }
                </select>
                @if (!string.IsNullOrEmpty(selectedEventType) || SelectedEventStatus != null)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
                }
            </form>
            <div class="card adminlte-card">
                <div class="card-header py-3">
                    <h3 class="card-title fw-bold mb-0">Event directory</h3>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Title</th>
                                <th>Type</th>
                                <th>Date &amp; Time</th>
                                <th>Mode</th>
                                <th>Location</th>
                                <th>Capacity</th>
                                <th>Status</th>
                                @if (isAdmin || isMentor)
                                {
                                    <th class="text-end pe-4">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Events.Any())
                            {
                                foreach (var ev in Model.Events)
                                {
                                    var isPending = string.Equals(ev.Status, "Pending", StringComparison.OrdinalIgnoreCase);
                                    <tr>
                                        <td class="ps-4"><strong>@ev.EventTitle</strong></td>
                                        <td>@ev.EventTypeName</td>
                                        <td>@ev.EventDate.ToString("dd MMM yyyy, HH:mm")</td>
                                        <td>@(ev.EventMode ?? "-")</td>
                                        <td>@(ev.Location ?? "-")</td>
                                        <td>@(ev.MaxCapacity?.ToString() ?? "Unlimited")</td>
                                        <td>
                                            
                                           
                                                @switch (ev.Status.ToLower())
                                                {
                                                case "completed":
                                                    <span class="badge text-bg-primary">Completed</span>
                                                    break;
                                                    case "upcoming":
                                                        <span class="badge text-bg-success">Upcoming</span>
                                                        break;
                                                    case "pending":
                                                        <span class="badge text-bg-warning">Pending approval</span>
                                                        break;
                                                    case "rejected":
                                                        <span class="badge text-bg-danger">Rejected</span>
                                                        break;
                                                    default:
                                                        <span class="badge" style="background:#eaf4ff;color:#073d78">@ev.Status</span>
                                                        break;
                                                }
                                            
                                           
                                        </td>
                                        @if (isAdmin || isMentor)
                                        {
                                            <td class="text-end pe-4">
                                                <div class="d-flex justify-content-end gap-1">
                                                    <button data-id="@ev.Id" type="button" class="btn btn-sm btn-outline-success btn-view-details"
                                                            aria-label="Event Details @ev.EventTitle">
                                                        <i class="fa-solid fa-eye"></i>
                                                    </button>

                                                    @if (isAdmin || currentUserId == ev.CreatedByUserId.ToString())
                                                        {
                                                            if (!string.Equals(ev.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <a asp-action="EditEvent" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-primary"
                                                                   title="Edit @ev.EventTitle" aria-label="Edit @ev.EventTitle">
                                                                    <i class="fa-solid fa-pen"></i>
                                                                </a>
                                                                <form asp-action="DeleteEvent" asp-controller="Event" asp-route-id="@ev.Id" method="post"
                                                                      class="d-inline confirm-delete" data-event-title="@ev.EventTitle">
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete @ev.EventTitle"
                                                                            aria-label="Delete @ev.EventTitle">
                                                                        <i class="fa-solid fa-trash-can"></i>
                                                                    </button>
                                                                </form>
                                                            }
                                                        }
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-muted">
                                        <i class="fa-regular fa-folder-open fs-2 d-block mb-2"></i>No events found. Create one to begin.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-white py-3">
                        <nav aria-label="Event pagination">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">Prev</a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                                </li>
                            </ul>
                        </nav>
                        <div class="text-center text-muted small mt-2">
                            Page @Model.CurrentPage of @Model.TotalPages — showing @Model.Events.Count of @Model.TotalCount events
                        </div>
                    </div>
                }

                <div class="card-footer bg-white text-muted small py-3">
                    Events created by mentors require admin approval before becoming visible.
                </div>
            </div>
        </div>
    </section>
</div>

<div class="modal fade" id="eventDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="modalContentArea">
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.confirm-delete').forEach(form => {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    const title = this.getAttribute('data-event-title') || 'this event';
                    const formEl = this;

                    Swal.fire({
                        title: 'Delete event?',
                        text: `"${title}" will be permanently deleted. This cannot be undone.`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Yes, delete',
                        cancelButtonText: 'Cancel'
                    }).then(result => {
                        if (result.isConfirmed) {
                            formEl.submit();
                        }
                    });
                });
            });

            document.querySelectorAll('.btn-view-details').forEach(button => {
                button.addEventListener('click', async function() {
                    const eventId = this.getAttribute('data-id');
                    const modalElement = document.getElementById('eventDetailsModal');
                    const modal = new bootstrap.Modal(modalElement);
                    const contentArea = document.getElementById('modalContentArea');

                    contentArea.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
                    modal.show();

                    try {
                const response = await fetch(`@Url.Action("GetEventDetailsModal", "Event")?id=${eventId}`);

                if (!response.ok) throw new Error('Network Error');

                const html = await response.text();
                contentArea.innerHTML = html;

            } catch (error) {
                contentArea.innerHTML = '<div class="p-4 text-danger">There is error when fetching data</div>';
            }

                } )
            })
        })
    </script>
}